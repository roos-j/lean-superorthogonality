import Mathlib

/-!
# Type IV superorthogonality square-function estimate

This is the small statement surface submitted to Palomar. It records only the
unrestricted form of Theorem 1 of:

Philip T. Gressman, Lillian B. Pierce, Joris Roos, and Po-Lam Yung,
*A new type of superorthogonality*, *Proceedings of the American Mathematical
Society* 152 (2024), no. 2, 665--675. doi:10.1090/proc/16631.

The theorem says that a countable type-IV
superorthogonal family has an unconditional `L^(2r)` sum whose norm is
controlled by its square function.

The explicit almost-everywhere summability hypothesis and the `Fact` instance
are Lean-specific technical requirements; the former avoids the junk value of
an infinite `tsum`, and the latter supplies an instance required by `Lp`.
No intermediate theorem is part of this submission.
-/

@[expose] public noncomputable section

namespace Superorthogonal

open MeasureTheory Nat Set Complex
open scoped ComplexConjugate

section Definitions

variable {α : Type*} [MeasurableSpace α]
variable (μ : Measure α)
variable {ι : Type*} [Countable ι]

local instance : MeasurableSpace ι := ⊤
local instance : MeasureSpace ι where
  volume := Measure.count

variable {r : ℕ}

/-- The `k`-tuple `j` consists of all distinct indices. -/
def all_distinct (k : ℕ) (j : Fin k → ι) := ∀ i i', i ≠ i' → j i ≠ j i'

/-- The product of the first `r` selected functions and the conjugates of the last `r`. -/
abbrev cprod (f : ι → α → ℂ) {r : ℕ} (j : Fin (2 * r) → ι) :=
  fun x ↦ ∏ i : Fin (2 * r), if i < r then f (j i) x else star (f (j i) x)

/-- Type IV superorthogonality of a family of functions. -/
structure TypeIVSuperorthogonal (f : ι → α → ℂ) (r : ℕ) : Prop where
  measurable : ∀ j, Measurable (f j)
  integrable_cprod : ∀ j : Fin (2 * r) → ι, all_distinct (2 * r) j → Integrable (cprod f j) μ
  superorthogonal : ∀ j : Fin (2 * r) → ι, all_distinct (2 * r) j → ∫ x, cprod f j x ∂μ = 0

/-- Square-function associated with the family of functions `f`. -/
def sqfct (f : ι → α → ℂ) (x : α) := (∑' j, ‖f j x‖ ^ 2) ^ (2 : ℝ)⁻¹

/-- Constant in the main theorem on Type IV superorthogonality. -/
def C (r : ℕ) : ENNReal := match r with
  | 1 => 1
  | r => 2 ^ ((2 : ℝ)⁻¹) * ((2 * r)! - 1) ^ ((2 : ℝ)⁻¹)

end Definitions

variable {α : Type*} [MeasurableSpace α]
variable (μ : Measure α)
variable {ι : Type*}
variable {r : ℕ}

/-- Theorem 1 of arXiv:2212.08956. -/
theorem sqfct_estimate_of_type_iv_superorthogonal [Countable ι]
    [Fact (1 ≤ (2 * (r : ENNReal)))] (hr : 1 ≤ r)
    {f : ι → Lp ℂ (2 * r) μ} (hf : TypeIVSuperorthogonal μ (fun i ↦ f i) r)
    (hsum : ∀ᵐ x ∂μ, Summable fun j ↦ ‖f j x‖ ^ 2)
    (hsq : MemLp (sqfct <| fun i ↦ f i) (2 * r) μ) :
    Summable f ∧ ENNReal.ofReal ‖∑' j, f j‖ ≤ C r * eLpNorm (sqfct <| fun i ↦ f i) (2 * r) μ := by
  sorry

end Superorthogonal
