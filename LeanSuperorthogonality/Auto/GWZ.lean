open EuclideanSpace

/-! ### Determinants in `ℝ³` -/

/-- The determinant of three vectors of `ℝ³`. -/
def det3 (u v w : EuclideanSpace ℝ (Fin 3)) : ℝ :=
  u 0 * (v 1 * w 2 - v 2 * w 1)
    - u 1 * (v 0 * w 2 - v 2 * w 0)
    + u 2 * (v 0 * w 1 - v 1 * w 0)

lemma det3_add_left (u u' v w : EuclideanSpace ℝ (Fin 3)) :
    det3 (u + u') v w = det3 u v w + det3 u' v w := by
  simp only [det3, PiLp.add_apply]
  ring

@[simp] lemma det3_self_fst_snd (u w : EuclideanSpace ℝ (Fin 3)) : det3 u u w = 0 := by
  simp only [det3]
  ring

@[simp] lemma det3_self_fst_trd (u v : EuclideanSpace ℝ (Fin 3)) : det3 u v u = 0 := by
  simp only [det3]
  ring

/-- The determinant is invariant under cyclic permutations. -/
lemma det3_cycle (u v w : EuclideanSpace ℝ (Fin 3)) : det3 w u v = det3 u v w := by
  simp only [det3]
  ring

/-! ### Section 3.1: determinants for three vectors from the cone -/

/-- The point `r (1, t, t² + ε)` of the thickened cone; in the notation of Section 1.1 this
is `Φ(r, t, r ε)`, so the thickness condition `|u| ≤ r h²` reads `|ε| ≤ h²`. -/
def conePt (r t ε : ℝ) : EuclideanSpace ℝ (Fin 3) := !₂[r, r * t, r * (t ^ 2 + ε)]

/-- The normalized determinant `D₃` of (3.1). -/
def D3 (t₁ t₂ t₃ ε₁ ε₂ ε₃ : ℝ) : ℝ :=
  det3 !₂[1, t₁, t₁ ^ 2 + ε₁] !₂[1, t₂, t₂ ^ 2 + ε₂] !₂[1, t₃, t₃ ^ 2 + ε₃]

/-- The radial parameters factor out of the determinant, which is (3.3). -/
lemma det3_conePt (r₁ r₂ r₃ t₁ t₂ t₃ ε₁ ε₂ ε₃ : ℝ) :
    det3 (conePt r₁ t₁ ε₁) (conePt r₂ t₂ ε₂) (conePt r₃ t₃ ε₃)
      = r₁ * r₂ * r₃ * D3 t₁ t₂ t₃ ε₁ ε₂ ε₃ := by
  simp only [det3, conePt, D3, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons,
    Matrix.cons_val_two, Matrix.tail_cons]
  ring

/-- **(3.1)**: the expansion of `D₃` in the gaps `d₁ = t₂ - t₁` and `d₂ = t₃ - t₂`. -/
lemma D3_eq (t₁ t₂ t₃ ε₁ ε₂ ε₃ : ℝ) :
    D3 t₁ t₂ t₃ ε₁ ε₂ ε₃
      = (t₂ - t₁) * (t₃ - t₂) * (t₃ - t₁)
        + ε₁ * (t₃ - t₂) - ε₂ * (t₃ - t₁) + ε₃ * (t₂ - t₁) := by
  simp only [D3, det3, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons,
    Matrix.cons_val_two, Matrix.tail_cons]
  ring

/-- **(3.2)-(3.3)**: on angular intervals separated by at least `2h`, and at thickness
`h²`, the normalized determinant is bounded below by `2 h² (d₁ + d₂) > 0`. -/
theorem D3_lower_bound {h t₁ t₂ t₃ ε₁ ε₂ ε₃ : ℝ} (hh : 0 < h)
    (h12 : 2 * h ≤ t₂ - t₁) (h23 : 2 * h ≤ t₃ - t₂)
    (he₁ : |ε₁| ≤ h ^ 2) (he₂ : |ε₂| ≤ h ^ 2) (he₃ : |ε₃| ≤ h ^ 2) :
    2 * h ^ 2 * (t₃ - t₁) ≤ D3 t₁ t₂ t₃ ε₁ ε₂ ε₃ := by
  rw [D3_eq]
  obtain ⟨he₁a, he₁b⟩ := abs_le.mp he₁
  obtain ⟨he₂a, he₂b⟩ := abs_le.mp he₂
  obtain ⟨he₃a, he₃b⟩ := abs_le.mp he₃
  have hd₁ : 0 < t₂ - t₁ := by nlinarith
  have hd₂ : 0 < t₃ - t₂ := by nlinarith
  have hsum : t₃ - t₁ = (t₂ - t₁) + (t₃ - t₂) := by ring
  have hprod : 4 * h ^ 2 ≤ (t₂ - t₁) * (t₃ - t₂) := by nlinarith
  nlinarith [hprod, hd₁, hd₂, sq_nonneg h]

/-- The determinant of three cone points on separated intervals is positive. -/
theorem det3_conePt_pos {h r₁ r₂ r₃ t₁ t₂ t₃ ε₁ ε₂ ε₃ : ℝ} (hh : 0 < h)
    (hr₁ : 0 < r₁) (hr₂ : 0 < r₂) (hr₃ : 0 < r₃)
    (h12 : 2 * h ≤ t₂ - t₁) (h23 : 2 * h ≤ t₃ - t₂)
    (he₁ : |ε₁| ≤ h ^ 2) (he₂ : |ε₂| ≤ h ^ 2) (he₃ : |ε₃| ≤ h ^ 2) :
    0 < det3 (conePt r₁ t₁ ε₁) (conePt r₂ t₂ ε₂) (conePt r₃ t₃ ε₃) := by
  rw [det3_conePt]
  have hD := D3_lower_bound hh h12 h23 he₁ he₂ he₃
  have ht : 0 < t₃ - t₁ := by linarith
  have hpos : 0 < 2 * h ^ 2 * (t₃ - t₁) := by positivity
  have : 0 < D3 t₁ t₂ t₃ ε₁ ε₂ ε₃ := lt_of_lt_of_le hpos hD
  positivity

/-! ### Section 3.2: four ordered points, two forbidden pairings

Four points on separated thickened sectors satisfy `Δ_s > 0` for each of the four
determinants obtained by deleting one point. That single sign condition already rules out
both nonalternating two-against-two relations: applying the determinant to the relation
kills the right-hand side and leaves a sum of two positive terms.
-/

/-- **First forbidden pairing**: `ξ₁ + ξ₂ = ξ₃ + ξ₄` is impossible. -/
theorem forbidden_pairing_add_add {ξ₁ ξ₂ ξ₃ ξ₄ : EuclideanSpace ℝ (Fin 3)}
    (h₁ : 0 < det3 ξ₁ ξ₃ ξ₄) (h₂ : 0 < det3 ξ₂ ξ₃ ξ₄) :
    ξ₁ + ξ₂ ≠ ξ₃ + ξ₄ := by
  intro hcon
  have h := congrArg (fun v ↦ det3 v ξ₃ ξ₄) hcon
  simp only [det3_add_left, det3_self_fst_snd, det3_self_fst_trd, add_zero] at h
  linarith

/-- **Second forbidden pairing**: `ξ₁ + ξ₄ = ξ₂ + ξ₃` is impossible. -/
theorem forbidden_pairing_outer_inner {ξ₁ ξ₂ ξ₃ ξ₄ : EuclideanSpace ℝ (Fin 3)}
    (h₁ : 0 < det3 ξ₁ ξ₂ ξ₃) (h₄ : 0 < det3 ξ₂ ξ₃ ξ₄) :
    ξ₁ + ξ₄ ≠ ξ₂ + ξ₃ := by
  intro hcon
  have h := congrArg (fun v ↦ det3 v ξ₂ ξ₃) hcon
  simp only [det3_add_left, det3_self_fst_snd, det3_self_fst_trd, add_zero] at h
  rw [det3_cycle ξ₂ ξ₃ ξ₄] at h
  linarith

/-! ### Section 3.3: the quadratic form for equal-size caps -/

/-- The cone parametrization `Φ(r,t,u) = (r, r t, r t² + u)` of Section 1.1. -/
def Phi (r t u : ℝ) : EuclideanSpace ℝ (Fin 3) := !₂[r, r * t, r * t ^ 2 + u]

lemma Phi_eq_conePt (r t u : ℝ) (hr : r ≠ 0) : Phi r t u = conePt r t (u / r) := by
  unfold Phi conePt
  congr 1
  field_simp

/-- The quadratic form `Q(ξ) = ξ₁ ξ₃ - ξ₂²` of Section 3.3. -/
def Qform (ξ : EuclideanSpace ℝ (Fin 3)) : ℝ := ξ 0 * ξ 2 - ξ 1 ^ 2

/-- **(3.6)**: `Q(Φ(r,t,u) - Φ(r',t',u')) = -r r' (t - t')² + (r - r')(u - u')`. -/
lemma Qform_Phi_sub (r t u r' t' u' : ℝ) :
    Qform (Phi r t u - Phi r' t' u') = -(r * r') * (t - t') ^ 2 + (r - r') * (u - u') := by
  simp only [Qform, Phi, PiLp.sub_apply, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.head_cons, Matrix.cons_val_two, Matrix.tail_cons]
  ring

/-- Within one cap the form is small: this is the pointwise content of **(3.7)**. -/
lemma abs_Qform_le_of_same_cap {w r t u r' t' u' : ℝ} (_hw : 0 < w)
    (hr : 1 ≤ r) (hr2 : r ≤ 2) (hr' : 1 ≤ r') (hr'2 : r' ≤ 2)
    (hu : |u| ≤ w ^ 2) (hu' : |u'| ≤ w ^ 2) (htt : |t - t'| ≤ w) :
    |Qform (Phi r t u - Phi r' t' u')| ≤ 6 * w ^ 2 := by
  rw [Qform_Phi_sub]
  obtain ⟨hua, hub⟩ := abs_le.mp hu
  obtain ⟨hu'a, hu'b⟩ := abs_le.mp hu'
  obtain ⟨htta, httb⟩ := abs_le.mp htt
  have hsq : (t - t') ^ 2 ≤ w ^ 2 := by nlinarith
  have hsqnn : (0:ℝ) ≤ (t - t') ^ 2 := sq_nonneg _
  have hrr : 1 ≤ r * r' := by nlinarith
  have hrr4 : r * r' ≤ 4 := by nlinarith
  have hAnn : (0:ℝ) ≤ r * r' * (t - t') ^ 2 := by positivity
  have hA : r * r' * (t - t') ^ 2 ≤ 4 * w ^ 2 := by nlinarith [hsq, hsqnn, hrr4]
  have hB : |(r - r') * (u - u')| ≤ 2 * w ^ 2 := by
    rw [abs_mul]
    have h1 : |r - r'| ≤ 1 := by rw [abs_le]; constructor <;> linarith
    have h2 : |u - u'| ≤ 2 * w ^ 2 := by rw [abs_le]; constructor <;> linarith
    nlinarith [abs_nonneg (r - r'), abs_nonneg (u - u'), h1, h2]
  obtain ⟨hBa, hBb⟩ := abs_le.mp hB
  rw [abs_le]
  constructor <;> linarith

/-- Between distinct caps the form is large and negative: the pointwise content of
**(3.9)**. -/
lemma le_neg_Qform_of_far {w r t u r' t' u' : ℝ} (hw : 0 < w)
    (hr : 1 ≤ r) (hr2 : r ≤ 2) (hr' : 1 ≤ r') (hr'2 : r' ≤ 2)
    (hu : |u| ≤ w ^ 2) (hu' : |u'| ≤ w ^ 2) (htt : 10 * w ≤ |t - t'|) :
    98 * w ^ 2 ≤ -Qform (Phi r t u - Phi r' t' u') := by
  rw [Qform_Phi_sub]
  obtain ⟨hua, hub⟩ := abs_le.mp hu
  obtain ⟨hu'a, hu'b⟩ := abs_le.mp hu'
  have hsq : 100 * w ^ 2 ≤ (t - t') ^ 2 := by
    have h0 : (0:ℝ) ≤ 10 * w := by linarith
    have habs := abs_nonneg (t - t')
    nlinarith [sq_abs (t - t'), htt, h0]
  have hrr : 1 ≤ r * r' := by nlinarith
  have hA : 100 * w ^ 2 ≤ r * r' * (t - t') ^ 2 := by
    have hge : (0:ℝ) ≤ (r * r' - 1) * (t - t') ^ 2 :=
      mul_nonneg (by linarith) (sq_nonneg _)
    nlinarith [hge, hsq]
  have hB : |(r - r') * (u - u')| ≤ 2 * w ^ 2 := by
    rw [abs_mul]
    obtain ⟨hua, hub⟩ := abs_le.mp hu
    obtain ⟨hu'a, hu'b⟩ := abs_le.mp hu'
    have h1 : |r - r'| ≤ 1 := by rw [abs_le]; constructor <;> linarith
    have h2 : |u - u'| ≤ 2 * w ^ 2 := by rw [abs_le]; constructor <;> linarith
    nlinarith [abs_nonneg (r - r'), abs_nonneg (u - u'), h1, h2]
  obtain ⟨hBa, hBb⟩ := abs_le.mp hB
  linarith

/-! ### Section 3.3: Lemma 3.2, the equal-size cap sectors -/

/-- Pointwise form of **(3.8)**: between two caps whose centres are `d ≥ 11 w` apart the
form `-Q` is comparable to `d²`. -/
lemma Qform_bounds_of_far_pointwise {w d r t u r' t' u' : ℝ} (hw : 0 < w) (hd : 11 * w ≤ d)
    (hr : 1 ≤ r) (hr2 : r ≤ 2) (hr' : 1 ≤ r') (hr'2 : r' ≤ 2)
    (hu : |u| ≤ w ^ 2) (hu' : |u'| ≤ w ^ 2)
    (hlo : d - w ≤ |t - t'|) (hhi : |t - t'| ≤ d + w) :
    (1 / 2) * d ^ 2 ≤ -Qform (Phi r t u - Phi r' t' u')
      ∧ -Qform (Phi r t u - Phi r' t' u') ≤ 5 * d ^ 2 := by
  rw [Qform_Phi_sub]
  obtain ⟨hua, hub⟩ := abs_le.mp hu
  obtain ⟨hu'a, hu'b⟩ := abs_le.mp hu'
  have hdw : 0 < d - w := by linarith
  have habs := abs_nonneg (t - t')
  have hsqlo : (d - w) ^ 2 ≤ (t - t') ^ 2 := by
    nlinarith [sq_abs (t - t'), hlo, hdw]
  have hsqhi : (t - t') ^ 2 ≤ (d + w) ^ 2 := by
    nlinarith [sq_abs (t - t'), hhi, habs]
  have hrr : 1 ≤ r * r' := by nlinarith
  have hrr4 : r * r' ≤ 4 := by nlinarith
  have hsqnn : (0:ℝ) ≤ (t - t') ^ 2 := sq_nonneg _
  have hB : |(r - r') * (u - u')| ≤ 2 * w ^ 2 := by
    rw [abs_mul]
    have h1 : |r - r'| ≤ 1 := by rw [abs_le]; constructor <;> linarith
    have h2 : |u - u'| ≤ 2 * w ^ 2 := by rw [abs_le]; constructor <;> linarith
    nlinarith [abs_nonneg (r - r'), abs_nonneg (u - u'), h1, h2]
  obtain ⟨hBa, hBb⟩ := abs_le.mp hB
  have hAlo : (d - w) ^ 2 ≤ r * r' * (t - t') ^ 2 := by
    have hge : (0:ℝ) ≤ (r * r' - 1) * (t - t') ^ 2 :=
      mul_nonneg (by linarith) (sq_nonneg _)
    nlinarith [hge, hsqlo]
  have hAhi : r * r' * (t - t') ^ 2 ≤ 4 * (d + w) ^ 2 := by
    nlinarith [hsqhi, hrr4, hsqnn, sq_nonneg (d + w)]
  constructor
  · nlinarith [hAlo, hBb, hd, hw]
  · nlinarith [hAhi, hBa, hd, hw]

section Caps

open scoped Pointwise

/-- The equal-size cap sector of **(3.5)**:
`Ω = {Φ(r,t,u) : 1 ≤ r ≤ 2, t ∈ I, |u| ≤ w²}`. -/
def capSector (w : ℝ) (I : Set ℝ) : Set (EuclideanSpace ℝ (Fin 3)) :=
  {ξ | ∃ r t u, 1 ≤ r ∧ r ≤ 2 ∧ t ∈ I ∧ |u| ≤ w ^ 2 ∧ ξ = Phi r t u}

/-- **(3.7)**: within one cap, `|Q| ≤ 6 w²` on the difference set. -/
theorem abs_Qform_le_of_mem_sub_self {w : ℝ} (hw : 0 < w) {I : Set ℝ}
    (hI : ∀ s ∈ I, ∀ t ∈ I, |s - t| ≤ w) :
    ∀ ξ ∈ capSector w I - capSector w I, |Qform ξ| ≤ 6 * w ^ 2 := by
  rintro ξ hξ
  obtain ⟨p, ⟨r, t, u, hr, hr2, ht, hu, rfl⟩, q, ⟨r', t', u', hr', hr'2, ht', hu', rfl⟩, rfl⟩ :=
    Set.mem_sub.mp hξ
  exact abs_Qform_le_of_same_cap hw hr hr2 hr' hr'2 hu hu' (hI t ht t' ht')

/-- **(3.9)**: a self-difference set and a difference set of two distinct caps are
disjoint. -/
theorem disjoint_capSector_sub {w : ℝ} (hw : 0 < w) {I J K : Set ℝ}
    (hI : ∀ s ∈ I, ∀ t ∈ I, |s - t| ≤ w)
    (hJK : ∀ s ∈ J, ∀ t ∈ K, 10 * w ≤ |s - t|) :
    Disjoint (capSector w I - capSector w I) (capSector w J - capSector w K) := by
  rw [Set.disjoint_left]
  intro ξ hleft hright
  have h1 : |Qform ξ| ≤ 6 * w ^ 2 := abs_Qform_le_of_mem_sub_self hw hI ξ hleft
  obtain ⟨p, ⟨r, t, u, hr, hr2, ht, hu, rfl⟩, q, ⟨r', t', u', hr', hr'2, ht', hu', rfl⟩, rfl⟩ :=
    Set.mem_sub.mp hright
  have h2 : 98 * w ^ 2 ≤ -Qform (Phi r t u - Phi r' t' u') :=
    le_neg_Qform_of_far hw hr hr2 hr' hr'2 hu hu' (hJK t ht t' ht')
  have h3 := neg_abs_le (Qform (Phi r t u - Phi r' t' u'))
  nlinarith [hw, sq_nonneg w]

/-- **(3.8)**: between two caps with centres `d ≥ 11 w` apart, `-Q` is comparable to
`d²`. -/
theorem Qform_bounds_of_mem_sub {w d : ℝ} (hw : 0 < w) (hd : 11 * w ≤ d) {I J : Set ℝ}
    (hIJ : ∀ s ∈ I, ∀ t ∈ J, d - w ≤ |s - t| ∧ |s - t| ≤ d + w) :
    ∀ ξ ∈ capSector w I - capSector w J,
      (1 / 2) * d ^ 2 ≤ -Qform ξ ∧ -Qform ξ ≤ 5 * d ^ 2 := by
  rintro ξ hξ
  obtain ⟨p, ⟨r, t, u, hr, hr2, ht, hu, rfl⟩, q, ⟨r', t', u', hr', hr'2, ht', hu', rfl⟩, rfl⟩ :=
    Set.mem_sub.mp hξ
  obtain ⟨hlo, hhi⟩ := hIJ t ht t' ht'
  exact Qform_bounds_of_far_pointwise hw hd hr hr2 hr' hr'2 hu hu' hlo hhi

end Caps

/-! ### Section 3.3: Lemma 3.3, bounded overlap of dyadic difference shells -/

/-- The angular interval of a cap: `I = [t - w/2, t + w/2]`, as in (3.5). -/
def capInterval (w t : ℝ) : Set ℝ := Set.Icc (t - w / 2) (t + w / 2)

lemma diam_capInterval {w t : ℝ} (_hw : 0 < w) :
    ∀ s ∈ capInterval w t, ∀ s' ∈ capInterval w t, |s - s'| ≤ w := by
  rintro s ⟨hs1, hs2⟩ s' ⟨hs'1, hs'2⟩
  rw [abs_le]
  constructor <;> linarith

lemma sub_bounds_capInterval {w t t' : ℝ} (_hw : 0 < w) :
    ∀ s ∈ capInterval w t, ∀ s' ∈ capInterval w t',
      |t - t'| - w ≤ |s - s'| ∧ |s - s'| ≤ |t - t'| + w := by
  rintro s ⟨hs1, hs2⟩ s' ⟨hs'1, hs'2⟩
  have h1 : |(s - s') - (t - t')| ≤ w := by
    rw [abs_le]
    constructor <;> linarith
  constructor
  · have := abs_sub_abs_le_abs_sub (t - t') (s - s')
    rw [show (t - t') - (s - s') = -((s - s') - (t - t')) by ring, abs_neg] at this
    linarith
  · have := abs_sub_abs_le_abs_sub (s - s') (t - t')
    linarith

lemma tenw_le_sub_capInterval {w t t' : ℝ} (hw : 0 < w) (hsep : 11 * w ≤ |t - t'|) :
    ∀ s ∈ capInterval w t, ∀ s' ∈ capInterval w t', 10 * w ≤ |s - s'| := by
  intro s hs s' hs'
  have := (sub_bounds_capInterval hw s hs s' hs').1
  linarith

/-- The dyadic band `E_s` of the proof of Lemma 3.3. -/
def Eband (D : ℝ) (s : ℕ) : Set (EuclideanSpace ℝ (Fin 3)) :=
  {ξ | (1 / 8) * D ^ 2 * 4 ^ s ≤ -Qform ξ ∧ -Qform ξ ≤ 20 * D ^ 2 * 4 ^ s}

section Bands

open scoped Pointwise

/-- **(3.8) rescaled**: a difference set at dyadic scale `s` lies in the band `E_s`. -/
theorem sub_capSector_subset_Eband {w D d : ℝ} (hw : 0 < w) (hd : 11 * w ≤ d)
    {s : ℕ} (hlo : 2 ^ s * D / 2 ≤ d) (hhi : d ≤ 2 * (2 ^ s * D)) {t t' : ℝ}
    (hdd : |t - t'| = d) :
    capSector w (capInterval w t) - capSector w (capInterval w t') ⊆ Eband D s := by
  intro ξ hξ
  have hIJ : ∀ x ∈ capInterval w t, ∀ y ∈ capInterval w t',
      d - w ≤ |x - y| ∧ |x - y| ≤ d + w := by
    intro x hx y hy
    have h := sub_bounds_capInterval hw x hx y hy
    rw [hdd] at h
    exact h
  obtain ⟨h1, h2⟩ := Qform_bounds_of_mem_sub hw hd hIJ ξ hξ
  have hdnn : 0 ≤ d := by linarith
  have hpow : (0:ℝ) < 2 ^ s := by positivity
  have hsq : ((2:ℝ) ^ s) ^ 2 = 4 ^ s := by
    rw [← pow_mul, show (4:ℝ) = 2 ^ 2 by norm_num, ← pow_mul, mul_comm]
  constructor
  · have hlo2 : (2 ^ s * D / 2) ^ 2 ≤ d ^ 2 := by nlinarith [hlo, hpow, hdnn]
    have hexp : (2 ^ s * D / 2 : ℝ) ^ 2 = (1 / 4) * D ^ 2 * 4 ^ s := by
      rw [div_pow, mul_pow, hsq]
      ring
    rw [hexp] at hlo2
    nlinarith [h1, hlo2]
  · have hhi2 : d ^ 2 ≤ (2 * (2 ^ s * D)) ^ 2 := by nlinarith [hhi, hpow, hdnn]
    have hexp : (2 * (2 ^ s * D) : ℝ) ^ 2 = 4 * D ^ 2 * 4 ^ s := by
      rw [mul_pow, mul_pow, hsq]
      ring
    rw [hexp] at hhi2
    nlinarith [h2, hhi2]

end Bands

/-- Bands four apart are disjoint. -/
theorem disjoint_Eband {D : ℝ} (hD : 0 < D) {s s' : ℕ} (h : s + 4 ≤ s') :
    Disjoint (Eband D s) (Eband D s') := by
  rw [Set.disjoint_left]
  rintro ξ ⟨-, hub⟩ ⟨hlb, -⟩
  have hmono : (4:ℝ) ^ (s + 4) ≤ 4 ^ s' := by
    exact pow_le_pow_right₀ (by norm_num) h
  have hexp : (4:ℝ) ^ (s + 4) = 256 * 4 ^ s := by
    rw [pow_add]
    ring
  rw [hexp] at hmono
  have hpos : (0:ℝ) < D ^ 2 * 4 ^ s := by positivity
  have hcoef : (0:ℝ) ≤ 1 / 8 * D ^ 2 := by positivity
  have hstep := mul_le_mul_of_nonneg_left hmono hcoef
  nlinarith [hstep, hub, hlb, hpos]

/-- **(3.11)**: at most four bands contain any given point. -/
theorem card_le_of_mem_Eband {D : ℝ} (hD : 0 < D) (ξ : EuclideanSpace ℝ (Fin 3))
    (S : Finset ℕ) (hS : ∀ s ∈ S, ξ ∈ Eband D s) : S.card ≤ 4 := by
  rcases S.eq_empty_or_nonempty with rfl | hne
  · simp
  · set m := S.min' hne with hm
    have hsub : S ⊆ Finset.Ico m (m + 4) := by
      intro s hs
      refine Finset.mem_Ico.mpr ⟨S.min'_le s hs, ?_⟩
      by_contra hcon
      have hle : m + 4 ≤ s := by omega
      have hmem : ξ ∈ Eband D m := hS m (S.min'_mem hne)
      exact Set.disjoint_left.mp (disjoint_Eband hD hle) hmem (hS s hs)
    calc S.card ≤ (Finset.Ico m (m + 4)).card := Finset.card_le_card hsub
      _ = 4 := by simp


/-! ### Fourier supports of products

The Fourier transform of a product of Schwartz functions is the convolution of their
transforms, so its support lies in the Minkowski sum of the supports. Mathlib provides the
convolution theorem in the form `SchwartzMap.fourier_convolution`; this section turns it
around and reads off the support statement, which is the analytic input to Lemma 3.1.
-/

section FourierSupport

open SchwartzMap FourierTransform MeasureTheory ContinuousLinearMap
open scoped Pointwise Convolution

variable {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℝ V] [FiniteDimensional ℝ V]
  [MeasurableSpace V] [BorelSpace V]

/-- The pointwise product of two Schwartz functions, as a Schwartz function. -/
def schwartzMul (a b : 𝓢(V, ℂ)) : 𝓢(V, ℂ) := SchwartzMap.pairing (mul ℂ ℂ) a b

omit [FiniteDimensional ℝ V] [MeasurableSpace V] [BorelSpace V] in
lemma schwartzMul_apply (a b : 𝓢(V, ℂ)) (x : V) :
    schwartzMul a b x = a x * b x := rfl

/-- **Multiplication-convolution duality**: the inverse Fourier transform of a product is
the convolution of the inverse transforms. -/
theorem fourierInv_schwartzMul (a b : 𝓢(V, ℂ)) :
    𝓕⁻ (schwartzMul a b)
      = SchwartzMap.convolution (mul ℂ ℂ) (𝓕⁻ a) (𝓕⁻ b) := by
  have hprod : schwartzMul a b
      = 𝓕 (SchwartzMap.convolution (mul ℂ ℂ) (𝓕⁻ a) (𝓕⁻ b)) := by
    rw [schwartzMul, SchwartzMap.fourier_convolution,
      FourierTransform.fourier_fourierInv_eq, FourierTransform.fourier_fourierInv_eq]
  rw [hprod, FourierTransform.fourierInv_fourier_eq]

/-- The support of the inverse transform of a product lies in the Minkowski sum. -/
theorem support_fourierInv_schwartzMul_subset (a b : 𝓢(V, ℂ)) {S T : Set V}
    (ha : Function.support (fun x : V ↦ (𝓕⁻ a) x) ⊆ S)
    (hb : Function.support (fun x : V ↦ (𝓕⁻ b) x) ⊆ T) :
    Function.support (fun x : V ↦ (𝓕⁻ (schwartzMul a b)) x) ⊆ S + T := by
  intro z hz
  have hz0 : (𝓕⁻ (schwartzMul a b)) z ≠ 0 := Function.mem_support.mp hz
  rw [fourierInv_schwartzMul] at hz0
  have hz' : z ∈ Function.support
      (MeasureTheory.convolution (fun x : V ↦ (𝓕⁻ a) x) (fun x : V ↦ (𝓕⁻ b) x)
        (mul ℂ ℂ) MeasureTheory.volume) := by
    refine Function.mem_support.mpr ?_
    simpa only [SchwartzMap.convolution_apply] using hz0
  exact Set.add_subset_add ha hb (MeasureTheory.support_convolution_subset (mul ℂ ℂ) hz')

/-- The inverse transform is the transform reflected, so the supports are negatives. -/
lemma support_fourierInv_eq_neg (a : 𝓢(V, ℂ)) :
    Function.support (fun x : V ↦ (𝓕⁻ a) x)
      = -Function.support (fun x : V ↦ (𝓕 a) x) := by
  ext x
  simp only [Set.mem_neg, Function.mem_support, ne_eq]
  rw [SchwartzMap.fourierInv_coe, Real.fourierInv_eq_fourier_neg]
  rfl

/-- **The Fourier support of a product** lies in the Minkowski sum of the Fourier
supports. This is the analytic input to Lemma 3.1. -/
theorem support_fourier_schwartzMul_subset (a b : 𝓢(V, ℂ)) {S T : Set V}
    (ha : Function.support (fun x : V ↦ (𝓕 a) x) ⊆ S)
    (hb : Function.support (fun x : V ↦ (𝓕 b) x) ⊆ T) :
    Function.support (fun x : V ↦ (𝓕 (schwartzMul a b)) x) ⊆ S + T := by
  have ha' : Function.support (fun x : V ↦ (𝓕⁻ a) x) ⊆ -S := by
    rw [support_fourierInv_eq_neg]
    exact Set.neg_subset_neg.mpr ha
  have hb' : Function.support (fun x : V ↦ (𝓕⁻ b) x) ⊆ -T := by
    rw [support_fourierInv_eq_neg]
    exact Set.neg_subset_neg.mpr hb
  have hmain := support_fourierInv_schwartzMul_subset a b ha' hb'
  rw [support_fourierInv_eq_neg] at hmain
  have hneg : -Function.support (fun x : V ↦ (𝓕 (schwartzMul a b)) x) ⊆ -(S + T) := by
    refine hmain.trans ?_
    exact (neg_add S T).symm.subset
  have := Set.neg_subset_neg.mpr hneg
  simpa using this

/-- **Plancherel plus disjoint Fourier supports** forces the pairing to vanish. -/
theorem integral_mul_conj_eq_zero_of_disjoint (u v : 𝓢(V, ℂ))
    (hdisj : Disjoint (Function.support fun ξ : V ↦ (𝓕 u) ξ)
      (Function.support fun ξ : V ↦ (𝓕 v) ξ)) :
    ∫ x, u x * (starRingEnd ℂ) (v x) = 0 := by
  have hpl := SchwartzMap.integral_inner_fourier_fourier v u
  have hzero : ∀ ξ : V, (inner ℂ ((𝓕 v) ξ) ((𝓕 u) ξ) : ℂ) = 0 := by
    intro ξ
    by_cases h : (𝓕 u) ξ = 0
    · simp [h]
    · have hu : ξ ∈ Function.support fun ξ : V ↦ (𝓕 u) ξ := h
      have hv : (𝓕 v) ξ = 0 := by
        by_contra hv
        exact Set.disjoint_left.mp hdisj hu hv
      simp [hv]
  rw [integral_congr_ae (Filter.Eventually.of_forall hzero), integral_zero] at hpl
  have hres : (∫ x, (inner ℂ (v x) (u x) : ℂ)) = 0 := hpl.symm
  rw [← hres]
  refine integral_congr_ae (Filter.Eventually.of_forall fun x ↦ ?_)
  simp only []
  rw [RCLike.inner_apply]

/-- **Lemma 3.1, analytic half**: two products of Schwartz functions with Fourier supports
in Minkowski sums that are disjoint pair against zero. -/
theorem integral_prod_mul_conj_prod_eq_zero (a b c d : 𝓢(V, ℂ))
    {S₁ S₂ T₁ T₂ : Set V}
    (ha : Function.support (fun ξ : V ↦ (𝓕 a) ξ) ⊆ S₁)
    (hb : Function.support (fun ξ : V ↦ (𝓕 b) ξ) ⊆ S₂)
    (hc : Function.support (fun ξ : V ↦ (𝓕 c) ξ) ⊆ T₁)
    (hd : Function.support (fun ξ : V ↦ (𝓕 d) ξ) ⊆ T₂)
    (hdisj : Disjoint (S₁ + S₂) (T₁ + T₂)) :
    ∫ x, (a x * b x) * (starRingEnd ℂ) (c x * d x) = 0 := by
  have hab := support_fourier_schwartzMul_subset a b ha hb
  have hcd := support_fourier_schwartzMul_subset c d hc hd
  have hkey := integral_mul_conj_eq_zero_of_disjoint (schwartzMul a b) (schwartzMul c d)
    (Set.disjoint_of_subset hab hcd hdisj)
  rw [← hkey]
  refine integral_congr_ae (Filter.Eventually.of_forall fun x ↦ ?_)
  simp only [schwartzMul_apply]

end FourierSupport

/-! ### The thickened cone sectors and their forbidden sums -/

section Sectors

open SchwartzMap FourierTransform MeasureTheory
open scoped Pointwise SchwartzMap

/-- The thickened cone sector over an angular set, as in (1.4):
`{Φ(r,t,u) : r ≥ a, t ∈ I, |u| ≤ r h²}`, written through `conePt` so that the thickness
condition reads `|ε| ≤ h²`. -/
def coneSector (a h : ℝ) (I : Set ℝ) : Set (EuclideanSpace ℝ (Fin 3)) :=
  {ξ | ∃ r t ε, a ≤ r ∧ t ∈ I ∧ |ε| ≤ h ^ 2 ∧ ξ = conePt r t ε}

variable {a h : ℝ} {I₁ I₂ I₃ I₄ : Set ℝ}

/-- **The first forbidden sum**: `Γ₁ + Γ₂` and `Γ₃ + Γ₄` are disjoint. -/
theorem disjoint_coneSector_add_add (ha : 0 < a) (hh : 0 < h)
    (h12 : ∀ s ∈ I₁, ∀ t ∈ I₂, 2 * h ≤ t - s)
    (h23 : ∀ s ∈ I₂, ∀ t ∈ I₃, 2 * h ≤ t - s)
    (h34 : ∀ s ∈ I₃, ∀ t ∈ I₄, 2 * h ≤ t - s) :
    Disjoint (coneSector a h I₁ + coneSector a h I₂)
      (coneSector a h I₃ + coneSector a h I₄) := by
  rw [Set.disjoint_left]
  rintro ξ hleft hright
  obtain ⟨p, ⟨r₁, t₁, ε₁, hr₁, ht₁, he₁, rfl⟩, q, ⟨r₂, t₂, ε₂, hr₂, ht₂, he₂, rfl⟩, hpq⟩ :=
    Set.mem_add.mp hleft
  obtain ⟨u, ⟨r₃, t₃, ε₃, hr₃, ht₃, he₃, rfl⟩, v, ⟨r₄, t₄, ε₄, hr₄, ht₄, he₄, rfl⟩, huv⟩ :=
    Set.mem_add.mp hright
  have hg12 : 2 * h ≤ t₂ - t₁ := h12 t₁ ht₁ t₂ ht₂
  have hg23 : 2 * h ≤ t₃ - t₂ := h23 t₂ ht₂ t₃ ht₃
  have hg34 : 2 * h ≤ t₄ - t₃ := h34 t₃ ht₃ t₄ ht₄
  have hg13 : 2 * h ≤ t₃ - t₁ := by linarith
  have hrp₁ : 0 < r₁ := lt_of_lt_of_le ha hr₁
  have hrp₂ : 0 < r₂ := lt_of_lt_of_le ha hr₂
  have hrp₃ : 0 < r₃ := lt_of_lt_of_le ha hr₃
  have hrp₄ : 0 < r₄ := lt_of_lt_of_le ha hr₄
  have hd₁ : 0 < det3 (conePt r₁ t₁ ε₁) (conePt r₃ t₃ ε₃) (conePt r₄ t₄ ε₄) :=
    det3_conePt_pos hh hrp₁ hrp₃ hrp₄ hg13 hg34 he₁ he₃ he₄
  have hd₂ : 0 < det3 (conePt r₂ t₂ ε₂) (conePt r₃ t₃ ε₃) (conePt r₄ t₄ ε₄) :=
    det3_conePt_pos hh hrp₂ hrp₃ hrp₄ hg23 hg34 he₂ he₃ he₄
  exact forbidden_pairing_add_add hd₁ hd₂ (hpq.trans huv.symm)

/-- **The second forbidden sum**: `Γ₁ + Γ₄` and `Γ₂ + Γ₃` are disjoint. -/
theorem disjoint_coneSector_outer_inner (ha : 0 < a) (hh : 0 < h)
    (h12 : ∀ s ∈ I₁, ∀ t ∈ I₂, 2 * h ≤ t - s)
    (h23 : ∀ s ∈ I₂, ∀ t ∈ I₃, 2 * h ≤ t - s)
    (h34 : ∀ s ∈ I₃, ∀ t ∈ I₄, 2 * h ≤ t - s) :
    Disjoint (coneSector a h I₁ + coneSector a h I₄)
      (coneSector a h I₂ + coneSector a h I₃) := by
  rw [Set.disjoint_left]
  rintro ξ hleft hright
  obtain ⟨p, ⟨r₁, t₁, ε₁, hr₁, ht₁, he₁, rfl⟩, q, ⟨r₄, t₄, ε₄, hr₄, ht₄, he₄, rfl⟩, hpq⟩ :=
    Set.mem_add.mp hleft
  obtain ⟨u, ⟨r₂, t₂, ε₂, hr₂, ht₂, he₂, rfl⟩, v, ⟨r₃, t₃, ε₃, hr₃, ht₃, he₃, rfl⟩, huv⟩ :=
    Set.mem_add.mp hright
  have hg12 : 2 * h ≤ t₂ - t₁ := h12 t₁ ht₁ t₂ ht₂
  have hg23 : 2 * h ≤ t₃ - t₂ := h23 t₂ ht₂ t₃ ht₃
  have hg34 : 2 * h ≤ t₄ - t₃ := h34 t₃ ht₃ t₄ ht₄
  have hrp₁ : 0 < r₁ := lt_of_lt_of_le ha hr₁
  have hrp₂ : 0 < r₂ := lt_of_lt_of_le ha hr₂
  have hrp₃ : 0 < r₃ := lt_of_lt_of_le ha hr₃
  have hrp₄ : 0 < r₄ := lt_of_lt_of_le ha hr₄
  have hd₁ : 0 < det3 (conePt r₁ t₁ ε₁) (conePt r₂ t₂ ε₂) (conePt r₃ t₃ ε₃) :=
    det3_conePt_pos hh hrp₁ hrp₂ hrp₃ hg12 hg23 he₁ he₂ he₃
  have hd₄ : 0 < det3 (conePt r₂ t₂ ε₂) (conePt r₃ t₃ ε₃) (conePt r₄ t₄ ε₄) :=
    det3_conePt_pos hh hrp₂ hrp₃ hrp₄ hg23 hg34 he₂ he₃ he₄
  exact forbidden_pairing_outer_inner hd₁ hd₄ (hpq.trans huv.symm)

/-- **Lemma 3.1**: Schwartz functions whose Fourier transforms are supported in separated
thickened cone sectors satisfy the two ordered cancellation identities (1.2). -/
theorem lemma_3_1 {N : ℕ} {a h : ℝ} (ha : 0 < a) (hh : 0 < h) {I : Fin N → Set ℝ}
    (hsep : ∀ m n : Fin N, m < n → ∀ s ∈ I m, ∀ t ∈ I n, 2 * h ≤ t - s)
    (g : Fin N → 𝓢(EuclideanSpace ℝ (Fin 3), ℂ))
    (hsupp : ∀ n, Function.support
      (fun ξ : EuclideanSpace ℝ (Fin 3) ↦ (FourierTransform.fourier (g n)) ξ)
      ⊆ coneSector a h (I n))
    {i j k l : Fin N} (hij : i < j) (hjk : j < k) (hkl : k < l) :
    (∫ x, (g i x * g j x) * (starRingEnd ℂ) (g k x * g l x) = 0)
      ∧ (∫ x, (g i x * g l x) * (starRingEnd ℂ) (g j x * g k x) = 0) := by
  have h12 : ∀ s ∈ I i, ∀ t ∈ I j, 2 * h ≤ t - s := hsep i j hij
  have h23 : ∀ s ∈ I j, ∀ t ∈ I k, 2 * h ≤ t - s := hsep j k hjk
  have h34 : ∀ s ∈ I k, ∀ t ∈ I l, 2 * h ≤ t - s := hsep k l hkl
  constructor
  · exact integral_prod_mul_conj_prod_eq_zero (g i) (g j) (g k) (g l)
      (hsupp i) (hsupp j) (hsupp k) (hsupp l)
      (disjoint_coneSector_add_add ha hh h12 h23 h34)
  · exact integral_prod_mul_conj_prod_eq_zero (g i) (g l) (g j) (g k)
      (hsupp i) (hsupp l) (hsupp j) (hsupp k)
      (disjoint_coneSector_outer_inner ha hh h12 h23 h34)

/-- **Lemma 3.1, packaged**: such a family satisfies the abstract hypothesis (1.2) of
Theorem 1.1, so Theorem 1.1 applies to it verbatim. -/
theorem orderedSuperorthogonal_of_coneSector {N : ℕ} {a h : ℝ} (ha : 0 < a) (hh : 0 < h)
    {I : Fin N → Set ℝ}
    (hsep : ∀ m n : Fin N, m < n → ∀ s ∈ I m, ∀ t ∈ I n, 2 * h ≤ t - s)
    (g : Fin N → 𝓢(EuclideanSpace ℝ (Fin 3), ℂ))
    (hsupp : ∀ n, Function.support
      (fun ξ : EuclideanSpace ℝ (Fin 3) ↦ (FourierTransform.fourier (g n)) ξ)
      ⊆ coneSector a h (I n)) :
    OrderedSuperorthogonal (MeasureTheory.volume : MeasureTheory.Measure
      (EuclideanSpace ℝ (Fin 3))) (fun n x ↦ g n x) where
  memLp n := (g n).memLp 4 _
  vanishA i j k l hij hjk hkl := by
    have h := (lemma_3_1 ha hh hsep g hsupp hij hjk hkl).1
    rw [← h]
    refine MeasureTheory.integral_congr_ae (Filter.Eventually.of_forall fun x ↦ ?_)
    simp only [map_mul]
    ring
  vanishB i j k l hij hjk hkl := by
    have h := (lemma_3_1 ha hh hsep g hsupp hij hjk hkl).2
    rw [← h]
    refine MeasureTheory.integral_congr_ae (Filter.Eventually.of_forall fun x ↦ ?_)
    simp only [map_mul]
    ring

end Sectors

/-! ### Section 4.2: Lemma 4.2, hypothesis (2.9) for the equal-cap family

The source verifies (2.9) from `supp(𝓕|f_i|²) ⊆ Ω_i - Ω_i` and
`supp(𝓕(f_k \overline{f_j})) ⊆ Ω_k - Ω_j` together with (3.9). Writing the integrand as
`(f_i f_j) \overline{(f_i f_k)}` instead avoids conjugated Schwartz functions entirely: only
the Fourier supports of the `f_n` themselves are needed, and the required disjointness of the
two Minkowski *sums* is equivalent to (3.9) by elementary set algebra.
-/

section ExtraCancel

open SchwartzMap FourierTransform MeasureTheory
open scoped Pointwise SchwartzMap

/-- Disjointness of the two sums is the same as (3.9) for the differences. -/
lemma disjoint_add_of_disjoint_sub {V : Type*} [AddCommGroup V] {S J K : Set V}
    (h : Disjoint (S - S) (K - J)) : Disjoint (S + J) (S + K) := by
  rw [Set.disjoint_left]
  intro x hx hy
  obtain ⟨s₁, hs₁, j, hj, hxj⟩ := Set.mem_add.mp hx
  obtain ⟨s₂, hs₂, k, hk, hxk⟩ := Set.mem_add.mp hy
  have h2 : s₁ + j = s₂ + k := hxj.trans hxk.symm
  have hkey : k - j = s₁ - s₂ := by
    calc k - j = (s₂ + k) - (s₂ + j) := by abel
      _ = (s₁ + j) - (s₂ + j) := by rw [← h2]
      _ = s₁ - s₂ := by abel
  have hm1 : s₁ - s₂ ∈ S - S := Set.mem_sub.mpr ⟨s₁, hs₁, s₂, hs₂, rfl⟩
  have hm2 : s₁ - s₂ ∈ K - J := Set.mem_sub.mpr ⟨k, hk, j, hj, hkey⟩
  exact Set.disjoint_left.mp h hm1 hm2

/-- **Hypothesis (2.9)** for a family of Schwartz functions with Fourier supports in
separated equal-size caps. -/
theorem extraCancellation_of_capSector {M : ℕ} {w : ℝ} (hw : 0 < w) {c : Fin M → ℝ}
    (hsep : ∀ i j : Fin M, i ≠ j → 11 * w ≤ |c i - c j|)
    (f : Fin M → 𝓢(EuclideanSpace ℝ (Fin 3), ℂ))
    (hsupp : ∀ n, Function.support
      (fun ξ : EuclideanSpace ℝ (Fin 3) ↦ (FourierTransform.fourier (f n)) ξ)
      ⊆ capSector w (capInterval w (c n))) :
    ExtraCancellation (MeasureTheory.volume : MeasureTheory.Measure
      (EuclideanSpace ℝ (Fin 3))) (fun n x ↦ f n x) where
  vanish i j k hjk := by
    have hdisj : Disjoint
        (capSector w (capInterval w (c i)) + capSector w (capInterval w (c j)))
        (capSector w (capInterval w (c i)) + capSector w (capInterval w (c k))) := by
      refine disjoint_add_of_disjoint_sub ?_
      exact disjoint_capSector_sub hw (diam_capInterval hw)
        (tenw_le_sub_capInterval hw (hsep k j (Ne.symm hjk)))
    have h := integral_prod_mul_conj_prod_eq_zero (f i) (f j) (f i) (f k)
      (hsupp i) (hsupp j) (hsupp i) (hsupp k) hdisj
    rw [← h]
    refine MeasureTheory.integral_congr_ae (Filter.Eventually.of_forall fun x ↦ ?_)
    simp only [map_mul]
    ring

/-- Every cap sector sits inside the thickened cone sector of Lemma 3.1 with `a = 1`,
`h = w`: the cap thickness `|u| ≤ w²` is stronger than `|u| ≤ r w²` when `r ≥ 1`. -/
lemma capSector_subset_coneSector {w : ℝ} (I : Set ℝ) :
    capSector w I ⊆ coneSector 1 w I := by
  rintro ξ ⟨r, t, u, hr1, hr2, ht, hu, rfl⟩
  have hrpos : (0:ℝ) < r := by linarith
  refine ⟨r, t, u / r, hr1, ht, ?_, Phi_eq_conePt r t u (ne_of_gt hrpos)⟩
  rw [abs_div, abs_of_pos hrpos, div_le_iff₀ hrpos]
  nlinarith [abs_nonneg u, hu, hr1]

/-- **Lemma 4.2's input**: an equal-cap family satisfies both hypotheses of Corollary 2.3,
so `‖V‖₂² ≤ 4 ‖S‖₄⁴` with no logarithmic loss. -/
theorem corollary_2_3_capFamily {M : ℕ} {w : ℝ} (hw : 0 < w) {c : Fin M → ℝ}
    (hmono : ∀ m n : Fin M, m < n → 11 * w ≤ c n - c m)
    (f : Fin M → 𝓢(EuclideanSpace ℝ (Fin 3), ℂ))
    (hsupp : ∀ n, Function.support
      (fun ξ : EuclideanSpace ℝ (Fin 3) ↦ (FourierTransform.fourier (f n)) ξ)
      ⊆ capSector w (capInterval w (c n))) :
    ∫ x, bigV (fun n x ↦ f n x) x ^ 2 ∂(MeasureTheory.volume :
        MeasureTheory.Measure (EuclideanSpace ℝ (Fin 3)))
      ≤ 4 * pow4S MeasureTheory.volume (fun n x ↦ f n x) := by
  -- the ordered superorthogonality hypothesis (1.2), through Lemma 3.1
  have hcone : ∀ n, Function.support
      (fun ξ : EuclideanSpace ℝ (Fin 3) ↦ (FourierTransform.fourier (f n)) ξ)
      ⊆ coneSector 1 w (capInterval w (c n)) :=
    fun n ↦ (hsupp n).trans (capSector_subset_coneSector _)
  have hgap : ∀ m n : Fin M, m < n →
      ∀ s ∈ capInterval w (c m), ∀ t ∈ capInterval w (c n), 2 * w ≤ t - s := by
    rintro m n hmn s ⟨hs1, hs2⟩ t ⟨ht1, ht2⟩
    have := hmono m n hmn
    linarith
  have h12 := orderedSuperorthogonal_of_coneSector (by norm_num : (0:ℝ) < 1) hw hgap f hcone
  -- the extra cancellation (2.9)
  have habs : ∀ i j : Fin M, i ≠ j → 11 * w ≤ |c i - c j| := by
    intro i j hij
    rcases lt_or_gt_of_ne hij with h | h
    · have := hmono i j h
      rw [abs_of_nonpos (by linarith)]
      linarith
    · have := hmono j i h
      rw [abs_of_nonneg (by linarith)]
      linarith
  have h29 := extraCancellation_of_capSector hw habs f hsupp
  exact corollary_2_3 h12 h29

end ExtraCancel

/-! ### Section 4.2: Lemma 4.1, the dyadic partition of unity

The cutoff is built from `Real.smoothTransition`, which is smooth, monotone, zero on
`(-∞,0]` and one on `[1,∞)`. Taking `η(x) = smoothTransition(4 - x²)` gives a smooth even
cutoff, equal to one for `x² ≤ 3` and vanishing for `x² ≥ 4`, and nonincreasing in `|x|`
because `smoothTransition` is monotone. The extra one-sided factor `χ` makes the bump vanish
on the negative axis, which is what the proof of Lemma 4.2 needs at (4.2).
-/

/-- The even smooth cutoff `η(x) = smoothTransition(4 - x²)`. -/
def eta (x : ℝ) : ℝ := Real.smoothTransition (4 - x ^ 2)

lemma eta_nonneg (x : ℝ) : 0 ≤ eta x := Real.smoothTransition.nonneg _

lemma eta_eq_one {x : ℝ} (hx : x ^ 2 ≤ 3) : eta x = 1 :=
  Real.smoothTransition.one_of_one_le (by linarith)

lemma eta_eq_zero {x : ℝ} (hx : 4 ≤ x ^ 2) : eta x = 0 :=
  Real.smoothTransition.zero_of_nonpos (by linarith)

lemma eta_antitone {x y : ℝ} (hx : 0 ≤ x) (hxy : x ≤ y) : eta y ≤ eta x :=
  Real.smoothTransition.monotone (by nlinarith)

lemma contDiff_eta {n : ℕ∞} : ContDiff ℝ (n : ℕ∞) eta :=
  Real.smoothTransition.contDiff.comp (by fun_prop)

/-- The one-sided smooth cutoff, zero for `x ≤ 1/4` and one for `x ≥ 1/2`. -/
def chi (x : ℝ) : ℝ := Real.smoothTransition (4 * x - 1)

lemma chi_nonneg (x : ℝ) : 0 ≤ chi x := Real.smoothTransition.nonneg _

lemma chi_eq_one {x : ℝ} (hx : 1 / 2 ≤ x) : chi x = 1 :=
  Real.smoothTransition.one_of_one_le (by linarith)

lemma chi_eq_zero {x : ℝ} (hx : x ≤ 1 / 4) : chi x = 0 :=
  Real.smoothTransition.zero_of_nonpos (by linarith)

lemma contDiff_chi {n : ℕ∞} : ContDiff ℝ (n : ℕ∞) chi :=
  Real.smoothTransition.contDiff.comp (by fun_prop)

/-- **Lemma 4.1**'s bump: smooth, nonnegative, and supported in `[1/2, 2]`. -/
def psi (x : ℝ) : ℝ := chi x * (eta x - eta (2 * x))

lemma contDiff_psi {n : ℕ∞} : ContDiff ℝ (n : ℕ∞) psi :=
  contDiff_chi.mul (contDiff_eta.sub (contDiff_eta.comp (by fun_prop)))

lemma psi_nonneg (x : ℝ) : 0 ≤ psi x := by
  rcases le_or_gt x 0 with hx | hx
  · rw [psi, chi_eq_zero (by linarith), zero_mul]
  · exact mul_nonneg (chi_nonneg x) (by linarith [eta_antitone hx.le (by linarith : x ≤ 2 * x)])

/-- The difference of the two cutoffs vanishes near the origin. -/
lemma eta_sub_eta_two_eq_zero {x : ℝ} (hx : |x| ≤ 1 / 2) : eta x - eta (2 * x) = 0 := by
  have h1 : x ^ 2 ≤ 3 := by nlinarith [abs_le.mp hx, sq_abs x, abs_nonneg x]
  have h2 : (2 * x) ^ 2 ≤ 3 := by nlinarith [abs_le.mp hx, sq_abs x, abs_nonneg x]
  rw [eta_eq_one h1, eta_eq_one h2, sub_self]

/-- On the positive axis the one-sided factor is invisible. -/
lemma psi_eq_sub {x : ℝ} (hx : 0 < x) : psi x = eta x - eta (2 * x) := by
  rcases le_or_gt x (1 / 2) with hle | hgt
  · rw [psi, eta_sub_eta_two_eq_zero (by rw [abs_le]; constructor <;> linarith), mul_zero]
  · rw [psi, chi_eq_one hgt.le, one_mul]

lemma psi_eq_zero_of_lt_half {x : ℝ} (hx : x < 1 / 2) : psi x = 0 := by
  rcases le_or_gt x (1 / 4) with hle | hgt
  · rw [psi, chi_eq_zero hle, zero_mul]
  · rw [psi, eta_sub_eta_two_eq_zero (by rw [abs_le]; constructor <;> linarith), mul_zero]

lemma psi_eq_zero_of_two_le {x : ℝ} (hx : 2 ≤ x) : psi x = 0 := by
  have h1 : (4:ℝ) ≤ x ^ 2 := by nlinarith
  have h2 : (4:ℝ) ≤ (2 * x) ^ 2 := by nlinarith
  rw [psi, eta_eq_zero h1, eta_eq_zero h2, sub_self, mul_zero]

/-- The bump is supported in `[1/2, 2]`. -/
theorem support_psi_subset : Function.support psi ⊆ Set.Icc (1 / 2 : ℝ) 2 := by
  intro x hx
  refine ⟨?_, ?_⟩
  · by_contra hcon
    exact hx (psi_eq_zero_of_lt_half (lt_of_not_ge hcon))
  · by_contra hcon
    exact hx (psi_eq_zero_of_two_le (le_of_not_ge hcon))

/-- **(4.1)**: the dyadic sums of the bump telescope to one. -/
theorem sum_psi_eq_one {k : ℕ} (hk : 1 ≤ k) {n : ℕ} (hkn : (k : ℝ) ≤ 2 ^ n) :
    ∑ s ∈ Finset.range (n + 1), psi (((2:ℝ)⁻¹) ^ s * k) = 1 := by
  set G : ℕ → ℝ := fun s ↦ eta (((2:ℝ)⁻¹) ^ s * (2 * k)) with hG
  have hkpos : (0:ℝ) < k := by exact_mod_cast hk
  have hterm : ∀ s : ℕ, psi (((2:ℝ)⁻¹) ^ s * k) = G (s + 1) - G s := by
    intro s
    have hxpos : (0:ℝ) < ((2:ℝ)⁻¹) ^ s * k := by positivity
    rw [psi_eq_sub hxpos, hG]
    congr 2
    · rw [pow_succ]
      ring
    · ring
  rw [Finset.sum_congr rfl fun s _ ↦ hterm s, Finset.sum_range_sub G]
  have hk1 : (1:ℝ) ≤ (k : ℝ) := by exact_mod_cast hk
  have hG0 : G 0 = 0 := by
    rw [hG]
    simp only [pow_zero, one_mul]
    exact eta_eq_zero (by nlinarith)
  have hGn : G (n + 1) = 1 := by
    rw [hG]
    have hpown : (0:ℝ) < 2 ^ n := by positivity
    have heq : ((2:ℝ)⁻¹) ^ (n + 1) * (2 * k) = (k : ℝ) / 2 ^ n := by
      rw [inv_pow, pow_succ]
      field_simp
    have hle : ((2:ℝ)⁻¹) ^ (n + 1) * (2 * k) ≤ 1 := by
      rw [heq, div_le_one hpown]
      exact hkn
    have hvpos : (0:ℝ) < ((2:ℝ)⁻¹) ^ (n + 1) * (2 * k) := by positivity
    exact eta_eq_one (by nlinarith [hle, hvpos])
  rw [hG0, hGn, sub_zero]

/-! ### Lemma 4.1, second half: the scale-uniform `L¹` bound

The kernel `K_s(θ) = ∑_{n ∈ ℤ} ψ(2^{-s} n) e(nθ)` is bounded in `L¹([0,1])` uniformly in the
scale `s`. Mathlib's Poisson summation formula for Schwartz functions rewrites `K_s` as the
periodization of a single Schwartz function, and the periodization of an integrable function
has `L¹([0,1])` norm equal to its `L¹(ℝ)` norm.
-/

section Kernel

open SchwartzMap FourierTransform MeasureTheory Set
open scoped ContDiff

/-- The scaled bump `x ↦ ψ(2^{-s} x)`, complex valued. -/
def psiScaledFun (s : ℕ) (x : ℝ) : ℂ := (psi (((2:ℝ)⁻¹) ^ s * x) : ℂ)

lemma contDiff_psiScaledFun (s : ℕ) : ContDiff ℝ ∞ (psiScaledFun s) := by
  have h : ContDiff ℝ ∞ fun x : ℝ ↦ psi (((2:ℝ)⁻¹) ^ s * x) :=
    contDiff_psi.comp (by fun_prop)
  exact Complex.ofRealCLM.contDiff.comp h

lemma support_psiScaledFun (s : ℕ) :
    Function.support (psiScaledFun s) ⊆ Set.Icc ((2:ℝ) ^ s / 2) (2 ^ s * 2) := by
  intro x hx
  have hpow : (0:ℝ) < (2:ℝ) ^ s := by positivity
  have hne : psi (((2:ℝ)⁻¹) ^ s * x) ≠ 0 := by
    intro hc
    exact hx (by rw [psiScaledFun, hc, Complex.ofReal_zero])
  obtain ⟨h1, h2⟩ := support_psi_subset hne
  have hinv : ((2:ℝ)⁻¹) ^ s = ((2:ℝ) ^ s)⁻¹ := by rw [inv_pow]
  rw [hinv] at h1 h2
  have hne0 : ((2:ℝ) ^ s) ≠ 0 := ne_of_gt hpow
  constructor
  · have hm := mul_le_mul_of_nonneg_left h1 hpow.le
    rw [← mul_assoc, mul_inv_cancel₀ hne0, one_mul] at hm
    linarith
  · have hm := mul_le_mul_of_nonneg_left h2 hpow.le
    rw [← mul_assoc, mul_inv_cancel₀ hne0, one_mul] at hm
    linarith

lemma hasCompactSupport_psiScaledFun (s : ℕ) : HasCompactSupport (psiScaledFun s) := by
  refine HasCompactSupport.intro
    (isCompact_Icc (a := (2:ℝ) ^ s / 2) (b := (2:ℝ) ^ s * 2)) fun x hx ↦ ?_
  by_contra hc
  exact hx (support_psiScaledFun s hc)

/-- The scaled bump as a Schwartz function. -/
def psiScaled (s : ℕ) : 𝓢(ℝ, ℂ) :=
  (hasCompactSupport_psiScaledFun s).toSchwartzMap (contDiff_psiScaledFun s)

@[simp] lemma psiScaled_apply (s : ℕ) (x : ℝ) : psiScaled s x = psiScaledFun s x := rfl

/-- The Schwartz function whose periodization is `K_s`. -/
def psiPer (s : ℕ) : 𝓢(ℝ, ℂ) := 𝓕⁻ (psiScaled s)

/-- The truncated kernel of Lemma 4.1. -/
def Kker (s : ℕ) (θ : ℝ) : ℂ := ∑' n : ℤ, (psi (((2:ℝ)⁻¹) ^ s * n) : ℂ) * eZ n θ

/-- **Poisson summation**: the kernel is the periodization of `psiPer`. -/
theorem Kker_eq_tsum_psiPer (s : ℕ) (θ : ℝ) :
    Kker s θ = ∑' n : ℤ, psiPer s (θ + n) := by
  have hP := SchwartzMap.tsum_eq_tsum_fourier (psiPer s) θ
  rw [Kker, hP]
  refine tsum_congr fun n ↦ ?_
  have hF : (𝓕 (psiPer s) : 𝓢(ℝ, ℂ)) = psiScaled s := by
    rw [psiPer, FourierTransform.fourier_fourierInv_eq]
  rw [hF]
  congr 1
  rw [eZ, e, fourier_coe_apply]
  congr 1
  push_cast
  ring

/-- **Periodization**: the `L¹([0,1])` mass of a periodization is at most the `L¹(ℝ)` mass
of the function. Stated with `lintegral`, so no integrability hypothesis is needed. -/
theorem lintegral_periodization_le {G : ℝ → ℂ} (hG : Measurable G) :
    ∫⁻ θ in Set.Ioc (0:ℝ) 1, ‖∑' n : ℤ, G (θ + n)‖ₑ ≤ ∫⁻ y, ‖G y‖ₑ := by
  have hmeas : ∀ n : ℤ, AEMeasurable (fun θ : ℝ ↦ ‖G (θ + n)‖ₑ)
      (volume.restrict (Set.Ioc (0:ℝ) 1)) :=
    fun n ↦ ((hG.comp (measurable_add_const _)).enorm).aemeasurable
  have htrans : ∀ n : ℤ, (∫⁻ θ in Set.Ioc (0:ℝ) 1, ‖G (θ + n)‖ₑ)
      = ∫⁻ y in Set.Ioc ((n : ℝ)) ((n : ℝ) + 1), ‖G y‖ₑ := by
    intro n
    have hmp : MeasureTheory.MeasurePreserving (fun θ : ℝ ↦ θ + (n : ℝ)) volume volume :=
      measurePreserving_add_right volume (n : ℝ)
    have himg : (fun θ : ℝ ↦ θ + (n : ℝ)) ⁻¹' Set.Ioc ((n : ℝ)) ((n : ℝ) + 1)
        = Set.Ioc (0:ℝ) 1 := by
      ext θ
      simp only [Set.mem_preimage, Set.mem_Ioc]
      constructor
      · rintro ⟨h1, h2⟩
        exact ⟨by linarith, by linarith⟩
      · rintro ⟨h1, h2⟩
        exact ⟨by linarith, by linarith⟩
    have hkey := hmp.setLIntegral_comp_preimage_emb
      (measurableEmbedding_addRight (n : ℝ)) (fun y ↦ ‖G y‖ₑ)
      (Set.Ioc ((n : ℝ)) ((n : ℝ) + 1))
    rw [himg] at hkey
    exact hkey
  have hdisj : Pairwise (Function.onFun Disjoint (fun n : ℤ ↦ Set.Ioc ((n : ℝ)) ((n : ℝ) + 1))) :=
    Set.pairwise_disjoint_Ioc_intCast ℝ
  calc ∫⁻ θ in Set.Ioc (0:ℝ) 1, ‖∑' n : ℤ, G (θ + n)‖ₑ
      ≤ ∫⁻ θ in Set.Ioc (0:ℝ) 1, ∑' n : ℤ, ‖G (θ + n)‖ₑ :=
        lintegral_mono fun θ ↦ enorm_tsum_le_tsum_enorm
    _ = ∑' n : ℤ, ∫⁻ θ in Set.Ioc (0:ℝ) 1, ‖G (θ + n)‖ₑ := lintegral_tsum hmeas
    _ = ∑' n : ℤ, ∫⁻ y in Set.Ioc ((n : ℝ)) ((n : ℝ) + 1), ‖G y‖ₑ := tsum_congr htrans
    _ = ∫⁻ y in ⋃ n : ℤ, Set.Ioc ((n : ℝ)) ((n : ℝ) + 1), ‖G y‖ₑ :=
        (lintegral_iUnion (fun _ ↦ measurableSet_Ioc) hdisj _).symm
    _ = ∫⁻ y, ‖G y‖ₑ := by
        rw [_root_.iUnion_Ioc_intCast ℝ, Measure.restrict_univ]

/-- **Fourier dilation.** The pinned Mathlib has no dilation lemma for the Fourier
transform, so this is derived from the defining integral by the substitution `v = a u`. -/
lemma fourierInv_dilate (Φ : ℝ → ℂ) {a : ℝ} (ha : 0 < a) (w : ℝ) :
    𝓕⁻ (fun x ↦ Φ (a⁻¹ * x)) w = a • 𝓕⁻ Φ (a * w) := by
  have hane : a ≠ 0 := ne_of_gt ha
  rw [Real.fourierInv_eq', Real.fourierInv_eq']
  have hkey := MeasureTheory.Measure.integral_comp_mul_left
    (fun v : ℝ ↦ (Complex.exp ((↑(2 * Real.pi * (inner ℝ v w : ℝ)) * Complex.I))) • Φ (a⁻¹ * v)) a
  have hsimp : ∀ x : ℝ,
      (Complex.exp ((↑(2 * Real.pi * (inner ℝ (a * x) w : ℝ)) * Complex.I))) • Φ (a⁻¹ * (a * x))
        = (Complex.exp ((↑(2 * Real.pi * (inner ℝ x (a * w) : ℝ)) * Complex.I))) • Φ x := by
    intro x
    have hax : a⁻¹ * (a * x) = x := by field_simp
    rw [hax]
    have hinner : (inner ℝ (a * x) w : ℝ) = (inner ℝ x (a * w) : ℝ) := by
      simp only [RCLike.inner_apply, starRingEnd_apply, star_trivial]
      ring
    rw [hinner]
  rw [MeasureTheory.integral_congr_ae (Filter.Eventually.of_forall hsimp)] at hkey
  rw [hkey, abs_of_pos (inv_pos.mpr ha), smul_smul, mul_inv_cancel₀ hane, one_smul]

lemma psiPer_dilate (s : ℕ) (w : ℝ) :
    psiPer s w = ((2:ℝ) ^ s) • psiPer 0 ((2:ℝ) ^ s * w) := by
  have hpow : (0:ℝ) < (2:ℝ) ^ s := by positivity
  have hfun : (fun x : ℝ ↦ psiScaledFun 0 (((2:ℝ) ^ s)⁻¹ * x)) = psiScaledFun s := by
    funext x
    rw [psiScaledFun, psiScaledFun, pow_zero, one_mul, inv_pow]
  have hcoe : ∀ t : ℕ, (⇑(psiPer t) : ℝ → ℂ) = 𝓕⁻ (psiScaledFun t) := by
    intro t
    rw [psiPer, SchwartzMap.fourierInv_coe]
    rfl
  have h := fourierInv_dilate (psiScaledFun 0) hpow w
  rw [hfun] at h
  rw [hcoe s, hcoe 0, h]

/-- **Lemma 4.1, second half**: the `L¹` mass of the periodizing function does not depend
on the scale. -/
theorem lintegral_enorm_psiPer_eq (s : ℕ) :
    ∫⁻ y, ‖psiPer s y‖ₑ = ∫⁻ y, ‖psiPer 0 y‖ₑ := by
  have hpow : (0:ℝ) < (2:ℝ) ^ s := by positivity
  have hne : ((2:ℝ) ^ s) ≠ 0 := ne_of_gt hpow
  have hmeas : Measurable fun y : ℝ ↦ ‖psiPer 0 y‖ₑ :=
    (SchwartzMap.continuous (psiPer 0)).measurable.enorm
  have hchange : (∫⁻ y, ‖psiPer 0 ((2:ℝ) ^ s * y)‖ₑ)
      = ENNReal.ofReal (((2:ℝ) ^ s)⁻¹) * ∫⁻ y, ‖psiPer 0 y‖ₑ := by
    have hmap := MeasureTheory.lintegral_map (μ := volume)
      (f := fun y : ℝ ↦ ‖psiPer 0 y‖ₑ) (g := fun y : ℝ ↦ (2:ℝ) ^ s * y)
      hmeas (measurable_const_mul _)
    rw [Real.map_volume_mul_left hne, MeasureTheory.lintegral_smul_measure] at hmap
    rw [← hmap, abs_of_pos (inv_pos.mpr hpow)]
    rfl
  calc (∫⁻ y, ‖psiPer s y‖ₑ)
      = ∫⁻ y, ENNReal.ofReal ((2:ℝ) ^ s) * ‖psiPer 0 ((2:ℝ) ^ s * y)‖ₑ := by
        refine lintegral_congr fun y ↦ ?_
        rw [psiPer_dilate s y, enorm_smul]
        congr 1
        rw [Real.enorm_eq_ofReal hpow.le]
    _ = ENNReal.ofReal ((2:ℝ) ^ s) * ∫⁻ y, ‖psiPer 0 ((2:ℝ) ^ s * y)‖ₑ :=
        lintegral_const_mul _ (hmeas.comp (measurable_const_mul _))
    _ = ENNReal.ofReal ((2:ℝ) ^ s) * (ENNReal.ofReal (((2:ℝ) ^ s)⁻¹) * ∫⁻ y, ‖psiPer 0 y‖ₑ) := by
        rw [hchange]
    _ = ∫⁻ y, ‖psiPer 0 y‖ₑ := by
        rw [← mul_assoc, ← ENNReal.ofReal_mul hpow.le, mul_inv_cancel₀ hne,
          ENNReal.ofReal_one, one_mul]

/-- **Lemma 4.1**: the kernel has `L¹([0,1])` norm bounded independently of the scale. -/
theorem lintegral_enorm_Kker_le (s : ℕ) :
    ∫⁻ θ in Set.Ioc (0:ℝ) 1, ‖Kker s θ‖ₑ ≤ ∫⁻ y, ‖psiPer 0 y‖ₑ := by
  have hcongr : ∀ θ : ℝ, ‖Kker s θ‖ₑ = ‖∑' n : ℤ, psiPer s (θ + n)‖ₑ := by
    intro θ
    rw [Kker_eq_tsum_psiPer]
  rw [lintegral_congr hcongr, ← lintegral_enorm_psiPer_eq s]
  exact lintegral_periodization_le (SchwartzMap.continuous (psiPer s)).measurable

/-! ### The kernel is a finite trigonometric sum

Because `ψ` is supported in `[1/2, 2]`, only the frequencies `n` with
`2^{s-1} ≤ n ≤ 2^{s+1}` contribute to `K_s`. The sum defining `K_s` is therefore finite, and
the orthogonality computation behind (4.2) needs no convergence theory.
-/

lemma psiCoeff_eq_zero_of_notMem (s : ℕ) {n : ℤ}
    (hn : n ∉ Set.Icc (⌊(2 : ℝ) ^ s / 2⌋) (⌈(2 : ℝ) ^ s * 2⌉)) :
    psi (((2:ℝ)⁻¹) ^ s * n) = 0 := by
  have hpow : (0:ℝ) < (2:ℝ) ^ s := by positivity
  have hne : ((2:ℝ) ^ s) ≠ 0 := ne_of_gt hpow
  by_contra hc
  obtain ⟨h1, h2⟩ := support_psi_subset hc
  rw [inv_pow] at h1 h2
  refine hn (Set.mem_Icc.mpr ⟨?_, ?_⟩)
  · have hm := mul_le_mul_of_nonneg_left h1 hpow.le
    rw [← mul_assoc, mul_inv_cancel₀ hne, one_mul] at hm
    have hle : ((2:ℝ) ^ s / 2) ≤ ((n : ℤ) : ℝ) := by linarith
    calc ⌊(2:ℝ) ^ s / 2⌋ ≤ ⌊((n : ℤ) : ℝ)⌋ := Int.floor_le_floor hle
      _ = n := Int.floor_intCast n
  · have hm := mul_le_mul_of_nonneg_left h2 hpow.le
    rw [← mul_assoc, mul_inv_cancel₀ hne, one_mul] at hm
    have hle : ((n : ℤ) : ℝ) ≤ (2:ℝ) ^ s * 2 := by linarith
    calc n = ⌈((n : ℤ) : ℝ)⌉ := (Int.ceil_intCast n).symm
      _ ≤ ⌈(2:ℝ) ^ s * 2⌉ := Int.ceil_le_ceil hle

/-- The kernel as a finite sum over the contributing frequencies. -/
lemma Kker_eq_finsum (s : ℕ) (θ : ℝ) :
    Kker s θ = ∑ n ∈ Finset.Icc (⌊(2:ℝ) ^ s / 2⌋) (⌈(2:ℝ) ^ s * 2⌉),
      (psi (((2:ℝ)⁻¹) ^ s * n) : ℂ) * eZ n θ := by
  rw [Kker]
  refine tsum_eq_sum fun n hn ↦ ?_
  rw [psiCoeff_eq_zero_of_notMem s (by simpa using hn), Complex.ofReal_zero, zero_mul]

/-- **Orthogonality of the kernel**: `∫₀¹ K_s(θ) e(mθ) dθ = ψ(2^{-s}(-m))`. -/
theorem integral_Kker_mul_eZ (s : ℕ) (m : ℤ) :
    (∫ θ in (0:ℝ)..1, Kker s θ * eZ m θ) = (psi (((2:ℝ)⁻¹) ^ s * (-m : ℤ)) : ℂ) := by
  have hexp : ∀ θ : ℝ, Kker s θ * eZ m θ
      = ∑ n ∈ Finset.Icc (⌊(2:ℝ) ^ s / 2⌋) (⌈(2:ℝ) ^ s * 2⌉),
          (psi (((2:ℝ)⁻¹) ^ s * n) : ℂ) * eZ (n + m) θ := by
    intro θ
    rw [Kker_eq_finsum, Finset.sum_mul]
    refine Finset.sum_congr rfl fun n _ ↦ ?_
    rw [mul_assoc, eZ_add]
  rw [intervalIntegral.integral_congr (fun θ _ ↦ hexp θ),
    intervalIntegral.integral_finsetSum
      (f := fun (n : ℤ) (θ : ℝ) ↦ (psi (((2:ℝ)⁻¹) ^ s * n) : ℂ) * eZ (n + m) θ)
      (fun n _ ↦ (intervalIntegrable_eZ (n + m) 0 1).const_mul _)]
  have hterm : ∀ n ∈ Finset.Icc (⌊(2:ℝ) ^ s / 2⌋) (⌈(2:ℝ) ^ s * 2⌉),
      (∫ θ in (0:ℝ)..1, (psi (((2:ℝ)⁻¹) ^ s * n) : ℂ) * eZ (n + m) θ)
        = if n = -m then (psi (((2:ℝ)⁻¹) ^ s * (-m : ℤ)) : ℂ) else 0 := by
    intro n _
    rw [intervalIntegral.integral_const_mul, integral_eZ]
    by_cases h : n = -m
    · subst h
      rw [if_pos (by omega), if_pos rfl, mul_one]
    · rw [if_neg (by omega), if_neg h, mul_zero]
  rw [Finset.sum_congr rfl hterm]
  by_cases hmem : (-m) ∈ Finset.Icc (⌊(2:ℝ) ^ s / 2⌋) (⌈(2:ℝ) ^ s * 2⌉)
  · rw [Finset.sum_ite_eq' (Finset.Icc (⌊(2:ℝ) ^ s / 2⌋) (⌈(2:ℝ) ^ s * 2⌉)) (-m)
      (fun _ ↦ (psi (((2:ℝ)⁻¹) ^ s * (-m : ℤ)) : ℂ)), if_pos hmem]
  · rw [Finset.sum_eq_zero fun n hn ↦ if_neg (by rintro rfl; exact hmem hn),
      psiCoeff_eq_zero_of_notMem s (by simpa using hmem), Complex.ofReal_zero]

lemma continuous_Kker (s : ℕ) : Continuous (Kker s) := by
  have hfun : Kker s = fun θ ↦ ∑ n ∈ Finset.Icc (⌊(2:ℝ) ^ s / 2⌋) (⌈(2:ℝ) ^ s * 2⌉),
      (psi (((2:ℝ)⁻¹) ^ s * n) : ℂ) * eZ n θ := funext (Kker_eq_finsum s)
  rw [hfun]
  exact continuous_finsetSum _ fun n _ ↦ continuous_const.mul (continuous_eZ n)

/-! ### Identity (4.2) -/

section Identity42

open scoped ComplexConjugate

variable {α : Type*} [MeasurableSpace α]

/-- `U_s = ∑_{i<j} ψ((j-i)/2^s) f_i \overline{f_j}`. The restriction to `i < j` is automatic:
`ψ` vanishes on the negative axis, so the terms with `j ≤ i` drop out by themselves. -/
def bigU {M : ℕ} (f : Fin M → α → ℂ) (s : ℕ) (x : α) : ℂ :=
  ∑ i : Fin M, ∑ j : Fin M,
    (psi (((2:ℝ)⁻¹) ^ s * ((j : ℤ) - (i : ℤ))) : ℂ) * (f i x * conj (f j x))

/-- The sign weight collapses against the one-sided bump. -/
lemma neg_sign_mul_psi {s : ℕ} (i j : ℤ) :
    -((((i - j).sign : ℝ)) : ℂ) * ((psi (((2:ℝ)⁻¹) ^ s * ((j : ℝ) - (i : ℝ))) : ℝ) : ℂ)
      = ((psi (((2:ℝ)⁻¹) ^ s * ((j : ℝ) - (i : ℝ))) : ℝ) : ℂ) := by
  have hpow : (0:ℝ) < ((2:ℝ)⁻¹) ^ s := by positivity
  rcases lt_trichotomy i j with h | h | h
  · rw [Int.sign_eq_neg_one_of_neg (by omega)]
    push_cast
    ring
  · subst h
    have hz : psi (((2:ℝ)⁻¹) ^ s * ((i : ℝ) - (i : ℝ))) = 0 := by
      refine psi_eq_zero_of_lt_half ?_
      rw [sub_self, mul_zero]
      norm_num
    rw [hz]
    simp
  · have hz : psi (((2:ℝ)⁻¹) ^ s * ((j : ℝ) - (i : ℝ))) = 0 := by
      refine psi_eq_zero_of_lt_half ?_
      have hlt : (j : ℝ) - (i : ℝ) < 0 := by
        have : (j : ℝ) < (i : ℝ) := by exact_mod_cast h
        linarith
      nlinarith [hpow]
    rw [hz]
    simp

omit [MeasurableSpace α] in
/-- **Identity (4.2)**: `U_s = ∫₀¹ K_s(θ) i V(θ) dθ`. -/
theorem bigU_eq_integral {M : ℕ} (f : Fin M → α → ℂ) (s : ℕ) (x : α) :
    bigU f s x
      = ∫ θ in (0:ℝ)..1, Kker s θ * (Complex.I * ((bigVphase f θ x : ℝ) : ℂ)) := by
  have hcont : ∀ i j : Fin M, Continuous fun θ : ℝ ↦
      Kker s θ * (-(((((i : ℤ) - (j : ℤ)).sign : ℝ)) : ℂ) *
        (eZ ((i : ℤ) - (j : ℤ)) θ * (f i x * conj (f j x)))) :=
    fun i j ↦ (continuous_Kker s).mul
      (continuous_const.mul ((continuous_eZ _).mul continuous_const))
  have hexp : ∀ θ : ℝ, Kker s θ * (Complex.I * ((bigVphase f θ x : ℝ) : ℂ))
      = ∑ i : Fin M, ∑ j : Fin M, Kker s θ *
          (-(((((i : ℤ) - (j : ℤ)).sign : ℝ)) : ℂ) *
            (eZ ((i : ℤ) - (j : ℤ)) θ * (f i x * conj (f j x)))) := by
    intro θ
    rw [I_mul_bigVphase_eq, ← Finset.sum_neg_distrib, Finset.mul_sum]
    refine Finset.sum_congr rfl fun i _ ↦ ?_
    rw [← Finset.sum_neg_distrib, Finset.mul_sum]
    exact Finset.sum_congr rfl fun j _ ↦ by ring
  rw [intervalIntegral.integral_congr (fun θ _ ↦ hexp θ),
    intervalIntegral.integral_finsetSum (s := (Finset.univ : Finset (Fin M)))
      (f := fun (i : Fin M) (θ : ℝ) ↦ ∑ j : Fin M, Kker s θ *
        (-(((((i : ℤ) - (j : ℤ)).sign : ℝ)) : ℂ) *
          (eZ ((i : ℤ) - (j : ℤ)) θ * (f i x * conj (f j x)))))
      (fun i _ ↦ (continuous_finsetSum _ fun j _ ↦ hcont i j).intervalIntegrable _ _)]
  rw [bigU]
  refine Finset.sum_congr rfl fun i _ ↦ ?_
  rw [intervalIntegral.integral_finsetSum (s := (Finset.univ : Finset (Fin M)))
    (f := fun (j : Fin M) (θ : ℝ) ↦ Kker s θ *
      (-(((((i : ℤ) - (j : ℤ)).sign : ℝ)) : ℂ) *
        (eZ ((i : ℤ) - (j : ℤ)) θ * (f i x * conj (f j x)))))
    (fun j _ ↦ (hcont i j).intervalIntegrable _ _)]
  refine Finset.sum_congr rfl fun j _ ↦ ?_
  have hpull : ∀ θ : ℝ, Kker s θ *
      (-(((((i : ℤ) - (j : ℤ)).sign : ℝ)) : ℂ) *
        (eZ ((i : ℤ) - (j : ℤ)) θ * (f i x * conj (f j x))))
      = ((-(((((i : ℤ) - (j : ℤ)).sign : ℝ)) : ℂ)) * (f i x * conj (f j x))) *
          (Kker s θ * eZ ((i : ℤ) - (j : ℤ)) θ) := fun θ ↦ by ring
  rw [intervalIntegral.integral_congr (fun θ _ ↦ hpull θ),
    intervalIntegral.integral_const_mul, integral_Kker_mul_eZ]
  push_cast
  rw [neg_sub]
  have hpow : (0:ℝ) < ((2:ℝ)⁻¹) ^ s := by positivity
  rcases lt_trichotomy (i : ℕ) (j : ℕ) with h | h | h
  · rw [Int.sign_eq_neg_one_of_neg (by omega)]
    push_cast
    ring
  · have hz : psi (((2:ℝ)⁻¹) ^ s * (((j : ℕ) : ℝ) - ((i : ℕ) : ℝ))) = 0 := by
      refine psi_eq_zero_of_lt_half ?_
      have : ((j : ℕ) : ℝ) - ((i : ℕ) : ℝ) = 0 := by
        rw [h]
        ring
      rw [this, mul_zero]
      norm_num
    rw [hz]
    simp
  · have hz : psi (((2:ℝ)⁻¹) ^ s * (((j : ℕ) : ℝ) - ((i : ℕ) : ℝ))) = 0 := by
      refine psi_eq_zero_of_lt_half ?_
      have hlt : ((j : ℕ) : ℝ) - ((i : ℕ) : ℝ) < 0 := by
        have : ((j : ℕ) : ℝ) < ((i : ℕ) : ℝ) := by exact_mod_cast h
        linarith
      nlinarith [hpow]
    rw [hz]
    simp

/-! ### Integrability of the `U_s` data -/

section Integrability

variable {M : ℕ} {μ : MeasureTheory.Measure α} {f : Fin M → α → ℂ}

omit [MeasurableSpace α] in
/-- The conjugate of `U_s`, expanded. -/
lemma conj_bigU_eq (f : Fin M → α → ℂ) (s : ℕ) (x : α) :
    conj (bigU f s x)
      = ∑ a : Fin M, ∑ b : Fin M,
          (psi (((2:ℝ)⁻¹) ^ s * ((b : ℤ) - (a : ℤ))) : ℂ) * (conj (f a x) * f b x) := by
  rw [bigU, map_sum]
  refine Finset.sum_congr rfl fun a _ ↦ ?_
  rw [map_sum]
  refine Finset.sum_congr rfl fun b _ ↦ ?_
  rw [map_mul, map_mul, Complex.conj_conj, Complex.conj_ofReal]

lemma integrable_conj_bigU_mul (hf : ∀ n, MeasureTheory.MemLp (f n) 4 μ) (s : ℕ)
    (i j : Fin M) :
    MeasureTheory.Integrable
      (fun x ↦ conj (bigU f s x) * (f i x * conj (f j x))) μ := by
  have hx : ∀ x : α, conj (bigU f s x) * (f i x * conj (f j x))
      = ∑ a : Fin M, ∑ b : Fin M,
          (psi (((2:ℝ)⁻¹) ^ s * ((b : ℤ) - (a : ℤ))) : ℂ) *
            ((f b x * f i x) * conj (f a x * f j x)) := by
    intro x
    rw [conj_bigU_eq, Finset.sum_mul]
    refine Finset.sum_congr rfl fun a _ ↦ ?_
    rw [Finset.sum_mul]
    refine Finset.sum_congr rfl fun b _ ↦ ?_
    rw [map_mul]
    ring
  rw [funext hx]
  exact MeasureTheory.integrable_finsetSum _ fun a _ ↦
    MeasureTheory.integrable_finsetSum _ fun b _ ↦
      (integrable_quadruple hf b i a j).const_mul _

lemma integrable_conj_bigU_mul_bigU (hf : ∀ n, MeasureTheory.MemLp (f n) 4 μ) (s : ℕ) :
    MeasureTheory.Integrable (fun x ↦ conj (bigU f s x) * bigU f s x) μ := by
  have hx : ∀ x : α, conj (bigU f s x) * bigU f s x
      = ∑ i : Fin M, ∑ j : Fin M,
          (psi (((2:ℝ)⁻¹) ^ s * ((j : ℤ) - (i : ℤ))) : ℂ) *
            (conj (bigU f s x) * (f i x * conj (f j x))) := by
    intro x
    rw [bigU, Finset.mul_sum]
    refine Finset.sum_congr rfl fun i _ ↦ ?_
    rw [Finset.mul_sum]
    exact Finset.sum_congr rfl fun j _ ↦ by ring
  rw [funext hx]
  exact MeasureTheory.integrable_finsetSum _ fun i _ ↦
    MeasureTheory.integrable_finsetSum _ fun j _ ↦
      (integrable_conj_bigU_mul hf s i j).const_mul _

lemma integrable_normSq_bigU (hf : ∀ n, MeasureTheory.MemLp (f n) 4 μ) (s : ℕ) :
    MeasureTheory.Integrable (fun x ↦ ‖bigU f s x‖ ^ 2) μ := by
  have h := (integrable_conj_bigU_mul_bigU hf s).re
  refine h.congr (MeasureTheory.ae_of_all _ fun x ↦ ?_)
  simp only []
  rw [mul_comm, Complex.mul_conj]
  simp [Complex.normSq_eq_norm_sq, -Complex.ofReal_pow]

end Integrability

end Identity42

/-! ### The kernel constant as a real number -/

/-- The absolute constant of Lemma 4.1: `‖𝓕⁻ψ‖_{L¹(ℝ)}`. -/
def psiL1 : ℝ := (∫⁻ y, ‖psiPer 0 y‖ₑ).toReal

/-- `A_s = ∫₀¹ |K_s(θ)| dθ`. -/
def KkerL1 (s : ℕ) : ℝ := ∫ θ in (0:ℝ)..1, ‖Kker s θ‖

lemma lintegral_enorm_psiPer_lt_top : (∫⁻ y, ‖psiPer 0 y‖ₑ) < ⊤ :=
  (SchwartzMap.integrable (psiPer 0)).hasFiniteIntegral

lemma psiL1_nonneg : 0 ≤ psiL1 := ENNReal.toReal_nonneg

lemma KkerL1_nonneg (s : ℕ) : 0 ≤ KkerL1 s :=
  intervalIntegral.integral_nonneg (by norm_num) fun θ _ ↦ norm_nonneg _

/-- **Lemma 4.1, real form**: the kernel constant is bounded by an absolute constant. -/
theorem KkerL1_le (s : ℕ) : KkerL1 s ≤ psiL1 := by
  have hint : IntervalIntegrable (fun θ : ℝ ↦ ‖Kker s θ‖) volume 0 1 :=
    ((continuous_Kker s).norm).intervalIntegrable _ _
  have hEq : KkerL1 s = (∫⁻ θ in Set.Ioc (0:ℝ) 1, ‖Kker s θ‖ₑ).toReal := by
    rw [KkerL1, intervalIntegral.integral_of_le (by norm_num : (0:ℝ) ≤ 1)]
    rw [MeasureTheory.integral_eq_lintegral_of_nonneg_ae
      (Filter.Eventually.of_forall fun θ ↦ norm_nonneg _)
      (((continuous_Kker s).norm).aestronglyMeasurable)]
    congr 1
    refine lintegral_congr fun θ ↦ ?_
    rw [← ofReal_norm]
  rw [hEq, psiL1]
  exact ENNReal.toReal_mono (ne_of_lt lintegral_enorm_psiPer_lt_top)
    (lintegral_enorm_Kker_le s)

end Kernel

/-! ### Lemma 4.2

`U_s` pairs against itself through the kernel `K_s` of (4.2). Cauchy-Schwarz in `x` and the
uniform bound `‖V(θ)‖₂ ≤ 2‖S‖₄²` of Corollary 2.3 then give `‖U_s‖₂ ≤ 2 A_s ‖S‖₄²`, and
`A_s ≤ ‖𝓕⁻ψ‖_{L¹}` by Lemma 4.1. The bound is uniform in the scale `s`.
-/

section Lemma42

open scoped ComplexConjugate

variable {α : Type*} [MeasurableSpace α]

lemma aestronglyMeasurable_bigU {M : ℕ} {μ : MeasureTheory.Measure α} {f : Fin M → α → ℂ}
    (hf : ∀ n, MeasureTheory.MemLp (f n) 4 μ) (s : ℕ) :
    MeasureTheory.AEStronglyMeasurable (fun x ↦ bigU f s x) μ :=
  aestronglyMeasurable_finsetSum _ fun i _ ↦
    aestronglyMeasurable_finsetSum _ fun j _ ↦
      (((hf i).aestronglyMeasurable).mul ((hf j).aestronglyMeasurable).star).const_mul _

/-- **Lemma 4.2**: `‖U_s‖₂ ≤ 2 ‖𝓕⁻ψ‖_{L¹(ℝ)} ‖S‖₄²`, with a constant independent of the
scale `s` and of the number of caps. -/
theorem nrm2_bigU_le {M : ℕ} {μ : MeasureTheory.Measure α} {f : Fin M → α → ℂ}
    (hf : OrderedSuperorthogonal μ f) (h29 : ExtraCancellation μ f) (s : ℕ) :
    nrm2 μ (fun x ↦ ‖bigU f s x‖) ≤ 2 * psiL1 * nrmS μ f ^ 2 := by
  set P : ℝ := nrm2 μ (fun x ↦ ‖bigU f s x‖) with hP
  have hPnn : 0 ≤ P := nrm2_nonneg _ _
  have hBnn : (0:ℝ) ≤ 2 * nrmS μ f ^ 2 := by positivity
  have hmeasU := aestronglyMeasurable_bigU hf.memLp s
  have hsqU : MeasureTheory.Integrable (fun x ↦ ‖bigU f s x‖ ^ 2) μ :=
    integrable_normSq_bigU hf.memLp s
  -- the uniform `L²` bound on `V(θ)`, with no logarithmic loss
  have hV : ∀ θ : ℝ, nrm2 μ (fun x ↦ |bigVphase f θ x|) ≤ 2 * nrmS μ f ^ 2 := by
    intro θ
    refine nrm2_le_of_sq_le hBnn ?_
    have h := integral_sq_bigVphase_le_of_extra hf h29 θ
    have heq : (∫ x, |bigVphase f θ x| ^ 2 ∂μ) = ∫ x, bigVphase f θ x ^ 2 ∂μ :=
      MeasureTheory.integral_congr_ae (Filter.Eventually.of_forall fun x ↦ sq_abs _)
    rw [heq]
    calc (∫ x, bigVphase f θ x ^ 2 ∂μ) ≤ 4 * pow4S μ f := h
      _ = (2 * nrmS μ f ^ 2) ^ 2 := by rw [← nrmS_pow_four]; ring
  -- Cauchy-Schwarz in `x`
  have hJ : ∀ θ : ℝ,
      ‖∫ x, conj (bigU f s x) * (Complex.I * ((bigVphase f θ x : ℝ) : ℂ)) ∂μ‖
        ≤ P * (2 * nrmS μ f ^ 2) := by
    intro θ
    have hmemθ := (orderedSuperorthogonal_phaseFamily hf θ).memLp
    have hsqV : MeasureTheory.Integrable (fun x ↦ |bigVphase f θ x| ^ 2) μ := by
      refine (integrable_sq_bigV hmemθ).congr (MeasureTheory.ae_of_all _ fun x ↦ ?_)
      simp only [bigVphase]
      rw [sq_abs]
    have hmeasV : MeasureTheory.AEStronglyMeasurable
        (fun x ↦ |bigVphase f θ x|) μ := by
      refine ((aestronglyMeasurable_bigV hmemθ).norm).congr
        (MeasureTheory.ae_of_all _ fun x ↦ ?_)
      simp only [bigVphase, Real.norm_eq_abs]
    have hprod : MeasureTheory.Integrable
        (fun x ↦ ‖bigU f s x‖ * |bigVphase f θ x|) μ :=
      integrable_mul_of_sq hsqU hsqV (hmeasU.norm.mul hmeasV)
    have h1 : ‖∫ x, conj (bigU f s x) * (Complex.I * ((bigVphase f θ x : ℝ) : ℂ)) ∂μ‖
        ≤ ∫ x, ‖bigU f s x‖ * |bigVphase f θ x| ∂μ := by
      refine (MeasureTheory.norm_integral_le_integral_norm _).trans_eq ?_
      refine MeasureTheory.integral_congr_ae (MeasureTheory.ae_of_all _ fun x ↦ ?_)
      simp only []
      rw [norm_mul, norm_mul, RCLike.norm_conj, Complex.norm_I, one_mul,
        Complex.norm_real, Real.norm_eq_abs]
    refine h1.trans ((integral_mul_le_nrm2 hsqU hsqV hprod).trans ?_)
    exact mul_le_mul_of_nonneg_left (hV θ) hPnn
  -- pair `U_s` against itself through the kernel
  have hAnn : (0:ℝ) ≤ ∫ x, ‖bigU f s x‖ ^ 2 ∂μ :=
    MeasureTheory.integral_nonneg fun x ↦ by positivity
  have hAc : (∫ x, conj (bigU f s x) * bigU f s x ∂μ)
      = (((∫ x, ‖bigU f s x‖ ^ 2 ∂μ : ℝ)) : ℂ) := by
    have hx : ∀ x : α, conj (bigU f s x) * bigU f s x
        = ((‖bigU f s x‖ ^ 2 : ℝ) : ℂ) := by
      intro x
      rw [mul_comm, Complex.mul_conj]
      simp [Complex.normSq_eq_norm_sq]
    rw [MeasureTheory.integral_congr_ae (MeasureTheory.ae_of_all _ hx)]
    exact integral_complex_ofReal
  have hswap : (∫ x, conj (bigU f s x) * bigU f s x ∂μ)
      = ∫ θ in (0:ℝ)..1, Kker s θ *
          ∫ x, conj (bigU f s x) * (Complex.I * ((bigVphase f θ x : ℝ) : ℂ)) ∂μ := by
    have hx : ∀ x : α, conj (bigU f s x) * bigU f s x
        = conj (bigU f s x) * (∫ θ in (0:ℝ)..1, Kker s θ *
            (Complex.I * ((bigVphase f θ x : ℝ) : ℂ))) := by
      intro x
      rw [← bigU_eq_integral]
    rw [MeasureTheory.integral_congr_ae (MeasureTheory.ae_of_all _ hx)]
    exact swap_weight_bigVphase (fun x ↦ conj (bigU f s x)) (Kker s) (continuous_Kker s)
      (integrable_conj_bigU_mul hf.memLp s)
  have hi1 : IntervalIntegrable (fun θ : ℝ ↦ Kker s θ *
      ∫ x, conj (bigU f s x) * (Complex.I * ((bigVphase f θ x : ℝ) : ℂ)) ∂μ)
      MeasureTheory.volume 0 1 :=
    (continuous_weight_kernel_pairing (fun x ↦ conj (bigU f s x)) (Kker s)
      (continuous_Kker s) (integrable_conj_bigU_mul hf.memLp s)).intervalIntegrable _ _
  have hi2 : IntervalIntegrable
      (fun θ : ℝ ↦ ‖Kker s θ‖ * (P * (2 * nrmS μ f ^ 2)))
      MeasureTheory.volume 0 1 :=
    (((continuous_Kker s).norm).mul continuous_const).intervalIntegrable _ _
  have hchain : (∫ x, ‖bigU f s x‖ ^ 2 ∂μ)
      ≤ KkerL1 s * (P * (2 * nrmS μ f ^ 2)) := by
    have hnorm : ‖(((∫ x, ‖bigU f s x‖ ^ 2 ∂μ : ℝ)) : ℂ)‖ = ∫ x, ‖bigU f s x‖ ^ 2 ∂μ := by
      rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hAnn]
    calc (∫ x, ‖bigU f s x‖ ^ 2 ∂μ)
        = ‖(((∫ x, ‖bigU f s x‖ ^ 2 ∂μ : ℝ)) : ℂ)‖ := hnorm.symm
      _ = ‖∫ θ in (0:ℝ)..1, Kker s θ *
            ∫ x, conj (bigU f s x) *
              (Complex.I * ((bigVphase f θ x : ℝ) : ℂ)) ∂μ‖ := by rw [← hAc, hswap]
      _ ≤ ∫ θ in (0:ℝ)..1, ‖Kker s θ *
            ∫ x, conj (bigU f s x) *
              (Complex.I * ((bigVphase f θ x : ℝ) : ℂ)) ∂μ‖ :=
          intervalIntegral.norm_integral_le_integral_norm (by norm_num)
      _ ≤ ∫ θ in (0:ℝ)..1, ‖Kker s θ‖ * (P * (2 * nrmS μ f ^ 2)) := by
          refine intervalIntegral.integral_mono_on (by norm_num) hi1.norm hi2 ?_
          intro θ _
          rw [norm_mul]
          exact mul_le_mul_of_nonneg_left (hJ θ) (norm_nonneg _)
      _ = KkerL1 s * (P * (2 * nrmS μ f ^ 2)) := by
          rw [intervalIntegral.integral_mul_const, ← KkerL1]
  rw [← nrm2_sq μ (fun x ↦ ‖bigU f s x‖), ← hP] at hchain
  have hfinal : P ^ 2 ≤ psiL1 * (P * (2 * nrmS μ f ^ 2)) :=
    hchain.trans (mul_le_mul_of_nonneg_right (KkerL1_le s) (by positivity))
  rcases eq_or_lt_of_le hPnn with hp | hp
  · rw [← hp]
    nlinarith [psiL1_nonneg, sq_nonneg (nrmS μ f)]
  · nlinarith [hfinal, hp]

end Lemma42

/-! ### Section 4.3: orthogonality between dyadic scales

`ψ` restricts the pair `(i,j)` contributing to `U_s` to `2^{s-1} ≤ j - i ≤ 2^{s+1}`. For an
arithmetic progression of cap centers with gap `11w`, (3.8) then puts the Fourier support of
every contributing product `f_i \overline{f_j}` in the band `E_s` of Lemma 3.3. Bands four
scales apart are disjoint, so `U_s` and `U_{s'}` pair to zero whenever `|s - s'| ≥ 4`.
-/

section Scales

open SchwartzMap FourierTransform MeasureTheory
open scoped Pointwise SchwartzMap ComplexConjugate

/-- Disjoint difference sets give disjoint crossed sum sets. The special case with `A = C`
is `disjoint_add_of_disjoint_sub`. -/
lemma disjoint_add_of_disjoint_sub' {V : Type*} [AddCommGroup V] {A B C D : Set V}
    (h : Disjoint (A - B) (C - D)) : Disjoint (A + D) (C + B) := by
  rw [Set.disjoint_left]
  intro x hx hy
  obtain ⟨a, ha, d, hd, hx'⟩ := Set.mem_add.mp hx
  obtain ⟨c, hc, b, hb, hy'⟩ := Set.mem_add.mp hy
  have h2 : a + d = c + b := hx'.trans hy'.symm
  have hkey : c - d = a - b := by
    have hz : a - b - (c - d) = (a + d) - (c + b) := by abel
    have hzero : a - b - (c - d) = 0 := by rw [hz, h2, sub_self]
    exact (sub_eq_zero.mp hzero).symm
  exact Set.disjoint_left.mp h (Set.mem_sub.mpr ⟨a, ha, b, hb, rfl⟩)
    (Set.mem_sub.mpr ⟨c, hc, d, hd, hkey⟩)

/-- A pair selected by `ψ` at scale `s` has its cap difference set inside the band `E_s`. -/
theorem sub_capSector_subset_Eband_of_psi {M : ℕ} {w : ℝ} (hw : 0 < w) {c : Fin M → ℝ}
    (hc : ∀ i j : Fin M, c j - c i = 11 * w * (((j : ℤ) - (i : ℤ) : ℤ) : ℝ))
    {s : ℕ} {i j : Fin M}
    (hpsi : psi (((2:ℝ)⁻¹) ^ s * (((j : ℤ) - (i : ℤ) : ℤ) : ℝ)) ≠ 0) :
    capSector w (capInterval w (c i)) - capSector w (capInterval w (c j))
      ⊆ Eband (11 * w) s := by
  set m : ℤ := (j : ℤ) - (i : ℤ) with hm
  obtain ⟨h1, h2⟩ := support_psi_subset hpsi
  have hpow : (0:ℝ) < (2:ℝ) ^ s := by positivity
  rw [inv_pow] at h1 h2
  have hA : (2:ℝ) ^ s / 2 ≤ (m : ℝ) := by
    have h := mul_le_mul_of_nonneg_left h1 hpow.le
    rw [← mul_assoc, mul_inv_cancel₀ (ne_of_gt hpow), one_mul] at h
    linarith
  have hB : (m : ℝ) ≤ 2 * 2 ^ s := by
    have h := mul_le_mul_of_nonneg_left h2 hpow.le
    rw [← mul_assoc, mul_inv_cancel₀ (ne_of_gt hpow), one_mul] at h
    linarith
  have hone : (1:ℝ) ≤ (m : ℝ) := by
    have hp1 : (1:ℝ) ≤ 2 ^ s := one_le_pow₀ (by norm_num)
    have hz : (0:ℤ) < m := by
      have : (0:ℝ) < (m : ℝ) := by linarith
      exact_mod_cast this
    exact_mod_cast hz
  refine sub_capSector_subset_Eband hw (d := 11 * w * (m : ℝ)) (by nlinarith) ?_ ?_ ?_
  · nlinarith
  · nlinarith
  · have hji := hc i j
    have hval : c i - c j = -(11 * w * (m : ℝ)) := by
      rw [← hm] at hji
      linarith
    rw [hval, abs_neg, abs_of_nonneg (by nlinarith)]

/-- **Scale orthogonality**: `U_s` and `U_{s'}` pair to zero when `s + 4 ≤ s'`. -/
theorem integral_bigU_mul_conj_bigU_eq_zero {M : ℕ} {w : ℝ} (hw : 0 < w) {c : Fin M → ℝ}
    (hc : ∀ i j : Fin M, c j - c i = 11 * w * (((j : ℤ) - (i : ℤ) : ℤ) : ℝ))
    (f : Fin M → 𝓢(EuclideanSpace ℝ (Fin 3), ℂ))
    (hsupp : ∀ n, Function.support
      (fun ξ : EuclideanSpace ℝ (Fin 3) ↦ (FourierTransform.fourier (f n)) ξ)
      ⊆ capSector w (capInterval w (c n)))
    {s s' : ℕ} (hss : s + 4 ≤ s') :
    ∫ x, bigU (fun n x ↦ f n x) s x * conj (bigU (fun n x ↦ f n x) s' x)
        ∂(volume : Measure (EuclideanSpace ℝ (Fin 3))) = 0 := by
  have hmem : ∀ n : Fin M, MemLp (fun x ↦ f n x) 4
      (volume : Measure (EuclideanSpace ℝ (Fin 3))) := fun n ↦ (f n).memLp 4 _
  have hD : (0:ℝ) < 11 * w := by linarith
  -- the term of the quadruple expansion
  set T : Fin M → Fin M → Fin M → Fin M → EuclideanSpace ℝ (Fin 3) → ℂ :=
    fun i j k l x ↦
      ((psi (((2:ℝ)⁻¹) ^ s * (((j : ℤ) - (i : ℤ) : ℤ) : ℝ)) : ℂ) *
        (psi (((2:ℝ)⁻¹) ^ s' * (((l : ℤ) - (k : ℤ) : ℤ) : ℝ)) : ℂ)) *
          ((f i x * f l x) * conj (f k x * f j x)) with hT
  have hint : ∀ i j k l : Fin M, Integrable (fun x ↦ T i j k l x)
      (volume : Measure (EuclideanSpace ℝ (Fin 3))) := by
    intro i j k l
    exact (integrable_quadruple hmem i l k j).const_mul _
  have hterm : ∀ i j k l : Fin M,
      (∫ x, T i j k l x ∂(volume : Measure (EuclideanSpace ℝ (Fin 3)))) = 0 := by
    intro i j k l
    by_cases h1 : psi (((2:ℝ)⁻¹) ^ s * (((j : ℤ) - (i : ℤ) : ℤ) : ℝ)) = 0
    · simp only [hT, h1]
      simp
    by_cases h2 : psi (((2:ℝ)⁻¹) ^ s' * (((l : ℤ) - (k : ℤ) : ℤ) : ℝ)) = 0
    · simp only [hT, h2]
      simp
    have hb1 := sub_capSector_subset_Eband_of_psi hw hc h1
    have hb2 := sub_capSector_subset_Eband_of_psi hw hc h2
    have hdsub : Disjoint
        (capSector w (capInterval w (c i)) - capSector w (capInterval w (c j)))
        (capSector w (capInterval w (c k)) - capSector w (capInterval w (c l))) :=
      Set.disjoint_of_subset hb1 hb2 (disjoint_Eband hD hss)
    have hdisj : Disjoint
        (capSector w (capInterval w (c i)) + capSector w (capInterval w (c l)))
        (capSector w (capInterval w (c k)) + capSector w (capInterval w (c j))) :=
      disjoint_add_of_disjoint_sub' hdsub
    have hzero := integral_prod_mul_conj_prod_eq_zero (f i) (f l) (f k) (f j)
      (hsupp i) (hsupp l) (hsupp k) (hsupp j) hdisj
    simp only [hT]
    rw [MeasureTheory.integral_const_mul, hzero, mul_zero]
  -- expand the product into a quadruple sum
  have hx : ∀ x : EuclideanSpace ℝ (Fin 3),
      bigU (fun n x ↦ f n x) s x * conj (bigU (fun n x ↦ f n x) s' x)
        = ∑ i : Fin M, ∑ k : Fin M, ∑ j : Fin M, ∑ l : Fin M, T i j k l x := by
    intro x
    rw [bigU, conj_bigU_eq, Finset.sum_mul_sum]
    refine Finset.sum_congr rfl fun i _ ↦ ?_
    refine Finset.sum_congr rfl fun k _ ↦ ?_
    rw [Finset.sum_mul_sum]
    refine Finset.sum_congr rfl fun j _ ↦ ?_
    refine Finset.sum_congr rfl fun l _ ↦ ?_
    simp only [hT, map_mul]
    push_cast
    ring
  rw [MeasureTheory.integral_congr_ae (MeasureTheory.ae_of_all _ hx),
    MeasureTheory.integral_finsetSum _ (fun i _ ↦ MeasureTheory.integrable_finsetSum _
      fun k _ ↦ MeasureTheory.integrable_finsetSum _ fun j _ ↦
        MeasureTheory.integrable_finsetSum _ fun l _ ↦ hint i j k l)]
  refine Finset.sum_eq_zero fun i _ ↦ ?_
  rw [MeasureTheory.integral_finsetSum _ (fun k _ ↦ MeasureTheory.integrable_finsetSum _
    fun j _ ↦ MeasureTheory.integrable_finsetSum _ fun l _ ↦ hint i j k l)]
  refine Finset.sum_eq_zero fun k _ ↦ ?_
  rw [MeasureTheory.integral_finsetSum _ (fun j _ ↦ MeasureTheory.integrable_finsetSum _
    fun l _ ↦ hint i j k l)]
  refine Finset.sum_eq_zero fun j _ ↦ ?_
  rw [MeasureTheory.integral_finsetSum _ (fun l _ ↦ hint i j k l)]
  exact Finset.sum_eq_zero fun l _ ↦ hterm i j k l

end Scales

/-! ### The full off-diagonal sum `U` and its decomposition -/

section FullSum

open scoped ComplexConjugate

variable {α : Type*}

/-- `U = ∑_{i<j} f_i \overline{f_j}`, the full off-diagonal sum of Subsection 4.2. -/
def bigUfull {M : ℕ} (f : Fin M → α → ℂ) (x : α) : ℂ :=
  ∑ i : Fin M, ∑ j : Fin M, (if i < j then f i x * conj (f j x) else 0)

/-- **(4.1) in operator form**: the dyadic pieces `U_s`, `0 ≤ s < L`, add up to `U`. -/
theorem sum_bigU_eq_bigUfull {M : ℕ} (f : Fin M → α → ℂ) {n : ℕ}
    (hMn : (M : ℝ) ≤ 2 ^ n) (x : α) :
    ∑ s ∈ Finset.range (n + 1), bigU f s x = bigUfull f x := by
  rw [bigUfull]
  simp only [bigU]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun i _ ↦ ?_
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun j _ ↦ ?_
  rw [← Finset.sum_mul, ← Complex.ofReal_sum]
  by_cases hij : i < j
  · have hlt : (i : ℕ) < (j : ℕ) := hij
    have hk1 : 1 ≤ (j : ℕ) - (i : ℕ) := by omega
    have hkcast : ((j : ℤ) : ℝ) - ((i : ℤ) : ℝ) = ((((j : ℕ) - (i : ℕ) : ℕ)) : ℝ) := by
      rw [Nat.cast_sub hlt.le]
      push_cast
      ring
    have hkn : ((((j : ℕ) - (i : ℕ) : ℕ)) : ℝ) ≤ 2 ^ n := by
      have hkM : (j : ℕ) - (i : ℕ) < M := by omega
      have hlt' : ((((j : ℕ) - (i : ℕ) : ℕ)) : ℝ) < (M : ℝ) := by exact_mod_cast hkM
      linarith
    have hsum : (∑ s ∈ Finset.range (n + 1),
        psi (((2:ℝ)⁻¹) ^ s * (((j : ℤ) : ℝ) - ((i : ℤ) : ℝ)))) = 1 := by
      rw [Finset.sum_congr rfl fun s _ ↦ by rw [hkcast]]
      exact sum_psi_eq_one hk1 hkn
    rw [hsum]
    simp [hij]
  · have hji : (j : ℕ) ≤ (i : ℕ) := by
      rcases le_or_gt (j : ℕ) (i : ℕ) with h | h
      · exact h
      · exact absurd (show i < j from h) hij
    have hneg : ((j : ℤ) : ℝ) - ((i : ℤ) : ℝ) ≤ 0 := by
      have hc : ((j : ℤ) : ℝ) ≤ ((i : ℤ) : ℝ) := by exact_mod_cast hji
      linarith
    have hsum : (∑ s ∈ Finset.range (n + 1),
        psi (((2:ℝ)⁻¹) ^ s * (((j : ℤ) : ℝ) - ((i : ℤ) : ℝ)))) = 0 := by
      refine Finset.sum_eq_zero fun s _ ↦ psi_eq_zero_of_lt_half ?_
      have hpow : (0:ℝ) < ((2:ℝ)⁻¹) ^ s := by positivity
      nlinarith
    rw [hsum]
    simp [hij]

/-- `H = 2 Re U`: the off-diagonal part of `|∑ f_j|²`. -/
theorem bigH_eq_two_re_bigUfull {M : ℕ} (f : Fin M → α → ℂ) (x : α) :
    bigH f x = 2 * (bigUfull f x).re := by
  have hstep : conj (bigUfull f x)
      = ∑ i : Fin M, ∑ j : Fin M, conj (if i < j then f i x * conj (f j x) else 0) := by
    rw [bigUfull, map_sum]
    exact Finset.sum_congr rfl fun i _ ↦ map_sum (starRingEnd ℂ) _ _
  have hconj : conj (bigUfull f x)
      = ∑ a : Fin M, ∑ b : Fin M, (if b < a then f a x * conj (f b x) else 0) := by
    rw [hstep, Finset.sum_comm]
    refine Finset.sum_congr rfl fun a _ ↦ Finset.sum_congr rfl fun b _ ↦ ?_
    by_cases h : b < a
    · rw [if_pos h, if_pos h, map_mul, Complex.conj_conj]
      ring
    · rw [if_neg h, if_neg h, map_zero]
  have hkey : bigUfull f x + conj (bigUfull f x) = ((bigH f x : ℝ) : ℂ) := by
    rw [bigH_ofReal_eq, hconj, bigUfull, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun a _ ↦ ?_
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun b _ ↦ ?_
    rcases lt_trichotomy a b with h | h | h
    · rw [if_pos h, if_neg (asymm h), if_neg (ne_of_lt h)]
      ring
    · subst h
      simp
    · rw [if_neg (asymm h), if_pos h, if_neg (Ne.symm (ne_of_lt h))]
      ring
  have hre : bigUfull f x + conj (bigUfull f x) = ((2 * (bigUfull f x).re : ℝ) : ℂ) :=
    Complex.add_conj _
  rw [hre] at hkey
  exact (Complex.ofReal_inj.mp hkey).symm

end FullSum

/-! ### Almost orthogonality of the dyadic pieces -/

section AlmostOrthogonal

open MeasureTheory
open scoped ComplexConjugate

variable {α : Type*} [MeasurableSpace α]

lemma integrable_bigU_mul_conj_bigU {M : ℕ} {μ : Measure α} {f : Fin M → α → ℂ}
    (hf : ∀ n, MemLp (f n) 4 μ) (s s' : ℕ) :
    Integrable (fun x ↦ bigU f s x * conj (bigU f s' x)) μ := by
  have hx : ∀ x : α, bigU f s x * conj (bigU f s' x)
      = ∑ i : Fin M, ∑ j : Fin M,
          (psi (((2:ℝ)⁻¹) ^ s * ((j : ℤ) - (i : ℤ))) : ℂ) *
            (conj (bigU f s' x) * (f i x * conj (f j x))) := by
    intro x
    rw [bigU, Finset.sum_mul]
    refine Finset.sum_congr rfl fun i _ ↦ ?_
    rw [Finset.sum_mul]
    exact Finset.sum_congr rfl fun j _ ↦ by ring
  rw [funext hx]
  exact integrable_finsetSum _ fun i _ ↦ integrable_finsetSum _ fun j _ ↦
    (integrable_conj_bigU_mul hf s' i j).const_mul _

/-- Every pairing of two dyadic pieces is bounded by `(2 ‖𝓕⁻ψ‖_{L¹} ‖S‖₄²)²`. -/
theorem norm_integral_bigU_mul_conj_bigU_le {M : ℕ} {μ : Measure α} {f : Fin M → α → ℂ}
    (hf : OrderedSuperorthogonal μ f) (h29 : ExtraCancellation μ f) (s s' : ℕ) :
    ‖∫ x, bigU f s x * conj (bigU f s' x) ∂μ‖ ≤ (2 * psiL1 * nrmS μ f ^ 2) ^ 2 := by
  have hm1 := aestronglyMeasurable_bigU hf.memLp s
  have hm2 := aestronglyMeasurable_bigU hf.memLp s'
  have hs1 := integrable_normSq_bigU hf.memLp s
  have hs2 := integrable_normSq_bigU hf.memLp s'
  have hprod : Integrable (fun x ↦ ‖bigU f s x‖ * ‖bigU f s' x‖) μ :=
    integrable_mul_of_sq hs1 hs2 (hm1.norm.mul hm2.norm)
  have h1 : ‖∫ x, bigU f s x * conj (bigU f s' x) ∂μ‖
      ≤ ∫ x, ‖bigU f s x‖ * ‖bigU f s' x‖ ∂μ := by
    refine (norm_integral_le_integral_norm _).trans_eq ?_
    refine integral_congr_ae (ae_of_all _ fun x ↦ ?_)
    simp only []
    rw [norm_mul, RCLike.norm_conj]
  refine h1.trans ((integral_mul_le_nrm2 hs1 hs2 hprod).trans ?_)
  have hb1 := nrm2_bigU_le hf h29 s
  have hb2 := nrm2_bigU_le hf h29 s'
  have hBnn : (0:ℝ) ≤ 2 * psiL1 * nrmS μ f ^ 2 := by
    have := psiL1_nonneg
    have := sq_nonneg (nrmS μ f)
    nlinarith
  nlinarith [nrm2_nonneg μ (fun x ↦ ‖bigU f s x‖), nrm2_nonneg μ (fun x ↦ ‖bigU f s' x‖)]

/-- **The `L²` bound for `U`**: at most seven of the `L` dyadic pieces can pair nontrivially
with any given one, so the almost-orthogonal sum loses only the factor `L`. -/
theorem integral_normSq_sum_bigU_le {M : ℕ} {μ : Measure α} {f : Fin M → α → ℂ}
    (hf : OrderedSuperorthogonal μ f) (h29 : ExtraCancellation μ f) (L : ℕ)
    (horth : ∀ s s' : ℕ, s + 4 ≤ s' → (∫ x, bigU f s x * conj (bigU f s' x) ∂μ) = 0) :
    (∫ x, ‖∑ s ∈ Finset.range L, bigU f s x‖ ^ 2 ∂μ)
      ≤ 7 * L * (2 * psiL1 * nrmS μ f ^ 2) ^ 2 := by
  have hBnn : (0:ℝ) ≤ (2 * psiL1 * nrmS μ f ^ 2) ^ 2 := sq_nonneg _
  -- the other order of the vanishing
  have hother : ∀ s s' : ℕ, s' + 4 ≤ s →
      (∫ x, bigU f s x * conj (bigU f s' x) ∂μ) = 0 := by
    intro s s' h
    have hcc : (∫ x, bigU f s x * conj (bigU f s' x) ∂μ)
        = conj (∫ x, bigU f s' x * conj (bigU f s x) ∂μ) := by
      rw [← integral_conj]
      refine integral_congr_ae (ae_of_all _ fun x ↦ ?_)
      simp only []
      rw [map_mul, Complex.conj_conj]
      ring
    rw [hcc, horth s' s h, map_zero]
  -- the pointwise expansion of the square
  have hx : ∀ x : α,
      (∑ s ∈ Finset.range L, ∑ s' ∈ Finset.range L, bigU f s x * conj (bigU f s' x))
        = ((‖∑ s ∈ Finset.range L, bigU f s x‖ ^ 2 : ℝ) : ℂ) := by
    intro x
    rw [← Finset.sum_mul_sum, ← map_sum, Complex.mul_conj, Complex.normSq_eq_norm_sq]
  have hAc : (((∫ x, ‖∑ s ∈ Finset.range L, bigU f s x‖ ^ 2 ∂μ : ℝ)) : ℂ)
      = ∑ s ∈ Finset.range L, ∑ s' ∈ Finset.range L,
          ∫ x, bigU f s x * conj (bigU f s' x) ∂μ := by
    rw [← integral_complex_ofReal,
      integral_congr_ae (ae_of_all _ fun x ↦ (hx x).symm),
      integral_finsetSum _ (fun s _ ↦ integrable_finsetSum _ fun s' _ ↦
        integrable_bigU_mul_conj_bigU hf.memLp s s')]
    exact Finset.sum_congr rfl fun s _ ↦
      integral_finsetSum _ fun s' _ ↦ integrable_bigU_mul_conj_bigU hf.memLp s s'
  -- the row bound: at most seven nonzero pairings
  have hrow : ∀ s ∈ Finset.range L,
      (∑ s' ∈ Finset.range L, ‖∫ x, bigU f s x * conj (bigU f s' x) ∂μ‖)
        ≤ 7 * (2 * psiL1 * nrmS μ f ^ 2) ^ 2 := by
    intro s _
    set T : Finset ℕ :=
      (Finset.range L).filter (fun t ↦ s < t + 4 ∧ t < s + 4) with hT
    have hvanish : ∀ t ∈ Finset.range L, t ∉ T →
        ‖∫ x, bigU f s x * conj (bigU f t x) ∂μ‖ = 0 := by
      intro t ht hnt
      rw [hT, Finset.mem_filter] at hnt
      have hcase : s + 4 ≤ t ∨ t + 4 ≤ s := by
        by_contra hcon
        exact hnt ⟨ht, by omega, by omega⟩
      rcases hcase with h | h
      · rw [horth s t h, norm_zero]
      · rw [hother s t h, norm_zero]
    have hsplit : (∑ t ∈ T, ‖∫ x, bigU f s x * conj (bigU f t x) ∂μ‖)
        = ∑ t ∈ Finset.range L, ‖∫ x, bigU f s x * conj (bigU f t x) ∂μ‖ :=
      Finset.sum_subset (by rw [hT]; exact Finset.filter_subset _ _) hvanish
    have hcard : T.card ≤ 7 := by
      have hsub : T ⊆ Finset.Icc (s - 3) (s + 3) := by
        intro t ht
        rw [hT, Finset.mem_filter] at ht
        rw [Finset.mem_Icc]
        omega
      calc T.card ≤ (Finset.Icc (s - 3) (s + 3)).card := Finset.card_le_card hsub
        _ = s + 3 + 1 - (s - 3) := Nat.card_Icc _ _
        _ ≤ 7 := by omega
    rw [← hsplit]
    have hle : (∑ t ∈ T, ‖∫ x, bigU f s x * conj (bigU f t x) ∂μ‖)
        ≤ T.card • (2 * psiL1 * nrmS μ f ^ 2) ^ 2 :=
      Finset.sum_le_card_nsmul _ _ _ fun t _ ↦
        norm_integral_bigU_mul_conj_bigU_le hf h29 s t
    rw [nsmul_eq_mul] at hle
    refine hle.trans ?_
    have hc : (T.card : ℝ) ≤ 7 := by exact_mod_cast hcard
    nlinarith
  -- assemble
  have hAnn : (0:ℝ) ≤ ∫ x, ‖∑ s ∈ Finset.range L, bigU f s x‖ ^ 2 ∂μ :=
    integral_nonneg fun x ↦ by positivity
  have hnorm : ‖(((∫ x, ‖∑ s ∈ Finset.range L, bigU f s x‖ ^ 2 ∂μ : ℝ)) : ℂ)‖
      = ∫ x, ‖∑ s ∈ Finset.range L, bigU f s x‖ ^ 2 ∂μ := by
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hAnn]
  calc (∫ x, ‖∑ s ∈ Finset.range L, bigU f s x‖ ^ 2 ∂μ)
      = ‖(((∫ x, ‖∑ s ∈ Finset.range L, bigU f s x‖ ^ 2 ∂μ : ℝ)) : ℂ)‖ := hnorm.symm
    _ = ‖∑ s ∈ Finset.range L, ∑ s' ∈ Finset.range L,
          ∫ x, bigU f s x * conj (bigU f s' x) ∂μ‖ := by rw [hAc]
    _ ≤ ∑ s ∈ Finset.range L, ‖∑ s' ∈ Finset.range L,
          ∫ x, bigU f s x * conj (bigU f s' x) ∂μ‖ := norm_sum_le _ _
    _ ≤ ∑ s ∈ Finset.range L, ∑ s' ∈ Finset.range L,
          ‖∫ x, bigU f s x * conj (bigU f s' x) ∂μ‖ :=
        Finset.sum_le_sum fun s _ ↦ norm_sum_le _ _
    _ ≤ ∑ _s ∈ Finset.range L, 7 * (2 * psiL1 * nrmS μ f ^ 2) ^ 2 :=
        Finset.sum_le_sum hrow
    _ = 7 * L * (2 * psiL1 * nrmS μ f ^ 2) ^ 2 := by
        rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
        ring

end AlmostOrthogonal

/-! ### The `L⁴` estimate for one arithmetic-progression class -/

section OneClass

open SchwartzMap FourierTransform MeasureTheory
open scoped Pointwise SchwartzMap ComplexConjugate

lemma integrable_normSq_sum_bigU {α : Type*} [MeasurableSpace α] {M : ℕ} {μ : Measure α}
    {f : Fin M → α → ℂ} (hf : ∀ n, MemLp (f n) 4 μ) (L : ℕ) :
    Integrable (fun x ↦ ‖∑ s ∈ Finset.range L, bigU f s x‖ ^ 2) μ := by
  have h := (integrable_finsetSum (Finset.range L)
    (fun s (_ : s ∈ Finset.range L) ↦ integrable_finsetSum (Finset.range L)
      fun s' (_ : s' ∈ Finset.range L) ↦ integrable_bigU_mul_conj_bigU hf s s')).re
  refine h.congr (ae_of_all _ fun x ↦ ?_)
  simp only []
  rw [← Finset.sum_mul_sum, ← map_sum, Complex.mul_conj, Complex.normSq_eq_norm_sq]
  simp [-Complex.ofReal_pow]

/-- **Theorem 1.4 for one residue class**: an arithmetic progression of `M` equal caps with
gap `11w` obeys the reverse square function estimate with the loss `(1 + log M)^{1/4}`,
here in the squared form and with `L = n + 1` dyadic scales. -/
theorem nrm4_sq_le_capFamily {M : ℕ} {w : ℝ} (hw : 0 < w) {c : Fin M → ℝ}
    (hc : ∀ i j : Fin M, c j - c i = 11 * w * (((j : ℤ) - (i : ℤ) : ℤ) : ℝ))
    (f : Fin M → 𝓢(EuclideanSpace ℝ (Fin 3), ℂ))
    (hsupp : ∀ m, Function.support
      (fun ξ : EuclideanSpace ℝ (Fin 3) ↦ (FourierTransform.fourier (f m)) ξ)
      ⊆ capSector w (capInterval w (c m)))
    {n : ℕ} (hMn : (M : ℝ) ≤ 2 ^ n) :
    nrm4 (volume : Measure (EuclideanSpace ℝ (Fin 3))) (fun x ↦ ∑ m, f m x) ^ 2
      ≤ (1 + 4 * psiL1 * Real.sqrt (7 * ((n : ℝ) + 1)))
          * nrmS (volume : Measure (EuclideanSpace ℝ (Fin 3))) (fun m x ↦ f m x) ^ 2 := by
  have hmem : ∀ m : Fin M, MemLp (fun x ↦ f m x) 4
      (volume : Measure (EuclideanSpace ℝ (Fin 3))) := fun m ↦ (f m).memLp 4 _
  have hmono : ∀ i j : Fin M, i < j → 11 * w ≤ c j - c i := by
    intro i j hij
    have hlt : (i : ℕ) < (j : ℕ) := hij
    have hz : (1:ℤ) ≤ (j : ℤ) - (i : ℤ) := by omega
    have hr : (1:ℝ) ≤ (((j : ℤ) - (i : ℤ) : ℤ) : ℝ) := by exact_mod_cast hz
    rw [hc i j]
    nlinarith
  have hcone : ∀ m, Function.support
      (fun ξ : EuclideanSpace ℝ (Fin 3) ↦ (FourierTransform.fourier (f m)) ξ)
      ⊆ coneSector 1 w (capInterval w (c m)) :=
    fun m ↦ (hsupp m).trans (capSector_subset_coneSector _)
  have hgap : ∀ i j : Fin M, i < j →
      ∀ a ∈ capInterval w (c i), ∀ b ∈ capInterval w (c j), 2 * w ≤ b - a := by
    rintro i j hij a ⟨ha1, ha2⟩ b ⟨hb1, hb2⟩
    have := hmono i j hij
    linarith
  have h12 := orderedSuperorthogonal_of_coneSector (by norm_num : (0:ℝ) < 1) hw hgap f hcone
  have habs : ∀ i j : Fin M, i ≠ j → 11 * w ≤ |c i - c j| := by
    intro i j hij
    rcases lt_or_gt_of_ne hij with h | h
    · have := hmono i j h
      rw [abs_of_nonpos (by linarith)]
      linarith
    · have := hmono j i h
      rw [abs_of_nonneg (by linarith)]
      linarith
  have h29 := extraCancellation_of_capSector hw habs f hsupp
  have horth : ∀ s s' : ℕ, s + 4 ≤ s' →
      (∫ x, bigU (fun m x ↦ f m x) s x * conj (bigU (fun m x ↦ f m x) s' x)
        ∂(volume : Measure (EuclideanSpace ℝ (Fin 3)))) = 0 :=
    fun s s' h ↦ integral_bigU_mul_conj_bigU_eq_zero hw hc f hsupp h
  have hWsq := integral_normSq_sum_bigU_le h12 h29 (n + 1) horth
  push_cast at hWsq
  have hWint := integrable_normSq_sum_bigU hmem (n + 1)
  have hPnn : (0:ℝ) ≤ psiL1 := psiL1_nonneg
  have hSnn : (0:ℝ) ≤ nrmS (volume : Measure (EuclideanSpace ℝ (Fin 3)))
      (fun m x ↦ f m x) ^ 2 := sq_nonneg _
  have hBnn : (0:ℝ) ≤ 2 * psiL1 *
      nrmS (volume : Measure (EuclideanSpace ℝ (Fin 3))) (fun m x ↦ f m x) ^ 2 := by
    nlinarith
  have hHpt : ∀ x : EuclideanSpace ℝ (Fin 3),
      bigH (fun m x ↦ f m x) x
        = 2 * (∑ s ∈ Finset.range (n + 1), bigU (fun m x ↦ f m x) s x).re := by
    intro x
    rw [bigH_eq_two_re_bigUfull (fun m x ↦ f m x) x,
      ← sum_bigU_eq_bigUfull (fun m x ↦ f m x) hMn x]
  have hsqrt : Real.sqrt (7 * ((n : ℝ) + 1)) ^ 2 = 7 * ((n : ℝ) + 1) :=
    Real.sq_sqrt (by positivity)
  have hH : nrm2 (volume : Measure (EuclideanSpace ℝ (Fin 3))) (bigH (fun m x ↦ f m x))
      ≤ 2 * Real.sqrt (7 * ((n : ℝ) + 1)) *
          (2 * psiL1 * nrmS volume (fun m x ↦ f m x) ^ 2) := by
    refine nrm2_le_of_sq_le (by positivity) ?_
    have hbound : (∫ x, bigH (fun m x ↦ f m x) x ^ 2
          ∂(volume : Measure (EuclideanSpace ℝ (Fin 3))))
        ≤ ∫ x, 4 * ‖∑ s ∈ Finset.range (n + 1), bigU (fun m x ↦ f m x) s x‖ ^ 2
            ∂(volume : Measure (EuclideanSpace ℝ (Fin 3))) := by
      refine integral_mono_of_nonneg (ae_of_all _ fun x ↦ sq_nonneg _)
        (hWint.const_mul 4) (ae_of_all _ fun x ↦ ?_)
      simp only []
      rw [hHpt x]
      have hre := Complex.abs_re_le_norm
        (∑ s ∈ Finset.range (n + 1), bigU (fun m x ↦ f m x) s x)
      nlinarith [sq_abs (∑ s ∈ Finset.range (n + 1), bigU (fun m x ↦ f m x) s x).re,
        abs_nonneg (∑ s ∈ Finset.range (n + 1), bigU (fun m x ↦ f m x) s x).re,
        norm_nonneg (∑ s ∈ Finset.range (n + 1), bigU (fun m x ↦ f m x) s x)]
    calc (∫ x, bigH (fun m x ↦ f m x) x ^ 2
          ∂(volume : Measure (EuclideanSpace ℝ (Fin 3))))
        ≤ ∫ x, 4 * ‖∑ s ∈ Finset.range (n + 1), bigU (fun m x ↦ f m x) s x‖ ^ 2
            ∂(volume : Measure (EuclideanSpace ℝ (Fin 3))) := hbound
      _ = 4 * ∫ x, ‖∑ s ∈ Finset.range (n + 1), bigU (fun m x ↦ f m x) s x‖ ^ 2
            ∂(volume : Measure (EuclideanSpace ℝ (Fin 3))) :=
          MeasureTheory.integral_const_mul _ _
      _ ≤ 4 * (7 * ((n : ℝ) + 1) *
            (2 * psiL1 * nrmS volume (fun m x ↦ f m x) ^ 2) ^ 2) := by linarith
      _ = (2 * Real.sqrt (7 * ((n : ℝ) + 1)) *
            (2 * psiL1 * nrmS volume (fun m x ↦ f m x) ^ 2)) ^ 2 := by
          have hexp : (2 * Real.sqrt (7 * ((n : ℝ) + 1)) *
              (2 * psiL1 * nrmS volume (fun m x ↦ f m x) ^ 2)) ^ 2
              = 4 * (Real.sqrt (7 * ((n : ℝ) + 1)) ^ 2) *
                (2 * psiL1 * nrmS volume (fun m x ↦ f m x) ^ 2) ^ 2 := by ring
          rw [hexp, hsqrt]
          ring
  have hstart := nrm4_sq_le_nrm2_bigH hmem
  calc nrm4 (volume : Measure (EuclideanSpace ℝ (Fin 3))) (fun x ↦ ∑ m, f m x) ^ 2
      ≤ nrmS volume (fun m x ↦ f m x) ^ 2
          + nrm2 volume (bigH (fun m x ↦ f m x)) := hstart
    _ ≤ nrmS volume (fun m x ↦ f m x) ^ 2
          + 2 * Real.sqrt (7 * ((n : ℝ) + 1)) *
            (2 * psiL1 * nrmS volume (fun m x ↦ f m x) ^ 2) := by linarith
    _ = (1 + 4 * psiL1 * Real.sqrt (7 * ((n : ℝ) + 1)))
          * nrmS volume (fun m x ↦ f m x) ^ 2 := by ring

end OneClass

/-! ### Splitting the index set into eleven arithmetic progressions -/

section Residues

open SchwartzMap FourierTransform MeasureTheory
open scoped Pointwise SchwartzMap ComplexConjugate

/-- The number of indices below `N` in the residue class `r` modulo `11`. -/
def classSize (N r : ℕ) : ℕ := (N + 10 - r) / 11

lemma mem_classSize {N r m : ℕ} (_hr : r < 11) :
    m < classSize N r ↔ r + 11 * m < N := by
  rw [classSize]
  omega

/-- A residue class of `Finset.range N` is an arithmetic progression. -/
lemma sum_residue_class {N r : ℕ} (_hr : r < 11) {β : Type*} [AddCommMonoid β]
    (F : ℕ → β) :
    (∑ j ∈ (Finset.range N).filter (fun j ↦ j % 11 = r), F j)
      = ∑ m ∈ Finset.range (classSize N r), F (r + 11 * m) := by
  refine Finset.sum_nbij' (i := fun j ↦ j / 11) (j := fun m ↦ r + 11 * m) ?_ ?_ ?_ ?_ ?_
  · intro a ha
    simp only [Finset.mem_filter, Finset.mem_range] at ha
    simp only [Finset.mem_range, classSize]
    omega
  · intro m hm
    simp only [Finset.mem_range] at hm
    rw [classSize] at hm
    simp only [Finset.mem_filter, Finset.mem_range]
    omega
  · intro a ha
    simp only [Finset.mem_filter, Finset.mem_range] at ha
    omega
  · intro m hm
    omega
  · intro a ha
    simp only [Finset.mem_filter, Finset.mem_range] at ha
    congr 1
    omega

/-- Every sum over `Finset.range N` splits into the eleven residue classes. -/
lemma sum_split_residues {N : ℕ} {β : Type*} [AddCommMonoid β] (F : ℕ → β) :
    (∑ j ∈ Finset.range N, F j)
      = ∑ r ∈ Finset.range 11, ∑ m ∈ Finset.range (classSize N r), F (r + 11 * m) := by
  have hmaps : ∀ j ∈ Finset.range N, j % 11 ∈ Finset.range 11 :=
    fun j _ ↦ Finset.mem_range.mpr (Nat.mod_lt _ (by norm_num))
  rw [← Finset.sum_fiberwise_of_maps_to hmaps F]
  exact Finset.sum_congr rfl fun r hr ↦ sum_residue_class (Finset.mem_range.mp hr) F

/-- The family extended by zero past `N`. -/
def padSchwartz {N : ℕ} (f : Fin N → 𝓢(EuclideanSpace ℝ (Fin 3), ℂ)) (j : ℕ) :
    𝓢(EuclideanSpace ℝ (Fin 3), ℂ) :=
  if h : j < N then f ⟨j, h⟩ else 0

lemma padSchwartz_of_lt {N : ℕ} (f : Fin N → 𝓢(EuclideanSpace ℝ (Fin 3), ℂ))
    {j : ℕ} (h : j < N) : padSchwartz f j = f ⟨j, h⟩ := dif_pos h

lemma padSchwartz_coe {N : ℕ} (f : Fin N → 𝓢(EuclideanSpace ℝ (Fin 3), ℂ)) (j : Fin N) :
    padSchwartz f (j : ℕ) = f j := by
  rw [padSchwartz_of_lt f j.isLt]

/-- The eleven-class decomposition of a sum over the whole family. -/
lemma sum_split_padSchwartz {N : ℕ} (f : Fin N → 𝓢(EuclideanSpace ℝ (Fin 3), ℂ))
    {β : Type*} [AddCommMonoid β] (T : 𝓢(EuclideanSpace ℝ (Fin 3), ℂ) → β) :
    (∑ j : Fin N, T (f j))
      = ∑ r ∈ Finset.range 11, ∑ m ∈ Finset.range (classSize N r),
          T (padSchwartz f (r + 11 * m)) := by
  have h1 : (∑ j : Fin N, T (f j)) = ∑ j ∈ Finset.range N, T (padSchwartz f j) := by
    rw [← Fin.sum_univ_eq_sum_range (fun j ↦ T (padSchwartz f j)) N]
    exact Finset.sum_congr rfl fun j _ ↦ by rw [padSchwartz_coe]
  rw [h1]
  exact sum_split_residues (fun j ↦ T (padSchwartz f j))

end Residues

/-! ### Theorem 1.4 -/

section Theorem14

open SchwartzMap FourierTransform MeasureTheory
open scoped Pointwise SchwartzMap ComplexConjugate

/-- **Theorem 1.4, dyadic form.** For the equal-width partition of `[0,1]` into `N`
intervals and the corresponding caps on the cone, the fourth power of the `L⁴` norm of
`∑ f_j` is at most `1331 (1 + 4 ‖𝓕⁻ψ‖_{L¹} √(7L))²` times `‖S‖₄⁴`, where `L = n + 1` and
`N ≤ 2ⁿ`. -/
theorem pow4_sum_le_of_capPartition {N : ℕ} (hN : 2 ≤ N)
    (f : Fin N → 𝓢(EuclideanSpace ℝ (Fin 3), ℂ))
    (hsupp : ∀ j : Fin N, Function.support
      (fun ξ : EuclideanSpace ℝ (Fin 3) ↦ (FourierTransform.fourier (f j)) ξ)
      ⊆ capSector (1 / (N : ℝ))
          (capInterval (1 / (N : ℝ)) ((((j : ℕ) : ℝ) + 1 / 2) * (1 / (N : ℝ)))))
    {n : ℕ} (hNn : (N : ℝ) ≤ 2 ^ n) :
    pow4 (volume : Measure (EuclideanSpace ℝ (Fin 3))) (fun x ↦ ∑ j, f j x)
      ≤ 1331 * (1 + 4 * psiL1 * Real.sqrt (7 * ((n : ℝ) + 1))) ^ 2
          * pow4S (volume : Measure (EuclideanSpace ℝ (Fin 3))) (fun j x ↦ f j x) := by
  have hNpos : (0:ℝ) < (N : ℝ) := by
    have hpos : (0:ℕ) < N := by omega
    exact_mod_cast hpos
  set δ : ℝ := 1 / (N : ℝ) with hδ
  have hδpos : (0:ℝ) < δ := by rw [hδ]; positivity
  set K : ℝ := 1 + 4 * psiL1 * Real.sqrt (7 * ((n : ℝ) + 1)) with hK
  have hKnn : (0:ℝ) ≤ K := by
    have h1 : (0:ℝ) ≤ psiL1 := psiL1_nonneg
    have h2 : (0:ℝ) ≤ Real.sqrt (7 * ((n : ℝ) + 1)) := Real.sqrt_nonneg _
    rw [hK]
    nlinarith
  set Gr : ℕ → EuclideanSpace ℝ (Fin 3) → ℂ := fun r x ↦
    ∑ m ∈ Finset.range (classSize N r), padSchwartz f (r + 11 * m) x with hGr
  set Ar : ℕ → EuclideanSpace ℝ (Fin 3) → ℝ := fun r x ↦
    ∑ m ∈ Finset.range (classSize N r), ‖padSchwartz f (r + 11 * m) x‖ ^ 2 with hAr
  have hsplitG : ∀ x, (∑ j, f j x) = ∑ r ∈ Finset.range 11, Gr r x := by
    intro x
    simp only [hGr]
    exact sum_split_padSchwartz f (fun h ↦ h x)
  have hsplitA : ∀ x, (∑ j : Fin N, ‖f j x‖ ^ 2) = ∑ r ∈ Finset.range 11, Ar r x := by
    intro x
    simp only [hAr]
    exact sum_split_padSchwartz f (fun h ↦ ‖h x‖ ^ 2)
  have hmemG : ∀ r : ℕ, MemLp (Gr r) 4 (volume : Measure (EuclideanSpace ℝ (Fin 3))) := by
    intro r
    simp only [hGr]
    exact memLp_finsetSum _ fun m _ ↦ (padSchwartz f (r + 11 * m)).memLp 4
      (volume : Measure (EuclideanSpace ℝ (Fin 3)))
  have hintG : ∀ r : ℕ, Integrable (fun x ↦ ‖Gr r x‖ ^ 4)
      (volume : Measure (EuclideanSpace ℝ (Fin 3))) :=
    fun r ↦ (hmemG r).integrable_norm_pow (p := 4) (by norm_num)
  -- the class bound
  have hclass : ∀ r ∈ Finset.range 11,
      pow4 (volume : Measure (EuclideanSpace ℝ (Fin 3))) (Gr r)
        ≤ K ^ 2 * ∫ x, (Ar r x) ^ 2 ∂(volume : Measure (EuclideanSpace ℝ (Fin 3))) := by
    intro r hrmem
    have hr : r < 11 := Finset.mem_range.mp hrmem
    have hlt : ∀ m : Fin (classSize N r), r + 11 * (m : ℕ) < N :=
      fun m ↦ (mem_classSize hr).mp m.isLt
    set g : Fin (classSize N r) → 𝓢(EuclideanSpace ℝ (Fin 3), ℂ) :=
      fun m ↦ padSchwartz f (r + 11 * (m : ℕ)) with hg
    set cc : Fin (classSize N r) → ℝ :=
      fun m ↦ (((r + 11 * (m : ℕ) : ℕ) : ℝ) + 1 / 2) * δ with hcc
    have hc : ∀ i j : Fin (classSize N r),
        cc j - cc i = 11 * δ * (((j : ℤ) - (i : ℤ) : ℤ) : ℝ) := by
      intro i j
      simp only [hcc]
      push_cast
      ring
    have hsuppc : ∀ m : Fin (classSize N r), Function.support
        (fun ξ : EuclideanSpace ℝ (Fin 3) ↦ (FourierTransform.fourier (g m)) ξ)
        ⊆ capSector δ (capInterval δ (cc m)) := by
      intro m
      have hgm : g m = f ⟨r + 11 * (m : ℕ), hlt m⟩ := by
        simp only [hg]
        exact padSchwartz_of_lt f (hlt m)
      rw [hgm]
      have hs := hsupp ⟨r + 11 * (m : ℕ), hlt m⟩
      simpa only [hcc] using hs
    have hMn : ((classSize N r : ℕ) : ℝ) ≤ 2 ^ n := by
      have h1 : classSize N r ≤ N := by rw [classSize]; omega
      have h2 : ((classSize N r : ℕ) : ℝ) ≤ (N : ℝ) := by exact_mod_cast h1
      linarith
    have hmain := nrm4_sq_le_capFamily hδpos hc g hsuppc hMn
    have hGeq : (fun x ↦ ∑ m : Fin (classSize N r), g m x) = Gr r := by
      funext x
      simp only [hGr, hg]
      exact Fin.sum_univ_eq_sum_range (fun m ↦ padSchwartz f (r + 11 * m) x) _
    have hAeq : pow4S (volume : Measure (EuclideanSpace ℝ (Fin 3))) (fun m x ↦ g m x)
        = ∫ x, (Ar r x) ^ 2 ∂(volume : Measure (EuclideanSpace ℝ (Fin 3))) := by
      rw [pow4S]
      refine integral_congr_ae (Filter.Eventually.of_forall fun x ↦ ?_)
      have h2 : sqFun (fun (m : Fin (classSize N r)) x ↦ g m x) x ^ 4
          = (∑ m : Fin (classSize N r), ‖g m x‖ ^ 2) ^ 2 := by
        rw [← sq_sqFun]
        ring
      simp only []
      rw [h2]
      congr 1
      simp only [hAr, hg]
      exact Fin.sum_univ_eq_sum_range (fun m ↦ ‖padSchwartz f (r + 11 * m) x‖ ^ 2) _
    rw [hGeq] at hmain
    rw [← hAeq]
    have h4 := pow_le_pow_left₀ (sq_nonneg (nrm4 volume (Gr r))) hmain 2
    calc pow4 (volume : Measure (EuclideanSpace ℝ (Fin 3))) (Gr r)
        = (nrm4 volume (Gr r) ^ 2) ^ 2 := by rw [← nrm4_pow_four]; ring
      _ ≤ (K * nrmS volume (fun m x ↦ g m x) ^ 2) ^ 2 := h4
      _ = K ^ 2 * pow4S volume (fun m x ↦ g m x) := by
          rw [← nrmS_pow_four]
          ring
  -- the pointwise power-mean bound
  have hpt : ∀ x, ‖∑ j, f j x‖ ^ 4 ≤ 1331 * ∑ r ∈ Finset.range 11, ‖Gr r x‖ ^ 4 := by
    intro x
    rw [hsplitG x]
    have h1 : ‖∑ r ∈ Finset.range 11, Gr r x‖ ≤ ∑ r ∈ Finset.range 11, ‖Gr r x‖ :=
      norm_sum_le _ _
    have h3 : ‖∑ r ∈ Finset.range 11, Gr r x‖ ^ 4
        ≤ (∑ r ∈ Finset.range 11, ‖Gr r x‖) ^ 4 :=
      pow_le_pow_left₀ (norm_nonneg _) h1 4
    have h2 := _root_.pow_sum_div_card_le_sum_pow (s := Finset.range 11)
      (f := fun r ↦ ‖Gr r x‖) (fun i _ ↦ norm_nonneg _) 3
    rw [Finset.card_range] at h2
    have hcast : ((11 : ℕ) : ℝ) ^ 3 = 1331 := by norm_num
    rw [div_le_iff₀ (by positivity), hcast] at h2
    norm_num at h2
    linarith
  have hint_rhs : Integrable (fun x ↦ 1331 * ∑ r ∈ Finset.range 11, ‖Gr r x‖ ^ 4)
      (volume : Measure (EuclideanSpace ℝ (Fin 3))) :=
    (integrable_finsetSum _ fun r _ ↦ hintG r).const_mul _
  have hd : pow4 (volume : Measure (EuclideanSpace ℝ (Fin 3))) (fun x ↦ ∑ j, f j x)
      ≤ 1331 * ∑ r ∈ Finset.range 11,
          pow4 (volume : Measure (EuclideanSpace ℝ (Fin 3))) (Gr r) := by
    simp only [pow4]
    calc (∫ x, ‖∑ j, f j x‖ ^ 4 ∂(volume : Measure (EuclideanSpace ℝ (Fin 3))))
        ≤ ∫ x, 1331 * ∑ r ∈ Finset.range 11, ‖Gr r x‖ ^ 4
            ∂(volume : Measure (EuclideanSpace ℝ (Fin 3))) :=
          integral_mono_of_nonneg (Filter.Eventually.of_forall fun x ↦ by positivity)
            hint_rhs (Filter.Eventually.of_forall hpt)
      _ = 1331 * ∫ x, ∑ r ∈ Finset.range 11, ‖Gr r x‖ ^ 4
            ∂(volume : Measure (EuclideanSpace ℝ (Fin 3))) :=
          MeasureTheory.integral_const_mul _ _
      _ = 1331 * ∑ r ∈ Finset.range 11,
            ∫ x, ‖Gr r x‖ ^ 4 ∂(volume : Measure (EuclideanSpace ℝ (Fin 3))) := by
          rw [integral_finsetSum _ fun r _ ↦ hintG r]
  -- the square functions of the eleven classes add up
  have hintA : ∀ r : ℕ, Integrable (fun x ↦ (Ar r x) ^ 2)
      (volume : Measure (EuclideanSpace ℝ (Fin 3))) := by
    intro r
    have hmm : ∀ m : Fin (classSize N r),
        MemLp (fun x ↦ padSchwartz f (r + 11 * (m : ℕ)) x) 4
          (volume : Measure (EuclideanSpace ℝ (Fin 3))) :=
      fun m ↦ (padSchwartz f (r + 11 * (m : ℕ))).memLp 4 _
    have h := integrable_pow4_sqFun hmm
    refine h.congr (Filter.Eventually.of_forall fun x ↦ ?_)
    have h2 : (sqFun
          (fun (m : Fin (classSize N r)) x ↦ padSchwartz f (r + 11 * (m : ℕ)) x) x ^ 2) ^ 2
        = (∑ m : Fin (classSize N r), ‖padSchwartz f (r + 11 * (m : ℕ)) x‖ ^ 2) ^ 2 := by
      rw [sq_sqFun]
    simp only []
    rw [h2]
    congr 1
    simp only [hAr]
    exact Fin.sum_univ_eq_sum_range
      (fun m ↦ ‖padSchwartz f (r + 11 * m) x‖ ^ 2) _
  have he : (∑ r ∈ Finset.range 11,
        ∫ x, (Ar r x) ^ 2 ∂(volume : Measure (EuclideanSpace ℝ (Fin 3))))
      ≤ pow4S (volume : Measure (EuclideanSpace ℝ (Fin 3))) (fun j x ↦ f j x) := by
    have hpt2 : ∀ x, (∑ r ∈ Finset.range 11, (Ar r x) ^ 2)
        ≤ sqFun (fun (j : Fin N) x ↦ f j x) x ^ 4 := by
      intro x
      have hnn : ∀ r ∈ Finset.range 11, 0 ≤ Ar r x := by
        intro r _
        simp only [hAr]
        exact Finset.sum_nonneg fun _ _ ↦ sq_nonneg _
      have hle : ∀ r ∈ Finset.range 11,
          (Ar r x) ^ 2 ≤ Ar r x * ∑ t ∈ Finset.range 11, Ar t x := by
        intro r hrm
        rw [sq]
        exact mul_le_mul_of_nonneg_left (Finset.single_le_sum hnn hrm) (hnn r hrm)
      have hsq : sqFun (fun (j : Fin N) x ↦ f j x) x ^ 4
          = (∑ j : Fin N, ‖f j x‖ ^ 2) ^ 2 := by
        rw [← sq_sqFun]
        ring
      rw [hsq, hsplitA x]
      calc (∑ r ∈ Finset.range 11, (Ar r x) ^ 2)
          ≤ ∑ r ∈ Finset.range 11, Ar r x * ∑ t ∈ Finset.range 11, Ar t x :=
            Finset.sum_le_sum hle
        _ = (∑ r ∈ Finset.range 11, Ar r x) ^ 2 := by rw [← Finset.sum_mul, sq]
    have hint4 : Integrable (fun x ↦ sqFun (fun (j : Fin N) x ↦ f j x) x ^ 4)
        (volume : Measure (EuclideanSpace ℝ (Fin 3))) := by
      have h := integrable_pow4_sqFun (fun j ↦ (f j).memLp 4
        (volume : Measure (EuclideanSpace ℝ (Fin 3))))
      refine h.congr (Filter.Eventually.of_forall fun x ↦ ?_)
      simp only []
      ring
    rw [pow4S, ← integral_finsetSum _ fun r _ ↦ hintA r]
    refine integral_mono_of_nonneg
      (Filter.Eventually.of_forall fun x ↦ Finset.sum_nonneg fun r _ ↦ sq_nonneg _)
      hint4 (Filter.Eventually.of_forall hpt2)
  -- assemble
  have hsum : (∑ r ∈ Finset.range 11,
        pow4 (volume : Measure (EuclideanSpace ℝ (Fin 3))) (Gr r))
      ≤ K ^ 2 * pow4S (volume : Measure (EuclideanSpace ℝ (Fin 3))) (fun j x ↦ f j x) := by
    calc (∑ r ∈ Finset.range 11, pow4 volume (Gr r))
        ≤ ∑ r ∈ Finset.range 11, K ^ 2 * ∫ x, (Ar r x) ^ 2 ∂volume :=
          Finset.sum_le_sum hclass
      _ = K ^ 2 * ∑ r ∈ Finset.range 11, ∫ x, (Ar r x) ^ 2 ∂volume := by
          rw [← Finset.mul_sum]
      _ ≤ K ^ 2 * pow4S volume (fun j x ↦ f j x) :=
          mul_le_mul_of_nonneg_left he (sq_nonneg K)
  calc pow4 (volume : Measure (EuclideanSpace ℝ (Fin 3))) (fun x ↦ ∑ j, f j x)
      ≤ 1331 * ∑ r ∈ Finset.range 11, pow4 volume (Gr r) := hd
    _ ≤ 1331 * (K ^ 2 * pow4S volume (fun j x ↦ f j x)) := by linarith
    _ = 1331 * K ^ 2 * pow4S volume (fun j x ↦ f j x) := by ring

/-- The absolute constant of Theorem 1.4. -/
noncomputable def cdwConst : ℝ := (1331 * (1 + 4 * psiL1 * Real.sqrt 14) ^ 2) ^ ((1:ℝ) / 4)

lemma cdwConst_nonneg : 0 ≤ cdwConst := Real.rpow_nonneg (by positivity) _

/-- The number of dyadic scales, `L = 1 + ⌈log₂ N⌉`, is at most `2 (1 + log N)`. -/
lemma clog_succ_le {N : ℕ} (hN : 2 ≤ N) :
    ((Nat.clog 2 N : ℕ) : ℝ) + 1 ≤ 2 * (1 + Real.log N) := by
  have hkpos : 0 < Nat.clog 2 N := Nat.clog_pos (by norm_num) hN
  have hlt : 2 ^ (Nat.clog 2 N - 1) < N :=
    Nat.pow_pred_clog_lt_self (by norm_num) (by omega)
  have hltR : ((2:ℝ)) ^ (Nat.clog 2 N - 1) < (N : ℝ) := by exact_mod_cast hlt
  have hcast : (((Nat.clog 2 N - 1 : ℕ)) : ℝ) = ((Nat.clog 2 N : ℕ) : ℝ) - 1 := by
    have h1 : 1 ≤ Nat.clog 2 N := hkpos
    push_cast [Nat.cast_sub h1]
    ring
  have hlog : (((Nat.clog 2 N : ℕ) : ℝ) - 1) * Real.log 2 < Real.log N := by
    have h := Real.log_lt_log (by positivity) hltR
    rw [Real.log_pow, hcast] at h
    exact h
  have hlog2 : (1:ℝ) / 2 < Real.log 2 := by
    have h := Real.log_two_gt_d9
    linarith
  have hkR : (1:ℝ) ≤ ((Nat.clog 2 N : ℕ) : ℝ) := by exact_mod_cast hkpos
  nlinarith [hlog, hlog2, hkR]

/-- **Theorem 1.4 of Cushman-Demeter-Wu.** For the canonical equal-width partition of the
light cone into `N` conic sectors `Γ_j` over the intervals `I_j = [(j-1)/N, j/N]`, every
Schwartz family with `supp(𝓕 f_j) ⊆ Γ_j` obeys the reverse square function estimate with the
sharp loss `C (1 + log N)^{1/4}`. -/
theorem cdw_theorem_1_4 {N : ℕ} (hN : 2 ≤ N)
    (f : Fin N → 𝓢(EuclideanSpace ℝ (Fin 3), ℂ))
    (hsupp : ∀ j : Fin N, Function.support
      (fun ξ : EuclideanSpace ℝ (Fin 3) ↦ (FourierTransform.fourier (f j)) ξ)
      ⊆ capSector (1 / (N : ℝ))
          (capInterval (1 / (N : ℝ)) ((((j : ℕ) : ℝ) + 1 / 2) * (1 / (N : ℝ))))) :
    nrm4 (volume : Measure (EuclideanSpace ℝ (Fin 3))) (fun x ↦ ∑ j, f j x)
      ≤ cdwConst * (1 + Real.log N) ^ ((1:ℝ) / 4)
          * nrmS (volume : Measure (EuclideanSpace ℝ (Fin 3))) (fun j x ↦ f j x) := by
  have hN1 : (1:ℝ) ≤ (N : ℝ) := by exact_mod_cast (by omega : 1 ≤ N)
  have hlogN : 0 ≤ Real.log N := Real.log_nonneg hN1
  have hNn : (N : ℝ) ≤ 2 ^ (Nat.clog 2 N) := by
    have h := Nat.le_pow_clog (by norm_num : 1 < 2) N
    exact_mod_cast h
  have hdyadic := pow4_sum_le_of_capPartition hN f hsupp hNn
  -- replace the number of scales by `2 (1 + log N)`
  have hL := clog_succ_le hN
  have hPnn : (0:ℝ) ≤ psiL1 := psiL1_nonneg
  have hs1 : Real.sqrt (7 * (((Nat.clog 2 N : ℕ) : ℝ) + 1))
      ≤ Real.sqrt 14 * Real.sqrt (1 + Real.log N) := by
    rw [← Real.sqrt_mul (by norm_num : (0:ℝ) ≤ 14)]
    exact Real.sqrt_le_sqrt (by linarith)
  have hs2 : (1:ℝ) ≤ Real.sqrt (1 + Real.log N) := by
    have h : Real.sqrt 1 ≤ Real.sqrt (1 + Real.log N) := Real.sqrt_le_sqrt (by linarith)
    rwa [Real.sqrt_one] at h
  have hs14 : (0:ℝ) ≤ Real.sqrt 14 := Real.sqrt_nonneg _
  have hKle : 1 + 4 * psiL1 * Real.sqrt (7 * (((Nat.clog 2 N : ℕ) : ℝ) + 1))
      ≤ (1 + 4 * psiL1 * Real.sqrt 14) * Real.sqrt (1 + Real.log N) := by
    nlinarith [hs1, hs2, hs14, hPnn, Real.sqrt_nonneg (1 + Real.log N)]
  have hKnn : (0:ℝ) ≤ 1 + 4 * psiL1 * Real.sqrt (7 * (((Nat.clog 2 N : ℕ) : ℝ) + 1)) := by
    have := Real.sqrt_nonneg (7 * (((Nat.clog 2 N : ℕ) : ℝ) + 1))
    nlinarith
  have hsq : Real.sqrt (1 + Real.log N) ^ 2 = 1 + Real.log N :=
    Real.sq_sqrt (by linarith)
  have hKsq : (1 + 4 * psiL1 * Real.sqrt (7 * (((Nat.clog 2 N : ℕ) : ℝ) + 1))) ^ 2
      ≤ (1 + 4 * psiL1 * Real.sqrt 14) ^ 2 * (1 + Real.log N) := by
    have h := pow_le_pow_left₀ hKnn hKle 2
    calc (1 + 4 * psiL1 * Real.sqrt (7 * (((Nat.clog 2 N : ℕ) : ℝ) + 1))) ^ 2
        ≤ ((1 + 4 * psiL1 * Real.sqrt 14) * Real.sqrt (1 + Real.log N)) ^ 2 := h
      _ = (1 + 4 * psiL1 * Real.sqrt 14) ^ 2 * (1 + Real.log N) := by
          rw [mul_pow, hsq]
  -- the resulting bound on the fourth power
  have hTnn : (0:ℝ) ≤ pow4S (volume : Measure (EuclideanSpace ℝ (Fin 3)))
      (fun j x ↦ f j x) := pow4S_nonneg _ _
  have hDnn : (0:ℝ) ≤ 1331 * (1 + 4 * psiL1 * Real.sqrt 14) ^ 2 * (1 + Real.log N) := by
    positivity
  have hmain : pow4 (volume : Measure (EuclideanSpace ℝ (Fin 3))) (fun x ↦ ∑ j, f j x)
      ≤ (1331 * (1 + 4 * psiL1 * Real.sqrt 14) ^ 2 * (1 + Real.log N))
          * pow4S (volume : Measure (EuclideanSpace ℝ (Fin 3))) (fun j x ↦ f j x) := by
    refine hdyadic.trans ?_
    have hstep : 1331 * (1 + 4 * psiL1 *
          Real.sqrt (7 * (((Nat.clog 2 N : ℕ) : ℝ) + 1))) ^ 2
        ≤ 1331 * (1 + 4 * psiL1 * Real.sqrt 14) ^ 2 * (1 + Real.log N) := by
      nlinarith [hKsq]
    exact mul_le_mul_of_nonneg_right hstep hTnn
  -- take fourth roots
  have hroot := Real.rpow_le_rpow (pow4_nonneg _ _) hmain (by norm_num : (0:ℝ) ≤ 1/4)
  rw [Real.mul_rpow hDnn hTnn,
    Real.mul_rpow (by positivity : (0:ℝ) ≤ 1331 * (1 + 4 * psiL1 * Real.sqrt 14) ^ 2)
      (by linarith : (0:ℝ) ≤ 1 + Real.log N)] at hroot
  rw [nrm4, nrmS, cdwConst]
  exact hroot

end Theorem14


