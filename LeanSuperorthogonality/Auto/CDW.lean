/-! ### The additive character -/

/-- The additive character `e(x) = exp(2 π i x)` used throughout Section 2 of the
source. -/
def e (x : ℝ) : ℂ := Complex.exp (2 * ↑π * I * x)

@[simp] lemma e_zero : e 0 = 1 := by simp [e]

