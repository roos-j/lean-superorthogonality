  simp [e, mul_assoc, Complex.norm_exp]

lemma e_add (x y : ℝ) : e (x + y) = e x * e y := by
  simp [e, Complex.ofReal_add, mul_add, Complex.exp_add]

/-- `e` is periodic with period one, so `e k = 1` for every integer `k`. -/
