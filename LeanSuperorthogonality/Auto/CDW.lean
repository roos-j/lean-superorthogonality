      intro θ; simp [e]; ring_nf
    simp only [hrw, hk, if_false]
    rw [integral_exp_mul_complex hc]
    have h1 : (2 * ↑π * I * (k : ℂ)) * (1 : ℝ) = (k : ℂ) * (2 * ↑π * I) := by push_cast; ring
    have h0 : (2 * ↑π * I * (k : ℂ)) * (0 : ℝ) = 0 := by simp
    rw [h1, h0, Complex.exp_int_mul, Complex.exp_two_pi_mul_I, one_zpow, Complex.exp_zero,
      sub_self, zero_div]

lemma eZ_add (k k' : ℤ) (θ : ℝ) : eZ (k + k') θ = eZ k θ * eZ k' θ := by
  rw [eZ, eZ, eZ, ← e_add]
  congr 1
  push_cast
  ring

lemma norm_eZ (k : ℤ) (θ : ℝ) : ‖eZ k θ‖ = 1 := norm_e _

lemma conj_eZ (k : ℤ) (θ : ℝ) : conj (eZ k θ) = eZ (-k) θ := by
  rw [eZ, eZ, e, e, ← Complex.exp_conj]
  congr 1
  simp only [map_mul, Complex.conj_ofReal, Complex.conj_I, map_ofNat]
  push_cast
  ring

/-! ### The truncated Hilbert kernel (Lemma 2.1) -/

/-- The truncated Hilbert kernel `K(θ) = -2 ∑_{n=1}^{N-1} sin(2 π n θ)` of (2.2). -/
def hilbertKernel (N : ℕ) (θ : ℝ) : ℝ :=
  -2 * ∑ n ∈ Finset.Ico 1 N, Real.sin (2 * π * n * θ)

/-- The kernel written through the characters `e`: `K(θ) = i ∑_{n=1}^{N-1} (e(nθ) - e(-nθ))`. -/
lemma hilbertKernel_eq_sum_e (N : ℕ) (θ : ℝ) :
    (hilbertKernel N θ : ℂ) = I * ∑ n ∈ Finset.Ico 1 N, (e (n * θ) - e (-(n * θ))) := by
  have hsin : ∀ n : ℕ, e (n * θ) - e (-(n * θ))
      = 2 * I * (Real.sin (2 * π * n * θ) : ℂ) := by
    intro n
    have h1 : e (n * θ) = Complex.exp ((2 * π * n * θ : ℝ) * I) := by
      rw [e]; congr 1; push_cast; ring
    have h2 : e (-(n * θ)) = Complex.exp ((-(2 * π * n * θ) : ℝ) * I) := by
      rw [e]; congr 1; push_cast; ring
    rw [h1, h2, Complex.exp_mul_I, Complex.exp_mul_I]
    push_cast
    rw [Complex.cos_neg, Complex.sin_neg]
    ring
  have hI : (I : ℂ) * (2 * I) = -2 := by
    rw [show (I : ℂ) * (2 * I) = 2 * (I * I) by ring, Complex.I_mul_I]; ring
  have hsum : ∑ n ∈ Finset.Ico 1 N, (e (n * θ) - e (-(n * θ)))
      = 2 * I * ∑ n ∈ Finset.Ico 1 N, (Real.sin (2 * π * n * θ) : ℂ) := by
    rw [Finset.mul_sum]
    exact Finset.sum_congr rfl fun n _ ↦ hsin n
  rw [hsum, ← mul_assoc, hI, hilbertKernel]
  simp only [Complex.ofReal_mul, Complex.ofReal_sum, Complex.ofReal_neg, Complex.ofReal_ofNat]

/-- **Lemma 2.1**, identity (2.3): for every integer `n` with `|n| < N`,
`∫₀¹ K(θ) e(nθ) dθ = -i sgn(n)`, where `sgn 0 = 0`. -/
theorem integral_hilbertKernel_mul_eZ (N : ℕ) (n : ℤ) (hn : n.natAbs < N) :
    (∫ θ in (0:ℝ)..1, (hilbertKernel N θ : ℂ) * eZ n θ) = -I * (n.sign : ℂ) := by
  -- rewrite the integrand as a finite sum of characters
  have key : ∀ θ : ℝ, (hilbertKernel N θ : ℂ) * eZ n θ
      = I * ∑ m ∈ Finset.Ico 1 N, (eZ ((m : ℤ) + n) θ - eZ (n - (m : ℤ)) θ) := by
    intro θ
    rw [hilbertKernel_eq_sum_e, mul_assoc, Finset.sum_mul]
    congr 1
    refine Finset.sum_congr rfl fun m _ ↦ ?_
    rw [sub_mul]
    congr 1
    · rw [eZ, eZ, ← e_add]; congr 1; push_cast; ring
    · rw [eZ, eZ, ← e_add]; congr 1; push_cast; ring
  simp only [key]
  rw [intervalIntegral.integral_const_mul,
    intervalIntegral.integral_finsetSum (s := Finset.Ico 1 N)
      (f := fun (m : ℕ) (θ : ℝ) ↦ eZ ((m : ℤ) + n) θ - eZ (n - (m : ℤ)) θ)
      (fun m _ ↦ (intervalIntegrable_eZ ((m : ℤ) + n) 0 1).sub
        (intervalIntegrable_eZ (n - (m : ℤ)) 0 1))]
  have hterm : ∀ m ∈ Finset.Ico 1 N,
      (∫ θ in (0:ℝ)..1, (eZ ((m : ℤ) + n) θ - eZ (n - (m : ℤ)) θ))
        = (if (m : ℤ) + n = 0 then (1:ℂ) else 0) - (if n - (m : ℤ) = 0 then (1:ℂ) else 0) := by
    intro m _
    rw [intervalIntegral.integral_sub (intervalIntegrable_eZ _ 0 1)
      (intervalIntegrable_eZ _ 0 1), integral_eZ, integral_eZ]
  rw [Finset.sum_congr rfl hterm, Finset.sum_sub_distrib]
  -- the two indicator sums count `m = -n` and `m = n` respectively
  have hneg : (∑ m ∈ Finset.Ico 1 N, if (m : ℤ) + n = 0 then (1:ℂ) else 0)
      = if n < 0 then 1 else 0 := by
    by_cases h : n < 0
    · have hmem : n.natAbs ∈ Finset.Ico 1 N := Finset.mem_Ico.mpr ⟨by omega, hn⟩
      rw [if_pos h,
        Finset.sum_eq_single_of_mem n.natAbs hmem (fun b _ hb ↦ if_neg (by omega)),
        if_pos (by omega)]
    · rw [if_neg h, Finset.sum_eq_zero]
      intro m hm
      have := (Finset.mem_Ico.mp hm).1
      exact if_neg (by omega)
  have hpos : (∑ m ∈ Finset.Ico 1 N, if n - (m : ℤ) = 0 then (1:ℂ) else 0)
      = if 0 < n then 1 else 0 := by
    by_cases h : 0 < n
    · have hmem : n.natAbs ∈ Finset.Ico 1 N := Finset.mem_Ico.mpr ⟨by omega, hn⟩
      rw [if_pos h,
        Finset.sum_eq_single_of_mem n.natAbs hmem (fun b _ hb ↦ if_neg (by omega)),
        if_pos (by omega)]
    · rw [if_neg h, Finset.sum_eq_zero]
      intro m hm
      have := (Finset.mem_Ico.mp hm).1
      exact if_neg (by omega)
  rw [hneg, hpos]
  rcases lt_trichotomy n 0 with h | h | h
  · rw [if_pos h, if_neg (by omega), Int.sign_eq_neg_one_of_neg h]
    push_cast
    ring
  · subst h
    simp
  · rw [if_neg (by omega), if_pos h, Int.sign_eq_one_of_pos h]
    push_cast
    ring

/-! ### The `L^1` norm of the kernel, (2.4) -/

/-- The kernel is continuous. -/
lemma continuous_hilbertKernel (N : ℕ) : Continuous (hilbertKernel N) := by
  unfold hilbertKernel
  fun_prop

/-- Reflection symmetry `K(1 - θ) = -K(θ)`. -/
lemma hilbertKernel_one_sub (N : ℕ) (θ : ℝ) :
    hilbertKernel N (1 - θ) = -hilbertKernel N θ := by
  have h : ∀ n : ℕ, Real.sin (2 * π * n * (1 - θ)) = -Real.sin (2 * π * n * θ) := by
    intro n
    have h1 : 2 * π * n * (1 - θ) = n * (2 * π) - 2 * π * n * θ := by ring
    rw [h1, Real.sin_nat_mul_two_pi_sub]
  unfold hilbertKernel
  simp only [h, Finset.sum_neg_distrib, mul_neg]

/-- The kernel is the imaginary part of a geometric sum of characters. -/
lemma hilbertKernel_eq_neg_two_mul_im (N : ℕ) (θ : ℝ) :
    hilbertKernel N θ = -2 * (∑ n ∈ Finset.Ico 1 N, e (n * θ)).im := by
  unfold hilbertKernel
  rw [Complex.im_sum]
  congr 1
  refine Finset.sum_congr rfl fun n _ ↦ ?_
  rw [e, show (2 : ℂ) * ↑π * I * ((n : ℝ) * θ : ℝ) = ((2 * π * n * θ : ℝ) : ℂ) * I by
    push_cast; ring, Complex.exp_ofReal_mul_I_im]

/-- Crude bound: `|K(θ)| ≤ 2 N`. -/
lemma abs_hilbertKernel_le (N : ℕ) (θ : ℝ) : |hilbertKernel N θ| ≤ 2 * N := by
  unfold hilbertKernel
  rw [abs_mul, abs_neg, abs_two]
  gcongr
  calc |∑ n ∈ Finset.Ico 1 N, Real.sin (2 * π * n * θ)|
      ≤ ∑ n ∈ Finset.Ico 1 N, |Real.sin (2 * π * n * θ)| := Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ _n ∈ Finset.Ico 1 N, (1 : ℝ) :=
        Finset.sum_le_sum fun n _ ↦ Real.abs_sin_le_one _
    _ ≤ N := by simp [Nat.card_Ico]

/-- `‖e θ - 1‖ = 2 |sin(π θ)|`. -/
lemma norm_e_sub_one (θ : ℝ) : ‖e θ - 1‖ = 2 * |Real.sin (π * θ)| := by
  have he : e θ = Complex.exp ((2 * π * θ : ℝ) * I) := by
    rw [e]; congr 1; push_cast; ring
  have hs : Real.sin (2 * π * θ) = 2 * Real.sin (π * θ) * Real.cos (π * θ) := by
    rw [show 2 * π * θ = 2 * (π * θ) by ring, Real.sin_two_mul]
  have hc : Real.cos (2 * π * θ) = Real.cos (π * θ) ^ 2 - Real.sin (π * θ) ^ 2 := by
    rw [show 2 * π * θ = 2 * (π * θ) by ring, Real.cos_two_mul']
  have hpy := Real.sin_sq_add_cos_sq (π * θ)
  rw [he, Complex.norm_def, Complex.normSq_apply]
  simp only [Complex.sub_re, Complex.sub_im, Complex.one_re, Complex.one_im,
    Complex.exp_ofReal_mul_I_re, Complex.exp_ofReal_mul_I_im, sub_zero]
  have hsq : (Real.cos (2 * π * θ) - 1) * (Real.cos (2 * π * θ) - 1)
      + Real.sin (2 * π * θ) * Real.sin (2 * π * θ) = (2 * |Real.sin (π * θ)|) ^ 2 := by
    rw [hs, hc, mul_pow, sq_abs]
    nlinarith [hpy]
  rw [hsq, Real.sqrt_sq (by positivity)]

/-- Geometric-series bound: `|K(θ)| ≤ 2 / |sin(π θ)|`. -/
lemma abs_hilbertKernel_le_div_abs_sin (N : ℕ) {θ : ℝ} (hθ : Real.sin (π * θ) ≠ 0) :
    |hilbertKernel N θ| ≤ 2 / |Real.sin (π * θ)| := by
  have habs : (0 : ℝ) < |Real.sin (π * θ)| := abs_pos.mpr hθ
  rcases Nat.eq_zero_or_pos N with hN | hN
  · subst hN
    have h0 : hilbertKernel 0 θ = 0 := by simp [hilbertKernel]
    rw [h0, abs_zero]
    positivity
  -- write the sum of characters as a geometric sum
  have hz1 : e θ - 1 ≠ 0 := by
    intro h
    have hn := norm_e_sub_one θ
    rw [h, norm_zero] at hn
    exact hθ (abs_eq_zero.mp (by linarith))
  have hzne : e θ ≠ 1 := fun h ↦ hz1 (by rw [h, sub_self])
  have hpow : ∀ n : ℕ, e (n * θ) = e θ ^ n := by
    intro n
    rw [e, e, ← Complex.exp_nat_mul]
    congr 1
    push_cast
    ring
  have hsum : ∑ n ∈ Finset.Ico 1 N, e (n * θ) = (e θ ^ N - e θ ^ 1) / (e θ - 1) := by
    simp only [hpow]
    exact geom_sum_Ico hzne hN
  have hnorm : ‖∑ n ∈ Finset.Ico 1 N, e (n * θ)‖ ≤ 1 / |Real.sin (π * θ)| := by
    have h1 : ‖e θ ^ N - e θ ^ 1‖ ≤ 2 := by
      refine (norm_sub_le _ _).trans ?_
      simp only [norm_pow, norm_e, one_pow]
      norm_num
    rw [hsum, norm_div, norm_e_sub_one]
    calc ‖e θ ^ N - e θ ^ 1‖ / (2 * |Real.sin (π * θ)|)
        ≤ 2 / (2 * |Real.sin (π * θ)|) := by gcongr
      _ = 1 / |Real.sin (π * θ)| := by field_simp
  calc |hilbertKernel N θ|
      = 2 * |(∑ n ∈ Finset.Ico 1 N, e (n * θ)).im| := by
        rw [hilbertKernel_eq_neg_two_mul_im, abs_mul]
        norm_num
    _ ≤ 2 * ‖∑ n ∈ Finset.Ico 1 N, e (n * θ)‖ := by
        gcongr
        exact Complex.abs_im_le_norm _
    _ ≤ 2 * (1 / |Real.sin (π * θ)|) := by gcongr
    _ = 2 / |Real.sin (π * θ)| := by ring

/-- The quantity `A_N = ∫₀¹ |K(θ)| dθ` of Lemma 2.1. -/
def hilbertKernelL1 (N : ℕ) : ℝ := ∫ θ in (0:ℝ)..1, |hilbertKernel N θ|

lemma intervalIntegrable_abs_hilbertKernel (N : ℕ) (a b : ℝ) :
    IntervalIntegrable (fun θ ↦ |hilbertKernel N θ|) volume a b :=
  ((continuous_hilbertKernel N).abs).intervalIntegrable _ _

lemma hilbertKernelL1_nonneg (N : ℕ) : 0 ≤ hilbertKernelL1 N := by
  refine intervalIntegral.integral_nonneg (by norm_num) fun θ _ ↦ abs_nonneg _

/-- Reflection halves the integral: `∫_{1/2}^1 |K| = ∫_0^{1/2} |K|`. -/
lemma integral_abs_hilbertKernel_symm (N : ℕ) :
    (∫ θ in (1/2 : ℝ)..1, |hilbertKernel N θ|) = ∫ θ in (0:ℝ)..(1/2 : ℝ),
      |hilbertKernel N θ| := by
  have h := intervalIntegral.integral_comp_sub_left
    (a := (0:ℝ)) (b := (1/2 : ℝ)) (fun θ ↦ |hilbertKernel N θ|) 1
  norm_num at h
  rw [← h]
  refine intervalIntegral.integral_congr fun θ _ ↦ ?_
  rw [hilbertKernel_one_sub, abs_neg]

/-- **Lemma 2.1**, estimate (2.4): `A_N ≤ 4 (1 + log N)`. -/
theorem hilbertKernelL1_le (N : ℕ) : hilbertKernelL1 N ≤ 4 * (1 + Real.log N) := by
  rcases lt_or_ge N 2 with hN | hN
  · -- `K` vanishes identically for `N ≤ 1`
    have h0 : ∀ θ : ℝ, hilbertKernel N θ = 0 := by
      intro θ
      have : Finset.Ico 1 N = ∅ := Finset.Ico_eq_empty (by omega)
      simp [hilbertKernel, this]
    have : hilbertKernelL1 N = 0 := by simp [hilbertKernelL1, h0]
    rw [this]
    have : (0:ℝ) ≤ Real.log N := Real.log_natCast_nonneg N
    linarith
  -- `N ≥ 2`
  have hN0 : (0:ℝ) < N := by positivity
  have hNle : (1:ℝ) / N ≤ 1 / 2 := by
    rw [div_le_div_iff_of_pos_left one_pos (by positivity) (by norm_num)]
    exact_mod_cast hN
  have hNpos : (0:ℝ) < 1 / N := by positivity
  -- split `[0,1]` at `1/2` and reflect
  have hsplit1 : hilbertKernelL1 N = 2 * ∫ θ in (0:ℝ)..(1/2 : ℝ), |hilbertKernel N θ| := by
    rw [hilbertKernelL1, ← intervalIntegral.integral_add_adjacent_intervals
      (b := (1/2 : ℝ)) (intervalIntegrable_abs_hilbertKernel N _ _)
      (intervalIntegrable_abs_hilbertKernel N _ _), integral_abs_hilbertKernel_symm]
    ring
  -- split `[0,1/2]` at `1/N`
  have hsplit2 : (∫ θ in (0:ℝ)..(1/2 : ℝ), |hilbertKernel N θ|)
      = (∫ θ in (0:ℝ)..(1/N : ℝ), |hilbertKernel N θ|)
        + ∫ θ in (1/N : ℝ)..(1/2 : ℝ), |hilbertKernel N θ| :=
    (intervalIntegral.integral_add_adjacent_intervals
      (intervalIntegrable_abs_hilbertKernel N _ _)
      (intervalIntegrable_abs_hilbertKernel N _ _)).symm
  -- near the origin use the crude bound `|K| ≤ 2N`
  have hnear : (∫ θ in (0:ℝ)..(1/N : ℝ), |hilbertKernel N θ|) ≤ 2 := by
    have := intervalIntegral.integral_mono_on (f := fun θ ↦ |hilbertKernel N θ|)
      (g := fun _ : ℝ ↦ 2 * (N : ℝ)) hNpos.le
      (intervalIntegrable_abs_hilbertKernel N _ _)
      (_root_.intervalIntegrable_const) (fun θ _ ↦ abs_hilbertKernel_le N θ)
    rw [intervalIntegral.integral_const, smul_eq_mul] at this
    refine this.trans ?_
    rw [sub_zero, show (1 / (N:ℝ)) * (2 * N) = 2 by field_simp]
  -- away from the origin use `|K(θ)| ≤ 1/θ`
  have hfar : (∫ θ in (1/N : ℝ)..(1/2 : ℝ), |hilbertKernel N θ|) ≤ Real.log N := by
    have hbound : ∀ θ ∈ Set.Icc (1/(N:ℝ)) (1/2 : ℝ), |hilbertKernel N θ| ≤ θ⁻¹ := by
      rintro θ ⟨hθ1, hθ2⟩
      have hθ0 : 0 < θ := lt_of_lt_of_le hNpos hθ1
      have hjordan : 2 * θ ≤ Real.sin (π * θ) := by
        have := Real.mul_le_sin (x := π * θ) (by positivity) (by nlinarith [Real.pi_pos])
        calc 2 * θ = 2 / π * (π * θ) := by field_simp
          _ ≤ Real.sin (π * θ) := this
      have hsinpos : 0 < Real.sin (π * θ) := lt_of_lt_of_le (by positivity) hjordan
      have := abs_hilbertKernel_le_div_abs_sin N hsinpos.ne'
      rw [abs_of_pos hsinpos] at this
      refine this.trans ?_
      have h2 : 2 / Real.sin (π * θ) ≤ 2 / (2 * θ) :=
        div_le_div_of_nonneg_left (by norm_num) (by positivity) hjordan
      rw [show (2:ℝ) / (2 * θ) = θ⁻¹ by field_simp] at h2
      exact h2
    have hmono := intervalIntegral.integral_mono_on (f := fun θ ↦ |hilbertKernel N θ|)
      (g := fun θ : ℝ ↦ θ⁻¹) hNle
      (intervalIntegrable_abs_hilbertKernel N _ _)
      ((intervalIntegral.intervalIntegrable_inv (fun x hx ↦ by
        rcases Set.mem_uIcc.mp hx with ⟨h1, _⟩ | ⟨h1, _⟩ <;> nlinarith)
        (by fun_prop))) hbound
    rw [integral_inv_of_pos hNpos (by norm_num)] at hmono
    refine hmono.trans ?_
