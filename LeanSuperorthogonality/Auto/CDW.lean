/-- The bilinear expansion of `|P_N(θ)(x)|^2`. -/
lemma normSq_phaseSum {N : ℕ} (f : Fin N → α → ℂ) (θ : ℝ) (x : α) :
    ‖phaseSum f θ x‖ ^ 2
      = ∑ n : Fin N, ∑ n' : Fin N,
          (eZ ((n : ℤ) - (n' : ℤ)) θ * (f n x * conj (f n' x))).re := by
  have hconj : ∀ n' : Fin N, conj (eZ ((n' : ℤ)) θ) = eZ (-(n' : ℤ)) θ :=
    fun n' ↦ conj_eZ _ _
  have hz : (‖phaseSum f θ x‖ ^ 2 : ℝ) = (phaseSum f θ x * conj (phaseSum f θ x)).re := by
    rw [Complex.mul_conj, Complex.ofReal_re, Complex.normSq_eq_norm_sq]
  rw [hz, phaseSum, map_sum, Finset.sum_mul_sum, Complex.re_sum]
  refine Finset.sum_congr rfl fun n _ ↦ ?_
  rw [Complex.re_sum]
  refine Finset.sum_congr rfl fun n' _ ↦ ?_
  congr 1
  rw [map_mul, hconj n', show ((n : ℤ) - (n' : ℤ)) = (n : ℤ) + (-(n' : ℤ)) by ring, eZ_add]
  ring

omit [MeasurableSpace α] in
/-- `S(x)^2 f_n(x) \overline{f_{n'}(x)}` written as a sum of quadruple products. -/
lemma sqFun_sq_mul_eq {N : ℕ} (f : Fin N → α → ℂ) (n n' : Fin N) (x : α) :
    ((sqFun f x ^ 2 : ℝ) : ℂ) * (f n x * conj (f n' x))
      = ∑ m, f m x * f n x * conj (f m x * f n' x) := by
  have hm : ∀ m : Fin N, ((‖f m x‖ ^ 2 : ℝ) : ℂ) = f m x * conj (f m x) := by
    intro m
    rw [Complex.mul_conj, Complex.normSq_eq_norm_sq]
  rw [sq_sqFun, Complex.ofReal_sum, Finset.sum_mul]
  refine Finset.sum_congr rfl fun m _ ↦ ?_
  rw [hm m, map_mul]
  ring

/-- The kernel moments `κ_k = ∫₀¹ |K(θ)| e(kθ) dθ`. -/
def kernelMoment (N : ℕ) (k : ℤ) : ℂ :=
  ∫ θ in (0:ℝ)..1, ((|hilbertKernel N θ| : ℝ) : ℂ) * eZ k θ

lemma continuous_absKernel_mul_eZ (N : ℕ) (k : ℤ) :
    Continuous fun θ : ℝ ↦ ((|hilbertKernel N θ| : ℝ) : ℂ) * eZ k θ :=
  (Complex.continuous_ofReal.comp ((continuous_hilbertKernel N).abs)).mul (continuous_eZ k)

/-- Pulling a constant through the weighted kernel integral. -/
lemma integral_weight_mul_re (N : ℕ) (k : ℤ) (z : ℂ) :
    (∫ θ in (0:ℝ)..1, |hilbertKernel N θ| * (eZ k θ * z).re)
      = (kernelMoment N k * z).re := by
  have h1 : ∀ θ : ℝ, |hilbertKernel N θ| * (eZ k θ * z).re
      = (((|hilbertKernel N θ| : ℝ) : ℂ) * eZ k θ * z).re := by
    intro θ
    rw [mul_assoc, ← Complex.re_ofReal_mul]
  have hint : IntervalIntegrable
      (fun θ : ℝ ↦ ((|hilbertKernel N θ| : ℝ) : ℂ) * eZ k θ * z) volume 0 1 :=
    ((continuous_absKernel_mul_eZ N k).mul continuous_const).intervalIntegrable _ _
  rw [intervalIntegral.integral_congr (fun θ _ ↦ h1 θ), intervalIntegral_re hint,
    intervalIntegral.integral_mul_const, kernelMoment]

omit [MeasurableSpace α] in
/-- The kernel average of `|P_N(θ)(x)|^2`, expanded bilinearly. -/
lemma integral_weight_normSq_phaseSum {N : ℕ} (f : Fin N → α → ℂ) (x : α) :
    (∫ θ in (0:ℝ)..1, |hilbertKernel N θ| * ‖phaseSum f θ x‖ ^ 2)
      = ∑ n : Fin N, ∑ n' : Fin N,
          (kernelMoment N ((n : ℤ) - (n' : ℤ)) * (f n x * conj (f n' x))).re := by
  have hcont : ∀ n n' : Fin N, Continuous fun θ : ℝ ↦
      |hilbertKernel N θ| * (eZ ((n : ℤ) - (n' : ℤ)) θ * (f n x * conj (f n' x))).re :=
    fun n n' ↦ ((continuous_hilbertKernel N).abs).mul
      (Complex.continuous_re.comp ((continuous_eZ _).mul continuous_const))
  have hcontsum : ∀ n : Fin N, Continuous fun θ : ℝ ↦ ∑ n' : Fin N,
      |hilbertKernel N θ| * (eZ ((n : ℤ) - (n' : ℤ)) θ * (f n x * conj (f n' x))).re :=
    fun n ↦ continuous_finsetSum _ fun n' _ ↦ hcont n n'
  have h1 : ∀ θ : ℝ, |hilbertKernel N θ| * ‖phaseSum f θ x‖ ^ 2
      = ∑ n : Fin N, ∑ n' : Fin N,
          |hilbertKernel N θ| * (eZ ((n : ℤ) - (n' : ℤ)) θ * (f n x * conj (f n' x))).re := by
    intro θ
    rw [normSq_phaseSum, Finset.mul_sum]
    exact Finset.sum_congr rfl fun n _ ↦ Finset.mul_sum _ _ _
  rw [intervalIntegral.integral_congr (fun θ _ ↦ h1 θ),
    intervalIntegral.integral_finsetSum (s := (Finset.univ : Finset (Fin N)))
      (f := fun (n : Fin N) (θ : ℝ) ↦ ∑ n' : Fin N,
        |hilbertKernel N θ| * (eZ ((n : ℤ) - (n' : ℤ)) θ * (f n x * conj (f n' x))).re)
      (fun n _ ↦ (hcontsum n).intervalIntegrable _ _)]
  refine Finset.sum_congr rfl fun n _ ↦ ?_
  rw [intervalIntegral.integral_finsetSum (s := (Finset.univ : Finset (Fin N)))
    (f := fun (n' : Fin N) (θ : ℝ) ↦
      |hilbertKernel N θ| * (eZ ((n : ℤ) - (n' : ℤ)) θ * (f n x * conj (f n' x))).re)
    (fun n' _ ↦ (hcont n n').intervalIntegrable _ _)]
  exact Finset.sum_congr rfl fun n' _ ↦ integral_weight_mul_re N _ _

/-- The bilinear coefficients `c_{n,n'} = ∫ S^2 f_n \overline{f_{n'}}`, written as a sum of
quadruple products so that no `L^p` theory beyond `integrable_quadruple` is needed. -/
def bilinC {N : ℕ} (μ : Measure α) (f : Fin N → α → ℂ) (n n' : Fin N) : ℂ :=
  ∫ x, ∑ m, f m x * f n x * conj (f m x * f n' x) ∂μ

lemma integrable_bilinIntegrand {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (hf : ∀ n, MemLp (f n) 4 μ) (n n' : Fin N) :
    Integrable (fun x ↦ ∑ m, f m x * f n x * conj (f m x * f n' x)) μ :=
  integrable_finsetSum _ fun m _ ↦ integrable_quadruple hf m n m n'

omit [MeasurableSpace α] in
lemma sqFun_sq_mul_re_eq {N : ℕ} (f : Fin N → α → ℂ) (w : ℂ) (n n' : Fin N) (x : α) :
    sqFun f x ^ 2 * (w * (f n x * conj (f n' x))).re
      = (w * ∑ m, f m x * f n x * conj (f m x * f n' x)).re := by
  rw [← sqFun_sq_mul_eq f n n' x, ← Complex.re_ofReal_mul]
  congr 1
  ring

lemma integrable_sqFun_sq_mul_re {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (hf : ∀ n, MemLp (f n) 4 μ) (w : ℂ) (n n' : Fin N) :
    Integrable (fun x ↦ sqFun f x ^ 2 * (w * (f n x * conj (f n' x))).re) μ := by
  have h := ((integrable_bilinIntegrand hf n n').const_mul w).re
  exact h.congr (Filter.Eventually.of_forall fun x ↦ (sqFun_sq_mul_re_eq f w n n' x).symm)

/-- A scalar passes through the `x`-integral against `S^2`. -/
lemma integral_sqFun_sq_mul_re {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (hf : ∀ n, MemLp (f n) 4 μ) (w : ℂ) (n n' : Fin N) :
    (∫ x, sqFun f x ^ 2 * (w * (f n x * conj (f n' x))).re ∂μ)
      = (w * bilinC μ f n n').re := by
  rw [integral_congr_ae (Filter.Eventually.of_forall fun x ↦ sqFun_sq_mul_re_eq f w n n' x),
    show (∫ x, (w * ∑ m, f m x * f n x * conj (f m x * f n' x)).re ∂μ)
        = (∫ x, w * ∑ m, f m x * f n x * conj (f m x * f n' x) ∂μ).re from
      _root_.integral_re ((integrable_bilinIntegrand hf n n').const_mul w),
    MeasureTheory.integral_const_mul, bilinC]

/-- **First side of the interchange**: integrate the kernel average against `S^2`. -/
lemma interchange_left {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (hf : ∀ n, MemLp (f n) 4 μ) :
    (∫ x, sqFun f x ^ 2 *
        (∫ θ in (0:ℝ)..1, |hilbertKernel N θ| * ‖phaseSum f θ x‖ ^ 2) ∂μ)
      = ∑ n : Fin N, ∑ n' : Fin N,
          (kernelMoment N ((n : ℤ) - (n' : ℤ)) * bilinC μ f n n').re := by
  have h1 : ∀ x : α, sqFun f x ^ 2 *
      (∫ θ in (0:ℝ)..1, |hilbertKernel N θ| * ‖phaseSum f θ x‖ ^ 2)
      = ∑ n : Fin N, ∑ n' : Fin N, sqFun f x ^ 2 *
          (kernelMoment N ((n : ℤ) - (n' : ℤ)) * (f n x * conj (f n' x))).re := by
    intro x
    rw [integral_weight_normSq_phaseSum, Finset.mul_sum]
    exact Finset.sum_congr rfl fun n _ ↦ Finset.mul_sum _ _ _
  rw [integral_congr_ae (Filter.Eventually.of_forall h1),
    integral_finsetSum _ (fun n _ ↦ integrable_finsetSum _
      fun n' _ ↦ integrable_sqFun_sq_mul_re hf _ n n')]
  refine Finset.sum_congr rfl fun n _ ↦ ?_
  rw [integral_finsetSum _ (fun n' _ ↦ integrable_sqFun_sq_mul_re hf _ n n')]
  exact Finset.sum_congr rfl fun n' _ ↦ integral_sqFun_sq_mul_re hf _ n n'

/-- The `x`-integral of `S^2 |P_N(θ)|^2`, expanded bilinearly. -/
lemma integral_sqFun_sq_normSq_phaseSum {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (hf : ∀ n, MemLp (f n) 4 μ) (θ : ℝ) :
    (∫ x, sqFun f x ^ 2 * ‖phaseSum f θ x‖ ^ 2 ∂μ)
      = ∑ n : Fin N, ∑ n' : Fin N,
          (eZ ((n : ℤ) - (n' : ℤ)) θ * bilinC μ f n n').re := by
  have h1 : ∀ x : α, sqFun f x ^ 2 * ‖phaseSum f θ x‖ ^ 2
      = ∑ n : Fin N, ∑ n' : Fin N, sqFun f x ^ 2 *
          (eZ ((n : ℤ) - (n' : ℤ)) θ * (f n x * conj (f n' x))).re := by
    intro x
    rw [normSq_phaseSum, Finset.mul_sum]
    exact Finset.sum_congr rfl fun n _ ↦ Finset.mul_sum _ _ _
  rw [integral_congr_ae (Filter.Eventually.of_forall h1),
    integral_finsetSum _ (fun n _ ↦ integrable_finsetSum _
      fun n' _ ↦ integrable_sqFun_sq_mul_re hf _ n n')]
  refine Finset.sum_congr rfl fun n _ ↦ ?_
  rw [integral_finsetSum _ (fun n' _ ↦ integrable_sqFun_sq_mul_re hf _ n n')]
  exact Finset.sum_congr rfl fun n' _ ↦ integral_sqFun_sq_mul_re hf _ n n'

/-- **Second side of the interchange**: integrate the `x`-integral against the kernel. -/
lemma interchange_right {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (hf : ∀ n, MemLp (f n) 4 μ) :
    (∫ θ in (0:ℝ)..1, |hilbertKernel N θ| * ∫ x, sqFun f x ^ 2 * ‖phaseSum f θ x‖ ^ 2 ∂μ)
      = ∑ n : Fin N, ∑ n' : Fin N,
          (kernelMoment N ((n : ℤ) - (n' : ℤ)) * bilinC μ f n n').re := by
  have hcont : ∀ n n' : Fin N, Continuous fun θ : ℝ ↦
      |hilbertKernel N θ| * (eZ ((n : ℤ) - (n' : ℤ)) θ * bilinC μ f n n').re :=
    fun n n' ↦ ((continuous_hilbertKernel N).abs).mul
      (Complex.continuous_re.comp ((continuous_eZ _).mul continuous_const))
  have hcontsum : ∀ n : Fin N, Continuous fun θ : ℝ ↦ ∑ n' : Fin N,
      |hilbertKernel N θ| * (eZ ((n : ℤ) - (n' : ℤ)) θ * bilinC μ f n n').re :=
    fun n ↦ continuous_finsetSum _ fun n' _ ↦ hcont n n'
  have h1 : ∀ θ : ℝ,
      |hilbertKernel N θ| * (∫ x, sqFun f x ^ 2 * ‖phaseSum f θ x‖ ^ 2 ∂μ)
      = ∑ n : Fin N, ∑ n' : Fin N,
          |hilbertKernel N θ| * (eZ ((n : ℤ) - (n' : ℤ)) θ * bilinC μ f n n').re := by
    intro θ
    rw [integral_sqFun_sq_normSq_phaseSum hf, Finset.mul_sum]
    exact Finset.sum_congr rfl fun n _ ↦ Finset.mul_sum _ _ _
  rw [intervalIntegral.integral_congr (fun θ _ ↦ h1 θ),
    intervalIntegral.integral_finsetSum (s := (Finset.univ : Finset (Fin N)))
      (f := fun (n : Fin N) (θ : ℝ) ↦ ∑ n' : Fin N,
        |hilbertKernel N θ| * (eZ ((n : ℤ) - (n' : ℤ)) θ * bilinC μ f n n').re)
      (fun n _ ↦ (hcontsum n).intervalIntegrable _ _)]
  refine Finset.sum_congr rfl fun n _ ↦ ?_
  rw [intervalIntegral.integral_finsetSum (s := (Finset.univ : Finset (Fin N)))
    (f := fun (n' : Fin N) (θ : ℝ) ↦
      |hilbertKernel N θ| * (eZ ((n : ℤ) - (n' : ℤ)) θ * bilinC μ f n n').re)
    (fun n' _ ↦ (hcont n n').intervalIntegrable _ _)]
  exact Finset.sum_congr rfl fun n' _ ↦ integral_weight_mul_re N _ _

/-- **The interchange.** No Fubini is used, so `μ` need not be sigma-finite. -/
theorem interchange {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (hf : ∀ n, MemLp (f n) 4 μ) :
    (∫ x, sqFun f x ^ 2 *
        (∫ θ in (0:ℝ)..1, |hilbertKernel N θ| * ‖phaseSum f θ x‖ ^ 2) ∂μ)
      = ∫ θ in (0:ℝ)..1, |hilbertKernel N θ| *
          ∫ x, sqFun f x ^ 2 * ‖phaseSum f θ x‖ ^ 2 ∂μ := by
  rw [interchange_left hf, interchange_right hf]

/-! ### The estimate (2.8) -/

omit [MeasurableSpace α] in
lemma continuous_phaseSum {N : ℕ} (f : Fin N → α → ℂ) (x : α) :
    Continuous fun θ : ℝ ↦ phaseSum f θ x :=
  continuous_finsetSum _ fun _ _ ↦ (continuous_eZ _).mul continuous_const

omit [MeasurableSpace α] in
/-- Combining the kernel representation with weighted Cauchy-Schwarz. -/
lemma normSq_signedSum_le {N : ℕ} (f : Fin N → α → ℂ) (m : Fin N) (x : α) :
    ‖signedSum f m x‖ ^ 2
      ≤ hilbertKernelL1 N *
          ∫ θ in (0:ℝ)..1, |hilbertKernel N θ| * ‖phaseSum f θ x‖ ^ 2 := by
  have h1 := norm_signedSum_le f m x
  have h2 := sq_integral_weighted_le (w := fun θ ↦ |hilbertKernel N θ|)
    (g := fun θ ↦ ‖phaseSum f θ x‖) ((continuous_hilbertKernel N).abs)
    ((continuous_phaseSum f x).norm) fun θ ↦ abs_nonneg _
  calc ‖signedSum f m x‖ ^ 2
      ≤ (∫ θ in (0:ℝ)..1, |hilbertKernel N θ| * ‖phaseSum f θ x‖) ^ 2 :=
        pow_le_pow_left₀ (norm_nonneg _) h1 2
    _ ≤ hilbertKernelL1 N *
          ∫ θ in (0:ℝ)..1, |hilbertKernel N θ| * ‖phaseSum f θ x‖ ^ 2 := h2

omit [MeasurableSpace α] in
/-- The bound of (2.6) is dominated by the kernel average. -/
lemma sum_normSq_mul_normSq_signedSum_le {N : ℕ} (f : Fin N → α → ℂ) (x : α) :
    (∑ m, ‖f m x‖ ^ 2 * ‖signedSum f m x‖ ^ 2)
      ≤ hilbertKernelL1 N * (sqFun f x ^ 2 *
          ∫ θ in (0:ℝ)..1, |hilbertKernel N θ| * ‖phaseSum f θ x‖ ^ 2) := by
  have hstep : ∀ m : Fin N, ‖f m x‖ ^ 2 * ‖signedSum f m x‖ ^ 2
      ≤ ‖f m x‖ ^ 2 * (hilbertKernelL1 N *
          ∫ θ in (0:ℝ)..1, |hilbertKernel N θ| * ‖phaseSum f θ x‖ ^ 2) := by
    intro m
    exact mul_le_mul_of_nonneg_left (normSq_signedSum_le f m x) (by positivity)
  calc (∑ m, ‖f m x‖ ^ 2 * ‖signedSum f m x‖ ^ 2)
      ≤ ∑ m, ‖f m x‖ ^ 2 * (hilbertKernelL1 N *
          ∫ θ in (0:ℝ)..1, |hilbertKernel N θ| * ‖phaseSum f θ x‖ ^ 2) :=
        Finset.sum_le_sum fun m _ ↦ hstep m
    _ = hilbertKernelL1 N * (sqFun f x ^ 2 *
          ∫ θ in (0:ℝ)..1, |hilbertKernel N θ| * ‖phaseSum f θ x‖ ^ 2) := by
        rw [← Finset.sum_mul, sq_sqFun]
        ring

omit [MeasurableSpace α] in
lemma norm_signedSum_le_sum {N : ℕ} (f : Fin N → α → ℂ) (m : Fin N) (x : α) :
    ‖signedSum f m x‖ ≤ ∑ n, ‖f n x‖ := by
  refine (norm_sub_le _ _).trans ?_
  have h1 : ‖∑ n ∈ Finset.univ.filter (· < m), f n x‖
      ≤ ∑ n ∈ Finset.univ.filter (· < m), ‖f n x‖ := norm_sum_le _ _
  have h2 : ‖∑ n ∈ Finset.univ.filter (m < ·), f n x‖
      ≤ ∑ n ∈ Finset.univ.filter (m < ·), ‖f n x‖ := norm_sum_le _ _
  have h3 : (∑ n ∈ Finset.univ.filter (fun n ↦ n < m), ‖f n x‖)
      + ∑ n ∈ Finset.univ.filter (fun n ↦ m < n), ‖f n x‖ ≤ ∑ n, ‖f n x‖ := by
    rw [← Finset.sum_union]
    · refine Finset.sum_le_sum_of_subset_of_nonneg (Finset.subset_univ _) ?_
      exact fun _ _ _ ↦ norm_nonneg _
    · refine Finset.disjoint_filter.mpr fun n _ hn ↦ ?_
      exact fun h ↦ absurd (hn.trans h) (lt_irrefl n)
  linarith

/-- Measurability of a finite sum of functions. -/
lemma aestronglyMeasurable_finsetSum {ι : Type*} (s : Finset ι) {μ : Measure α}
    {g : ι → α → ℂ} (hg : ∀ i ∈ s, AEStronglyMeasurable (g i) μ) :
    AEStronglyMeasurable (fun x ↦ ∑ i ∈ s, g i x) μ := by
  have heq : (∑ i ∈ s, g i) = fun x ↦ ∑ i ∈ s, g i x := by
    funext x
    simp
  rw [← heq]
  exact Finset.aestronglyMeasurable_sum s hg

lemma aestronglyMeasurable_signedSum {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (hf : ∀ n, MemLp (f n) 4 μ) (m : Fin N) :
    AEStronglyMeasurable (fun x ↦ signedSum f m x) μ := by
  unfold signedSum
  exact (aestronglyMeasurable_finsetSum _ fun n _ ↦ (hf n).aestronglyMeasurable).sub
    (aestronglyMeasurable_finsetSum _ fun n _ ↦ (hf n).aestronglyMeasurable)

lemma integrable_normSq_mul_normSq_signedSum {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (hf : ∀ n, MemLp (f n) 4 μ) (m : Fin N) :
    Integrable (fun x ↦ ‖f m x‖ ^ 2 * ‖signedSum f m x‖ ^ 2) μ := by
  have hbound : Integrable (fun x ↦ ∑ n, ∑ n',
      ‖f m x‖ * ‖f m x‖ * (‖f n x‖ * ‖f n' x‖)) μ :=
    integrable_finsetSum _ fun n _ ↦ integrable_finsetSum _ fun n' _ ↦
      integrable_norm_mul₄ hf m m n n'
  have hmeas : AEStronglyMeasurable
      (fun x ↦ ‖f m x‖ ^ 2 * ‖signedSum f m x‖ ^ 2) μ :=
    (((hf m).aestronglyMeasurable.norm).pow 2).mul
      (((aestronglyMeasurable_signedSum hf m).norm).pow 2)
  refine Integrable.mono' hbound hmeas (Filter.Eventually.of_forall fun x ↦ ?_)
  rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]
  have hW := norm_signedSum_le_sum f m x
  have hexp : (∑ n, ∑ n', ‖f m x‖ * ‖f m x‖ * (‖f n x‖ * ‖f n' x‖))
      = ‖f m x‖ * ‖f m x‖ * (∑ n, ‖f n x‖) ^ 2 := by
    rw [sq, Finset.sum_mul_sum, Finset.mul_sum]
    refine Finset.sum_congr rfl fun n _ ↦ ?_
    rw [Finset.mul_sum]
  rw [hexp]
  have hsq := pow_le_pow_left₀ (norm_nonneg (signedSum f m x)) hW 2
  calc ‖f m x‖ ^ 2 * ‖signedSum f m x‖ ^ 2
      ≤ ‖f m x‖ ^ 2 * (∑ n, ‖f n x‖) ^ 2 := by gcongr
    _ = ‖f m x‖ * ‖f m x‖ * (∑ n, ‖f n x‖) ^ 2 := by ring

lemma integrable_sqFun_sq_mul_kernelAvg {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (hf : ∀ n, MemLp (f n) 4 μ) :
    Integrable (fun x ↦ sqFun f x ^ 2 *
      ∫ θ in (0:ℝ)..1, |hilbertKernel N θ| * ‖phaseSum f θ x‖ ^ 2) μ := by
  have h1 : ∀ x : α, sqFun f x ^ 2 *
      (∫ θ in (0:ℝ)..1, |hilbertKernel N θ| * ‖phaseSum f θ x‖ ^ 2)
      = ∑ n : Fin N, ∑ n' : Fin N, sqFun f x ^ 2 *
          (kernelMoment N ((n : ℤ) - (n' : ℤ)) * (f n x * conj (f n' x))).re := by
    intro x
    rw [integral_weight_normSq_phaseSum, Finset.mul_sum]
    exact Finset.sum_congr rfl fun n _ ↦ Finset.mul_sum _ _ _
  rw [funext h1]
  exact integrable_finsetSum _ fun n _ ↦ integrable_finsetSum _ fun n' _ ↦
    integrable_sqFun_sq_mul_re hf _ n n'

lemma continuous_kernel_mul_spaceIntegral {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (hf : ∀ n, MemLp (f n) 4 μ) :
    Continuous fun θ : ℝ ↦ |hilbertKernel N θ| *
      ∫ x, sqFun f x ^ 2 * ‖phaseSum f θ x‖ ^ 2 ∂μ := by
  have h1 : (fun θ : ℝ ↦ |hilbertKernel N θ| *
      ∫ x, sqFun f x ^ 2 * ‖phaseSum f θ x‖ ^ 2 ∂μ)
      = fun θ : ℝ ↦ |hilbertKernel N θ| * ∑ n : Fin N, ∑ n' : Fin N,
          (eZ ((n : ℤ) - (n' : ℤ)) θ * bilinC μ f n n').re := by
    funext θ
    rw [integral_sqFun_sq_normSq_phaseSum hf]
  rw [h1]
  exact ((continuous_hilbertKernel N).abs).mul
    (continuous_finsetSum _ fun n _ ↦ continuous_finsetSum _ fun n' _ ↦
      Complex.continuous_re.comp ((continuous_eZ _).mul continuous_const))

/-- **Estimate (2.8) of Lemma 2.2**: `‖V‖_2^2 ≤ 4 A_N^2 M^2 ‖S‖_4^2`. -/
theorem estimate_2_8 {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (hf : OrderedSuperorthogonal μ f) :
    ∫ x, bigV f x ^ 2 ∂μ
      ≤ 4 * (hilbertKernelL1 N ^ 2 * (bestConst μ f ^ 2 * nrmS μ f ^ 2)) := by
  have hA : 0 ≤ hilbertKernelL1 N := hilbertKernelL1_nonneg N
  have hRow := integrable_sum_sq_rowSum hf.memLp
  have hWsum : Integrable (fun x ↦ ∑ m, ‖f m x‖ ^ 2 * ‖signedSum f m x‖ ^ 2) μ :=
    integrable_finsetSum _ fun m _ ↦ integrable_normSq_mul_normSq_signedSum hf.memLp m
  have hAvg := integrable_sqFun_sq_mul_kernelAvg hf.memLp
  -- (2.6) and the pointwise bound on the row sums
  have step1 : (∫ x, ∑ m, rowSum f m x ^ 2 ∂μ)
      ≤ ∫ x, ∑ m, ‖f m x‖ ^ 2 * ‖signedSum f m x‖ ^ 2 ∂μ :=
    integral_mono hRow hWsum fun x ↦
      Finset.sum_le_sum fun m _ ↦ sq_rowSum_le f m x
  -- the kernel representation and weighted Cauchy-Schwarz
  have step2 : (∫ x, ∑ m, ‖f m x‖ ^ 2 * ‖signedSum f m x‖ ^ 2 ∂μ)
      ≤ hilbertKernelL1 N * ∫ x, sqFun f x ^ 2 *
          (∫ θ in (0:ℝ)..1, |hilbertKernel N θ| * ‖phaseSum f θ x‖ ^ 2) ∂μ := by
    rw [← MeasureTheory.integral_const_mul]
    exact integral_mono hWsum (hAvg.const_mul _) fun x ↦
      sum_normSq_mul_normSq_signedSum_le f x
  -- the interchange and Hölder
  have step3 : (∫ x, sqFun f x ^ 2 *
        (∫ θ in (0:ℝ)..1, |hilbertKernel N θ| * ‖phaseSum f θ x‖ ^ 2) ∂μ)
      ≤ hilbertKernelL1 N * (bestConst μ f ^ 2 * nrmS μ f ^ 2) := by
    rw [interchange hf.memLp]
    have hbound : ∀ θ ∈ Set.Icc (0:ℝ) 1,
        |hilbertKernel N θ| * (∫ x, sqFun f x ^ 2 * ‖phaseSum f θ x‖ ^ 2 ∂μ)
          ≤ |hilbertKernel N θ| * (nrmS μ f ^ 2 * bestConst μ f ^ 2) := by
      intro θ _
      refine mul_le_mul_of_nonneg_left ?_ (abs_nonneg _)
      refine (integral_sqFun_sq_mul_le hf.memLp
        (memLp_phaseCombination hf.memLp fun n ↦ eZ (n : ℤ) θ)).trans ?_
      refine mul_le_mul_of_nonneg_left ?_ (by positivity)
      have h := nrm4_phaseSum_le hf.memLp θ
      have h0 := nrm4_nonneg μ (phaseSum f θ)
      exact pow_le_pow_left₀ h0 h 2
    have hi1 : IntervalIntegrable (fun θ : ℝ ↦ |hilbertKernel N θ| *
        ∫ x, sqFun f x ^ 2 * ‖phaseSum f θ x‖ ^ 2 ∂μ) volume 0 1 :=
      (continuous_kernel_mul_spaceIntegral hf.memLp).intervalIntegrable _ _
    have hi2 : IntervalIntegrable (fun θ : ℝ ↦ |hilbertKernel N θ| *
        (nrmS μ f ^ 2 * bestConst μ f ^ 2)) volume 0 1 :=
      (((continuous_hilbertKernel N).abs).mul continuous_const).intervalIntegrable _ _
    have hmono := intervalIntegral.integral_mono_on (by norm_num : (0:ℝ) ≤ 1) hi1 hi2 hbound
    refine hmono.trans_eq ?_
    rw [intervalIntegral.integral_mul_const, ← hilbertKernelL1]
    ring
  have hMnn : 0 ≤ bestConst μ f := bestConst_nonneg hf.memLp
  calc ∫ x, bigV f x ^ 2 ∂μ
      ≤ 4 * ∫ x, ∑ m, rowSum f m x ^ 2 ∂μ := integral_sq_bigV_le hf
    _ ≤ 4 * ∫ x, ∑ m, ‖f m x‖ ^ 2 * ‖signedSum f m x‖ ^ 2 ∂μ := by linarith
    _ ≤ 4 * (hilbertKernelL1 N * ∫ x, sqFun f x ^ 2 *
          (∫ θ in (0:ℝ)..1, |hilbertKernel N θ| * ‖phaseSum f θ x‖ ^ 2) ∂μ) := by linarith
    _ ≤ 4 * (hilbertKernelL1 N * (hilbertKernelL1 N *
          (bestConst μ f ^ 2 * nrmS μ f ^ 2))) := by
        have := mul_le_mul_of_nonneg_left step3 hA
        linarith
    _ = 4 * (hilbertKernelL1 N ^ 2 * (bestConst μ f ^ 2 * nrmS μ f ^ 2)) := by ring

/-! ### Page 9: recovering the real part -/

/-- The phase-changed family `g^θ_i = e(iθ) f_i`. -/
def phaseFamily {N : ℕ} (f : Fin N → α → ℂ) (θ : ℝ) : Fin N → α → ℂ :=
  fun i y ↦ eZ (i : ℤ) θ * f i y

/-- `V(θ)` of page 9: the imaginary-part form of the phase-changed family. -/
def bigVphase {N : ℕ} (f : Fin N → α → ℂ) (θ : ℝ) (x : α) : ℝ :=
  bigV (phaseFamily f θ) x

omit [MeasurableSpace α] in
lemma imForm_phaseFamily {N : ℕ} (f : Fin N → α → ℂ) (θ : ℝ) (i j : Fin N) (x : α) :
    imForm (phaseFamily f θ) i j x
      = (eZ ((i : ℤ) - (j : ℤ)) θ * (f i x * conj (f j x))).im := by
  unfold imForm phaseFamily
  rw [map_mul, conj_eZ, show ((i : ℤ) - (j : ℤ)) = (i : ℤ) + (-(j : ℤ)) by ring, eZ_add]
  congr 1
  ring

omit [MeasurableSpace α] in
/-- The symmetric form of the phase-changed family, in signed form. -/
lemma symForm_phaseFamily {N : ℕ} (f : Fin N → α → ℂ) (θ : ℝ) (i j : Fin N) (x : α) :
    symForm (phaseFamily f θ) i j x
      = -(((i : ℤ) - (j : ℤ)).sign : ℝ)
          * (eZ ((i : ℤ) - (j : ℤ)) θ * (f i x * conj (f j x))).im := by
  unfold symForm
  rcases lt_trichotomy i j with h | h | h
  · have hs : ((i : ℤ) - (j : ℤ)).sign = -1 :=
      Int.sign_eq_neg_one_of_neg (by have := Fin.lt_def.mp h; omega)
    rw [if_pos h, imForm_phaseFamily, hs]
    push_cast
    ring
  · subst h
    rw [if_neg (lt_irrefl i), if_neg (lt_irrefl i), sub_self, Int.sign_zero]
    push_cast
    ring
  · have hs : ((i : ℤ) - (j : ℤ)).sign = 1 :=
      Int.sign_eq_one_of_pos (by have := Fin.lt_def.mp h; omega)
    rw [if_neg (asymm h), if_pos h, imForm_phaseFamily, hs]
    have hconj : (eZ ((j : ℤ) - (i : ℤ)) θ * (f j x * conj (f i x)))
        = conj (eZ ((i : ℤ) - (j : ℤ)) θ * (f i x * conj (f j x))) := by
      rw [map_mul, conj_eZ, map_mul, Complex.conj_conj, neg_sub]
      ring
    rw [hconj, Complex.conj_im]
    push_cast
    ring

/-- Recovering the real part: `∫₀¹ K(θ) Im(e(kθ) z) dθ = -sgn(k) Re z` for `|k| < N`. -/
lemma integral_kernel_mul_im (N : ℕ) (k : ℤ) (hk : k.natAbs < N) (z : ℂ) :
    (∫ θ in (0:ℝ)..1, hilbertKernel N θ * (eZ k θ * z).im)
      = -(k.sign : ℝ) * z.re := by
  have h1 : ∀ θ : ℝ, hilbertKernel N θ * (eZ k θ * z).im
      = (((hilbertKernel N θ : ℝ) : ℂ) * eZ k θ * z).im := by
    intro θ
    rw [mul_assoc, ← Complex.im_ofReal_mul]
  have hcont : Continuous fun θ : ℝ ↦ ((hilbertKernel N θ : ℝ) : ℂ) * eZ k θ * z :=
    (((Complex.continuous_ofReal.comp (continuous_hilbertKernel N)).mul
      (continuous_eZ k)).mul continuous_const)
  have hIm : (∫ θ in (0:ℝ)..1, (((hilbertKernel N θ : ℝ) : ℂ) * eZ k θ * z).im)
      = (∫ θ in (0:ℝ)..1, ((hilbertKernel N θ : ℝ) : ℂ) * eZ k θ * z).im := by
    rw [intervalIntegral.integral_of_le (by norm_num : (0:ℝ) ≤ 1),
      intervalIntegral.integral_of_le (by norm_num : (0:ℝ) ≤ 1)]
    exact _root_.integral_im (hcont.intervalIntegrable _ _).1
  rw [intervalIntegral.integral_congr (fun θ _ ↦ h1 θ), hIm,
    intervalIntegral.integral_mul_const, integral_hilbertKernel_mul_eZ N k hk]
  simp only [Complex.mul_im, Complex.mul_re, Complex.neg_re, Complex.neg_im, Complex.I_re,
    Complex.I_im, Complex.intCast_re, Complex.intCast_im]
  ring

omit [MeasurableSpace α] in
lemma sign_sq_eq {N : ℕ} (i j : Fin N) :
    ((((i : ℤ) - (j : ℤ)).sign : ℝ)) ^ 2 = if i = j then 0 else 1 := by
  rcases eq_or_ne i j with h | h
  · subst h; simp
  · have hne : ((i : ℤ) - (j : ℤ)) ≠ 0 := by
      have : (i : ℕ) ≠ (j : ℕ) := fun hc ↦ h (Fin.ext hc)
      omega
    rcases lt_or_gt_of_ne hne with hlt | hgt
    · rw [Int.sign_eq_neg_one_of_neg hlt, if_neg h]; norm_num
    · rw [Int.sign_eq_one_of_pos hgt, if_neg h]; norm_num

omit [MeasurableSpace α] in
/-- The off-diagonal real parts assemble into `|∑ f_n|^2 - S^2`. -/
lemma sum_offDiag_re {N : ℕ} (f : Fin N → α → ℂ) (x : α) :
    (∑ i : Fin N, ∑ j : Fin N, (if i = j then (0:ℝ) else (f i x * conj (f j x)).re))
      = ‖∑ n, f n x‖ ^ 2 - sqFun f x ^ 2 := by
  have hrow : ∀ i : Fin N,
      (∑ j : Fin N, (if i = j then (0:ℝ) else (f i x * conj (f j x)).re))
        = (∑ j : Fin N, (f i x * conj (f j x)).re) - (f i x * conj (f i x)).re := by
    intro i
    have hj : ∀ j : Fin N, (if i = j then (0:ℝ) else (f i x * conj (f j x)).re)
        = (f i x * conj (f j x)).re - (if i = j then (f i x * conj (f j x)).re else 0) := by
      intro j
      split_ifs <;> ring
    rw [Finset.sum_congr rfl fun j _ ↦ hj j, Finset.sum_sub_distrib,
      Finset.sum_ite_eq Finset.univ i fun j ↦ (f i x * conj (f j x)).re,
      if_pos (Finset.mem_univ i)]
  have hdiag : ∀ i : Fin N, (f i x * conj (f i x)).re = ‖f i x‖ ^ 2 := by
    intro i
    rw [Complex.mul_conj, Complex.ofReal_re, Complex.normSq_eq_norm_sq]
  have h2 : (∑ i : Fin N, ∑ j : Fin N, (f i x * conj (f j x)).re) = ‖∑ n, f n x‖ ^ 2 := by
    have hzz : (∑ i : Fin N, ∑ j : Fin N, f i x * conj (f j x))
        = (∑ n, f n x) * conj (∑ n, f n x) := by
      rw [map_sum, Finset.sum_mul_sum]
    calc (∑ i : Fin N, ∑ j : Fin N, (f i x * conj (f j x)).re)
        = (∑ i : Fin N, ∑ j : Fin N, f i x * conj (f j x)).re := by
          rw [Complex.re_sum]
          exact Finset.sum_congr rfl fun i _ ↦ (Complex.re_sum _ _).symm
      _ = ((∑ n, f n x) * conj (∑ n, f n x)).re := by rw [hzz]
      _ = ‖∑ n, f n x‖ ^ 2 := by
          rw [Complex.mul_conj, Complex.ofReal_re, Complex.normSq_eq_norm_sq]
  rw [Finset.sum_congr rfl fun i _ ↦ hrow i, Finset.sum_sub_distrib, h2,
    Finset.sum_congr rfl fun i _ ↦ hdiag i, ← sq_sqFun]

omit [MeasurableSpace α] in
/-- **Page 9's identity**: the truncated Hilbert kernel converts `V(θ)` into the real part
that controls `|∑ f_n|^2 - S^2`. -/
theorem integral_kernel_bigVphase {N : ℕ} (f : Fin N → α → ℂ) (x : α) :
    (∫ θ in (0:ℝ)..1, hilbertKernel N θ * bigVphase f θ x)
      = ‖∑ n, f n x‖ ^ 2 - sqFun f x ^ 2 := by
  have hcont : ∀ i j : Fin N, Continuous fun θ : ℝ ↦ hilbertKernel N θ *
      (-(((i : ℤ) - (j : ℤ)).sign : ℝ)
        * (eZ ((i : ℤ) - (j : ℤ)) θ * (f i x * conj (f j x))).im) :=
    fun i j ↦ (continuous_hilbertKernel N).mul (continuous_const.mul
      (Complex.continuous_im.comp ((continuous_eZ _).mul continuous_const)))
  have hcontsum : ∀ i : Fin N, Continuous fun θ : ℝ ↦ ∑ j : Fin N, hilbertKernel N θ *
      (-(((i : ℤ) - (j : ℤ)).sign : ℝ)
        * (eZ ((i : ℤ) - (j : ℤ)) θ * (f i x * conj (f j x))).im) :=
    fun i ↦ continuous_finsetSum _ fun j _ ↦ hcont i j
  have h1 : ∀ θ : ℝ, hilbertKernel N θ * bigVphase f θ x
      = ∑ i : Fin N, ∑ j : Fin N, hilbertKernel N θ *
          (-(((i : ℤ) - (j : ℤ)).sign : ℝ)
            * (eZ ((i : ℤ) - (j : ℤ)) θ * (f i x * conj (f j x))).im) := by
    intro θ
    rw [bigVphase, bigV, ← sum_sum_symForm, Finset.mul_sum]
    refine Finset.sum_congr rfl fun i _ ↦ ?_
    rw [Finset.mul_sum]
    exact Finset.sum_congr rfl fun j _ ↦ by rw [symForm_phaseFamily]
  rw [intervalIntegral.integral_congr (fun θ _ ↦ h1 θ),
    intervalIntegral.integral_finsetSum (s := (Finset.univ : Finset (Fin N)))
      (f := fun (i : Fin N) (θ : ℝ) ↦ ∑ j : Fin N, hilbertKernel N θ *
        (-(((i : ℤ) - (j : ℤ)).sign : ℝ)
          * (eZ ((i : ℤ) - (j : ℤ)) θ * (f i x * conj (f j x))).im))
      (fun i _ ↦ (hcontsum i).intervalIntegrable _ _)]
  rw [← sum_offDiag_re f x]
  refine Finset.sum_congr rfl fun i _ ↦ ?_
  rw [intervalIntegral.integral_finsetSum (s := (Finset.univ : Finset (Fin N)))
    (f := fun (j : Fin N) (θ : ℝ) ↦ hilbertKernel N θ *
      (-(((i : ℤ) - (j : ℤ)).sign : ℝ)
        * (eZ ((i : ℤ) - (j : ℤ)) θ * (f i x * conj (f j x))).im))
    (fun j _ ↦ (hcont i j).intervalIntegrable _ _)]
  refine Finset.sum_congr rfl fun j _ ↦ ?_
  have hk : ((i : ℤ) - (j : ℤ)).natAbs < N := by
    have h1 : (i : ℕ) < N := i.isLt
    have h2 : (j : ℕ) < N := j.isLt
    omega
  have hpull : ∀ θ : ℝ, hilbertKernel N θ *
      (-(((i : ℤ) - (j : ℤ)).sign : ℝ)
        * (eZ ((i : ℤ) - (j : ℤ)) θ * (f i x * conj (f j x))).im)
      = -(((i : ℤ) - (j : ℤ)).sign : ℝ) *
          (hilbertKernel N θ * (eZ ((i : ℤ) - (j : ℤ)) θ * (f i x * conj (f j x))).im) :=
    fun θ ↦ by ring
  rw [intervalIntegral.integral_congr (fun θ _ ↦ hpull θ),
    intervalIntegral.integral_const_mul,
    integral_kernel_mul_im N _ hk]
  rcases eq_or_ne i j with h | h
  · subst h
    rw [if_pos rfl, sub_self, Int.sign_zero]
    push_cast
    ring
  · have hs := sign_sq_eq i j
    rw [if_neg h] at hs
    rw [if_neg h]
    linear_combination ((f i x * conj (f j x)).re) * hs

/-! ### The page 9 bound

The source bounds `‖ |∑ f_n|^2 - S^2 ‖_2` by Minkowski's integral inequality. Here the
quantity is paired against itself instead: `∫ H^2 = ∫₀¹ K(θ) (∫ H V(θ)) dθ`, and
Cauchy-Schwarz in `x` gives the same constant. Only a single trigonometric sum has to be
expanded for the interchange, since `V(θ)` appears linearly.
-/

/-- `H = |∑ f_n|^2 - S^2`, the quantity of page 9. -/
def bigH {N : ℕ} (f : Fin N → α → ℂ) (x : α) : ℝ := ‖∑ n, f n x‖ ^ 2 - sqFun f x ^ 2

omit [MeasurableSpace α] in
/-- `H` as an off-diagonal double sum. -/
lemma bigH_ofReal_eq {N : ℕ} (f : Fin N → α → ℂ) (x : α) :
    ((bigH f x : ℝ) : ℂ) = ∑ a : Fin N, ∑ b : Fin N,
      (if a = b then 0 else f a x * conj (f b x)) := by
  have hrow : ∀ a : Fin N,
      (∑ b : Fin N, (if a = b then (0:ℂ) else f a x * conj (f b x)))
        = (∑ b : Fin N, f a x * conj (f b x)) - f a x * conj (f a x) := by
    intro a
    have hb : ∀ b : Fin N, (if a = b then (0:ℂ) else f a x * conj (f b x))
        = f a x * conj (f b x) - (if a = b then f a x * conj (f b x) else 0) := by
      intro b
      split_ifs <;> ring
    rw [Finset.sum_congr rfl fun b _ ↦ hb b, Finset.sum_sub_distrib,
      Finset.sum_ite_eq Finset.univ a fun b ↦ f a x * conj (f b x),
      if_pos (Finset.mem_univ a)]
  rw [Finset.sum_congr rfl fun a _ ↦ hrow a, Finset.sum_sub_distrib]
  have h1 : (∑ a : Fin N, ∑ b : Fin N, f a x * conj (f b x))
      = ((‖∑ n, f n x‖ ^ 2 : ℝ) : ℂ) := by
    rw [← Finset.sum_mul_sum, ← map_sum, Complex.mul_conj, Complex.normSq_eq_norm_sq]
  have h2 : (∑ a : Fin N, f a x * conj (f a x)) = ((sqFun f x ^ 2 : ℝ) : ℂ) := by
    rw [sq_sqFun, Complex.ofReal_sum]
    exact Finset.sum_congr rfl fun a _ ↦ by
      rw [Complex.mul_conj, Complex.normSq_eq_norm_sq]
  rw [h1, h2, bigH, Complex.ofReal_sub]

lemma integrable_bigH_mul {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (hf : ∀ n, MemLp (f n) 4 μ) (i j : Fin N) :
    Integrable (fun x ↦ ((bigH f x : ℝ) : ℂ) * (f i x * conj (f j x))) μ := by
  have hx : ∀ x : α, ((bigH f x : ℝ) : ℂ) * (f i x * conj (f j x))
      = ∑ a : Fin N, ∑ b : Fin N,
          (if a = b then 0 else f a x * f i x * conj (f b x * f j x)) := by
    intro x
    rw [bigH_ofReal_eq, Finset.sum_mul]
    refine Finset.sum_congr rfl fun a _ ↦ ?_
    rw [Finset.sum_mul]
    refine Finset.sum_congr rfl fun b _ ↦ ?_
    split_ifs with h
    · rw [zero_mul]
    · rw [map_mul]
      ring
  rw [funext hx]
  refine integrable_finsetSum _ fun a _ ↦ integrable_finsetSum _ fun b _ ↦ ?_
  by_cases h : a = b
  · simp only [if_pos h]
    exact integrable_zero α ℂ μ
  · simpa only [if_neg h] using integrable_quadruple hf a i b j

/-- Pulling a constant through the `x`-integral of an imaginary part. -/
lemma integral_im_const_mul {μ : Measure α} {h : α → ℂ} (hint : Integrable h μ) (w : ℂ) :
    (∫ x, (w * h x).im ∂μ) = (w * ∫ x, h x ∂μ).im := by
  rw [show (∫ x, (w * h x).im ∂μ) = (∫ x, w * h x ∂μ).im from
    _root_.integral_im (hint.const_mul w), MeasureTheory.integral_const_mul]

omit [MeasurableSpace α] in
/-- The pointwise expansion of `H(x) V(θ,x)`. -/
lemma bigH_mul_bigVphase_eq {N : ℕ} (f : Fin N → α → ℂ) (θ : ℝ) (x : α) :
    bigH f x * bigVphase f θ x
      = ∑ i : Fin N, ∑ j : Fin N, -(((i : ℤ) - (j : ℤ)).sign : ℝ) *
          (eZ ((i : ℤ) - (j : ℤ)) θ *
            (((bigH f x : ℝ) : ℂ) * (f i x * conj (f j x)))).im := by
  rw [bigVphase, bigV, ← sum_sum_symForm, Finset.mul_sum]
  refine Finset.sum_congr rfl fun i _ ↦ ?_
  rw [Finset.mul_sum]
  refine Finset.sum_congr rfl fun j _ ↦ ?_
  rw [symForm_phaseFamily,
    show (eZ ((i : ℤ) - (j : ℤ)) θ * (((bigH f x : ℝ) : ℂ) * (f i x * conj (f j x))))
      = ((bigH f x : ℝ) : ℂ) * (eZ ((i : ℤ) - (j : ℤ)) θ * (f i x * conj (f j x))) from
      by ring, Complex.im_ofReal_mul]
  ring

omit [MeasurableSpace α] in
lemma continuous_kernel_term {N : ℕ} (f : Fin N → α → ℂ) (x : α) (i j : Fin N) :
    Continuous fun θ : ℝ ↦ hilbertKernel N θ * (-(((i : ℤ) - (j : ℤ)).sign : ℝ) *
      (eZ ((i : ℤ) - (j : ℤ)) θ *
        (((bigH f x : ℝ) : ℂ) * (f i x * conj (f j x)))).im) :=
  (continuous_hilbertKernel N).mul (continuous_const.mul
    (Complex.continuous_im.comp ((continuous_eZ _).mul continuous_const)))

omit [MeasurableSpace α] in
lemma natAbs_sub_lt {N : ℕ} (i j : Fin N) : ((i : ℤ) - (j : ℤ)).natAbs < N := by
  have h1 : (i : ℕ) < N := i.isLt
  have h2 : (j : ℕ) < N := j.isLt
  omega

omit [MeasurableSpace α] in
/-- Pointwise form of the left-hand side of the page 9 pairing. -/
lemma sq_bigH_eq {N : ℕ} (f : Fin N → α → ℂ) (x : α) :
    bigH f x ^ 2 = ∑ i : Fin N, ∑ j : Fin N, ((((i : ℤ) - (j : ℤ)).sign : ℝ)) ^ 2 *
      (((bigH f x : ℝ) : ℂ) * (f i x * conj (f j x))).re := by
  have h1 : (∫ θ in (0:ℝ)..1, hilbertKernel N θ * (bigH f x * bigVphase f θ x))
      = bigH f x ^ 2 := by
    have hswap : ∀ θ : ℝ, hilbertKernel N θ * (bigH f x * bigVphase f θ x)
        = bigH f x * (hilbertKernel N θ * bigVphase f θ x) := fun θ ↦ by ring
    rw [intervalIntegral.integral_congr (fun θ _ ↦ hswap θ),
      intervalIntegral.integral_const_mul, integral_kernel_bigVphase]
    unfold bigH
    ring
  rw [← h1]
  have h2 : ∀ θ : ℝ, hilbertKernel N θ * (bigH f x * bigVphase f θ x)
      = ∑ i : Fin N, ∑ j : Fin N, hilbertKernel N θ *
          (-(((i : ℤ) - (j : ℤ)).sign : ℝ) *
            (eZ ((i : ℤ) - (j : ℤ)) θ *
              (((bigH f x : ℝ) : ℂ) * (f i x * conj (f j x)))).im) := by
    intro θ
    rw [bigH_mul_bigVphase_eq, Finset.mul_sum]
    exact Finset.sum_congr rfl fun i _ ↦ Finset.mul_sum _ _ _
  rw [intervalIntegral.integral_congr (fun θ _ ↦ h2 θ),
    intervalIntegral.integral_finsetSum (s := (Finset.univ : Finset (Fin N)))
      (f := fun (i : Fin N) (θ : ℝ) ↦ ∑ j : Fin N, hilbertKernel N θ *
        (-(((i : ℤ) - (j : ℤ)).sign : ℝ) *
          (eZ ((i : ℤ) - (j : ℤ)) θ *
            (((bigH f x : ℝ) : ℂ) * (f i x * conj (f j x)))).im))
      (fun i _ ↦ (continuous_finsetSum _ fun j _ ↦
        continuous_kernel_term f x i j).intervalIntegrable _ _)]
  refine Finset.sum_congr rfl fun i _ ↦ ?_
  rw [intervalIntegral.integral_finsetSum (s := (Finset.univ : Finset (Fin N)))
    (f := fun (j : Fin N) (θ : ℝ) ↦ hilbertKernel N θ *
      (-(((i : ℤ) - (j : ℤ)).sign : ℝ) *
        (eZ ((i : ℤ) - (j : ℤ)) θ *
          (((bigH f x : ℝ) : ℂ) * (f i x * conj (f j x)))).im))
    (fun j _ ↦ (continuous_kernel_term f x i j).intervalIntegrable _ _)]
  refine Finset.sum_congr rfl fun j _ ↦ ?_
  have hpull : ∀ θ : ℝ, hilbertKernel N θ *
      (-(((i : ℤ) - (j : ℤ)).sign : ℝ) *
        (eZ ((i : ℤ) - (j : ℤ)) θ *
          (((bigH f x : ℝ) : ℂ) * (f i x * conj (f j x)))).im)
      = -(((i : ℤ) - (j : ℤ)).sign : ℝ) * (hilbertKernel N θ *
          (eZ ((i : ℤ) - (j : ℤ)) θ *
            (((bigH f x : ℝ) : ℂ) * (f i x * conj (f j x)))).im) := fun θ ↦ by ring
  rw [intervalIntegral.integral_congr (fun θ _ ↦ hpull θ),
    intervalIntegral.integral_const_mul,
    integral_kernel_mul_im N _ (natAbs_sub_lt i j)]
  ring

lemma integrable_sq_bigH_term {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (hf : ∀ n, MemLp (f n) 4 μ) (i j : Fin N) :
    Integrable (fun x ↦ ((((i : ℤ) - (j : ℤ)).sign : ℝ)) ^ 2 *
      (((bigH f x : ℝ) : ℂ) * (f i x * conj (f j x))).re) μ :=
  ((integrable_bigH_mul hf i j).re).const_mul _

/-- Left-hand side of the page 9 pairing. -/
lemma page9_left {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (hf : ∀ n, MemLp (f n) 4 μ) :
    (∫ x, bigH f x ^ 2 ∂μ)
      = ∑ i : Fin N, ∑ j : Fin N, ((((i : ℤ) - (j : ℤ)).sign : ℝ)) ^ 2 *
          (∫ x, ((bigH f x : ℝ) : ℂ) * (f i x * conj (f j x)) ∂μ).re := by
  rw [integral_congr_ae (Filter.Eventually.of_forall fun x ↦ sq_bigH_eq f x),
    integral_finsetSum _ (fun i _ ↦ integrable_finsetSum _ fun j _ ↦
      integrable_sq_bigH_term hf i j)]
  refine Finset.sum_congr rfl fun i _ ↦ ?_
  rw [integral_finsetSum _ (fun j _ ↦ integrable_sq_bigH_term hf i j)]
  refine Finset.sum_congr rfl fun j _ ↦ ?_
  rw [MeasureTheory.integral_const_mul,
    show (∫ x, (((bigH f x : ℝ) : ℂ) * (f i x * conj (f j x))).re ∂μ)
        = (∫ x, ((bigH f x : ℝ) : ℂ) * (f i x * conj (f j x)) ∂μ).re from
      _root_.integral_re (integrable_bigH_mul hf i j)]

lemma integrable_bigH_mul_bigVphase {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (hf : ∀ n, MemLp (f n) 4 μ) (θ : ℝ) :
    Integrable (fun x ↦ bigH f x * bigVphase f θ x) μ := by
  rw [funext fun x ↦ bigH_mul_bigVphase_eq f θ x]
  exact integrable_finsetSum _ fun i _ ↦ integrable_finsetSum _ fun j _ ↦
    ((((integrable_bigH_mul hf i j).const_mul (eZ ((i : ℤ) - (j : ℤ)) θ))).im).const_mul _

/-- The `x`-integral of `H V(θ)`, expanded. -/
lemma inner_bigH_bigVphase {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (hf : ∀ n, MemLp (f n) 4 μ) (θ : ℝ) :
    (∫ x, bigH f x * bigVphase f θ x ∂μ)
      = ∑ i : Fin N, ∑ j : Fin N, -(((i : ℤ) - (j : ℤ)).sign : ℝ) *
          (eZ ((i : ℤ) - (j : ℤ)) θ *
            ∫ x, ((bigH f x : ℝ) : ℂ) * (f i x * conj (f j x)) ∂μ).im := by
  have hterm : ∀ i j : Fin N, Integrable (fun x ↦ -(((i : ℤ) - (j : ℤ)).sign : ℝ) *
      (eZ ((i : ℤ) - (j : ℤ)) θ *
        (((bigH f x : ℝ) : ℂ) * (f i x * conj (f j x)))).im) μ :=
    fun i j ↦ ((((integrable_bigH_mul hf i j).const_mul
      (eZ ((i : ℤ) - (j : ℤ)) θ))).im).const_mul _
  rw [integral_congr_ae (Filter.Eventually.of_forall fun x ↦ bigH_mul_bigVphase_eq f θ x),
    integral_finsetSum _ (fun i _ ↦ integrable_finsetSum _ fun j _ ↦ hterm i j)]
  refine Finset.sum_congr rfl fun i _ ↦ ?_
  rw [integral_finsetSum _ (fun j _ ↦ hterm i j)]
  refine Finset.sum_congr rfl fun j _ ↦ ?_
  rw [MeasureTheory.integral_const_mul,
    integral_im_const_mul (integrable_bigH_mul hf i j)]

/-- Right-hand side of the page 9 pairing. -/
lemma page9_right {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (hf : ∀ n, MemLp (f n) 4 μ) :
    (∫ θ in (0:ℝ)..1, hilbertKernel N θ * ∫ x, bigH f x * bigVphase f θ x ∂μ)
      = ∑ i : Fin N, ∑ j : Fin N, ((((i : ℤ) - (j : ℤ)).sign : ℝ)) ^ 2 *
          (∫ x, ((bigH f x : ℝ) : ℂ) * (f i x * conj (f j x)) ∂μ).re := by
  have hcont : ∀ i j : Fin N, Continuous fun θ : ℝ ↦ hilbertKernel N θ *
      (-(((i : ℤ) - (j : ℤ)).sign : ℝ) *
        (eZ ((i : ℤ) - (j : ℤ)) θ *
          ∫ x, ((bigH f x : ℝ) : ℂ) * (f i x * conj (f j x)) ∂μ).im) :=
    fun i j ↦ (continuous_hilbertKernel N).mul (continuous_const.mul
      (Complex.continuous_im.comp ((continuous_eZ _).mul continuous_const)))
  have h1 : ∀ θ : ℝ, hilbertKernel N θ * (∫ x, bigH f x * bigVphase f θ x ∂μ)
      = ∑ i : Fin N, ∑ j : Fin N, hilbertKernel N θ *
          (-(((i : ℤ) - (j : ℤ)).sign : ℝ) *
            (eZ ((i : ℤ) - (j : ℤ)) θ *
              ∫ x, ((bigH f x : ℝ) : ℂ) * (f i x * conj (f j x)) ∂μ).im) := by
    intro θ
    rw [inner_bigH_bigVphase hf, Finset.mul_sum]
    exact Finset.sum_congr rfl fun i _ ↦ Finset.mul_sum _ _ _
  rw [intervalIntegral.integral_congr (fun θ _ ↦ h1 θ),
    intervalIntegral.integral_finsetSum (s := (Finset.univ : Finset (Fin N)))
      (f := fun (i : Fin N) (θ : ℝ) ↦ ∑ j : Fin N, hilbertKernel N θ *
        (-(((i : ℤ) - (j : ℤ)).sign : ℝ) *
          (eZ ((i : ℤ) - (j : ℤ)) θ *
            ∫ x, ((bigH f x : ℝ) : ℂ) * (f i x * conj (f j x)) ∂μ).im))
      (fun i _ ↦ (continuous_finsetSum _ fun j _ ↦ hcont i j).intervalIntegrable _ _)]
  refine Finset.sum_congr rfl fun i _ ↦ ?_
  rw [intervalIntegral.integral_finsetSum (s := (Finset.univ : Finset (Fin N)))
    (f := fun (j : Fin N) (θ : ℝ) ↦ hilbertKernel N θ *
      (-(((i : ℤ) - (j : ℤ)).sign : ℝ) *
        (eZ ((i : ℤ) - (j : ℤ)) θ *
          ∫ x, ((bigH f x : ℝ) : ℂ) * (f i x * conj (f j x)) ∂μ).im))
    (fun j _ ↦ (hcont i j).intervalIntegrable _ _)]
  refine Finset.sum_congr rfl fun j _ ↦ ?_
  have hpull : ∀ θ : ℝ, hilbertKernel N θ *
      (-(((i : ℤ) - (j : ℤ)).sign : ℝ) *
        (eZ ((i : ℤ) - (j : ℤ)) θ *
          ∫ x, ((bigH f x : ℝ) : ℂ) * (f i x * conj (f j x)) ∂μ).im)
      = -(((i : ℤ) - (j : ℤ)).sign : ℝ) * (hilbertKernel N θ *
          (eZ ((i : ℤ) - (j : ℤ)) θ *
            ∫ x, ((bigH f x : ℝ) : ℂ) * (f i x * conj (f j x)) ∂μ).im) := fun θ ↦ by ring
  rw [intervalIntegral.integral_congr (fun θ _ ↦ hpull θ),
    intervalIntegral.integral_const_mul,
    integral_kernel_mul_im N _ (natAbs_sub_lt i j)]
  ring

/-- **The page 9 pairing**: `∫ H^2 = ∫₀¹ K(θ) (∫ H V(θ)) dθ`. -/
theorem page9_swap {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (hf : ∀ n, MemLp (f n) 4 μ) :
    (∫ x, bigH f x ^ 2 ∂μ)
      = ∫ θ in (0:ℝ)..1, hilbertKernel N θ * ∫ x, bigH f x * bigVphase f θ x ∂μ :=
  (page9_left hf).trans (page9_right hf).symm

/-! ### Invariance under unimodular phase changes -/

lemma conj_eZ_mul (k : ℤ) (θ : ℝ) : conj (eZ k θ) * eZ k θ = 1 := by
  rw [conj_eZ, ← eZ_add, neg_add_cancel]
  simp [eZ, e]

/-- Hypothesis (1.2) is unchanged by a unimodular phase change. -/
lemma orderedSuperorthogonal_phaseFamily {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (hf : OrderedSuperorthogonal μ f) (θ : ℝ) :
    OrderedSuperorthogonal μ (phaseFamily f θ) where
  memLp := fun n ↦ (hf.memLp n).const_mul _
  vanishA := by
    intro i j k l hij hjk hkl
    have hx : ∀ x : α, phaseFamily f θ i x * phaseFamily f θ j x *
        conj (phaseFamily f θ k x) * conj (phaseFamily f θ l x)
        = (eZ (i : ℤ) θ * eZ (j : ℤ) θ * conj (eZ (k : ℤ) θ) * conj (eZ (l : ℤ) θ)) *
          (f i x * f j x * conj (f k x) * conj (f l x)) := by
      intro x
      unfold phaseFamily
      simp only [map_mul]
      ring
    rw [integral_congr_ae (Filter.Eventually.of_forall hx),
      MeasureTheory.integral_const_mul, hf.vanishA i j k l hij hjk hkl, mul_zero]
  vanishB := by
    intro i j k l hij hjk hkl
    have hx : ∀ x : α, phaseFamily f θ i x * phaseFamily f θ l x *
        conj (phaseFamily f θ j x) * conj (phaseFamily f θ k x)
        = (eZ (i : ℤ) θ * eZ (l : ℤ) θ * conj (eZ (j : ℤ) θ) * conj (eZ (k : ℤ) θ)) *
          (f i x * f l x * conj (f j x) * conj (f k x)) := by
      intro x
      unfold phaseFamily
      simp only [map_mul]
      ring
    rw [integral_congr_ae (Filter.Eventually.of_forall hx),
      MeasureTheory.integral_const_mul, hf.vanishB i j k l hij hjk hkl, mul_zero]

omit [MeasurableSpace α] in
lemma sqFun_phaseFamily {N : ℕ} (f : Fin N → α → ℂ) (θ : ℝ) (x : α) :
    sqFun (phaseFamily f θ) x = sqFun f x :=
  sqFun_phase f (fun n ↦ eZ (n : ℤ) θ) (fun _ ↦ norm_eZ _ _) x

lemma nrmS_phaseFamily {N : ℕ} (μ : Measure α) (f : Fin N → α → ℂ) (θ : ℝ) :
    nrmS μ (phaseFamily f θ) = nrmS μ f := by
  unfold nrmS pow4S
  congr 1
  exact integral_congr_ae (Filter.Eventually.of_forall fun x ↦ by
    simp only []
    rw [sqFun_phaseFamily])

/-- The competitor sets defining the best constant coincide for a phase-changed family. -/
lemma phaseNorms_phaseFamily {N : ℕ} (μ : Measure α) (f : Fin N → α → ℂ) (θ : ℝ) :
    phaseNorms μ (phaseFamily f θ) = phaseNorms μ f := by
  ext t
  constructor
  · rintro ⟨c, hc, rfl⟩
    refine ⟨fun n ↦ c n * eZ (n : ℤ) θ, fun n ↦ by
      rw [norm_mul, hc n, norm_eZ, mul_one], ?_⟩
    congr 1
    funext x
    exact Finset.sum_congr rfl fun n _ ↦ by unfold phaseFamily; ring
  · rintro ⟨c, hc, rfl⟩
    refine ⟨fun n ↦ c n * conj (eZ (n : ℤ) θ), fun n ↦ by
      rw [norm_mul, hc n, RCLike.norm_conj, norm_eZ, mul_one], ?_⟩
    congr 1
    funext x
    refine Finset.sum_congr rfl fun n _ ↦ ?_
    unfold phaseFamily
    rw [mul_assoc, ← mul_assoc (conj (eZ (n : ℤ) θ)), conj_eZ_mul, one_mul]

lemma bestConst_phaseFamily {N : ℕ} (μ : Measure α) (f : Fin N → α → ℂ) (θ : ℝ) :
    bestConst μ (phaseFamily f θ) = bestConst μ f := by
  unfold bestConst
  rw [phaseNorms_phaseFamily]

/-- The uniform bound on `‖V(θ)‖_2` from (2.8). -/
theorem integral_sq_bigVphase_le {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (hf : OrderedSuperorthogonal μ f) (θ : ℝ) :
    ∫ x, bigVphase f θ x ^ 2 ∂μ
      ≤ 4 * (hilbertKernelL1 N ^ 2 * (bestConst μ f ^ 2 * nrmS μ f ^ 2)) := by
  have h := estimate_2_8 (orderedSuperorthogonal_phaseFamily hf θ)
  rwa [bestConst_phaseFamily, nrmS_phaseFamily] at h

/-! ### The `L^2` norm of a real function -/

/-- `‖h‖_2` for a real function. -/
def nrm2 (μ : Measure α) (h : α → ℝ) : ℝ := (∫ x, h x ^ 2 ∂μ) ^ ((1:ℝ)/2)

lemma nrm2_nonneg (μ : Measure α) (h : α → ℝ) : 0 ≤ nrm2 μ h :=
  Real.rpow_nonneg (integral_nonneg fun _ ↦ sq_nonneg _) _

lemma nrm2_sq (μ : Measure α) (h : α → ℝ) : nrm2 μ h ^ 2 = ∫ x, h x ^ 2 ∂μ := by
  rw [nrm2, ← Real.rpow_natCast ((∫ x, h x ^ 2 ∂μ) ^ ((1:ℝ)/2)) 2,
    ← Real.rpow_mul (integral_nonneg fun _ ↦ sq_nonneg _)]
  norm_num

lemma nrm2_le_of_sq_le {μ : Measure α} {h : α → ℝ} {C : ℝ} (hC : 0 ≤ C)
    (hle : (∫ x, h x ^ 2 ∂μ) ≤ C ^ 2) : nrm2 μ h ≤ C := by
  have h1 : nrm2 μ h ^ 2 ≤ C ^ 2 := by rw [nrm2_sq]; exact hle
  have h2 := Real.sqrt_le_sqrt h1
  rwa [Real.sqrt_sq (nrm2_nonneg μ h), Real.sqrt_sq hC] at h2

lemma integrable_sq_bigH {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (hf : ∀ n, MemLp (f n) 4 μ) : Integrable (fun x ↦ bigH f x ^ 2) μ := by
  rw [funext fun x ↦ sq_bigH_eq f x]
  exact integrable_finsetSum _ fun i _ ↦ integrable_finsetSum _ fun j _ ↦
    integrable_sq_bigH_term hf i j

lemma continuous_kernel_mul_pairing {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (hf : ∀ n, MemLp (f n) 4 μ) :
    Continuous fun θ : ℝ ↦ hilbertKernel N θ * ∫ x, bigH f x * bigVphase f θ x ∂μ := by
  have h1 : (fun θ : ℝ ↦ hilbertKernel N θ * ∫ x, bigH f x * bigVphase f θ x ∂μ)
      = fun θ : ℝ ↦ hilbertKernel N θ * ∑ i : Fin N, ∑ j : Fin N,
          -(((i : ℤ) - (j : ℤ)).sign : ℝ) *
            (eZ ((i : ℤ) - (j : ℤ)) θ *
              ∫ x, ((bigH f x : ℝ) : ℂ) * (f i x * conj (f j x)) ∂μ).im := by
    funext θ
    rw [inner_bigH_bigVphase hf]
  rw [h1]
  exact (continuous_hilbertKernel N).mul
    (continuous_finsetSum _ fun i _ ↦ continuous_finsetSum _ fun j _ ↦
      continuous_const.mul
        (Complex.continuous_im.comp ((continuous_eZ _).mul continuous_const)))

/-- **The page 9 bound**: `‖ |∑ f_n|^2 - S^2 ‖_2 ≤ 2 A_N^2 M ‖S‖_4`. -/
theorem page9_bound {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (hf : OrderedSuperorthogonal μ f) :
    nrm2 μ (bigH f)
      ≤ hilbertKernelL1 N * (2 * hilbertKernelL1 N * bestConst μ f * nrmS μ f) := by
  set P := nrm2 μ (bigH f) with hP
  set B := 2 * hilbertKernelL1 N * bestConst μ f * nrmS μ f with hB
  have hA : 0 ≤ hilbertKernelL1 N := hilbertKernelL1_nonneg N
  have hBnn : 0 ≤ B := by
    rw [hB]
    have := bestConst_nonneg hf.memLp
    have := nrmS_nonneg μ f
    positivity
  have hPnn : 0 ≤ P := nrm2_nonneg _ _
  -- the uniform bound on `‖V(θ)‖_2`
  have hV : ∀ θ : ℝ, nrm2 μ (bigVphase f θ) ≤ B := by
    intro θ
    refine nrm2_le_of_sq_le hBnn ?_
    have h := integral_sq_bigVphase_le hf θ
    calc (∫ x, bigVphase f θ x ^ 2 ∂μ)
        ≤ 4 * (hilbertKernelL1 N ^ 2 * (bestConst μ f ^ 2 * nrmS μ f ^ 2)) := h
      _ = B ^ 2 := by rw [hB]; ring
  -- Cauchy-Schwarz in `x`
  have hJ : ∀ θ : ℝ, |∫ x, bigH f x * bigVphase f θ x ∂μ| ≤ P * B := by
    intro θ
    have hGsq : Integrable (fun x ↦ bigVphase f θ x ^ 2) μ :=
      integrable_sq_bigV (orderedSuperorthogonal_phaseFamily hf θ).memLp
    have hCS := sq_integral_mul_le (integrable_sq_bigH hf.memLp) hGsq
      (integrable_bigH_mul_bigVphase hf.memLp θ)
    rw [← nrm2_sq μ (bigH f), ← nrm2_sq μ (bigVphase f θ)] at hCS
    have hstep : (∫ x, bigH f x * bigVphase f θ x ∂μ) ^ 2 ≤ (P * B) ^ 2 := by
      refine hCS.trans ?_
      have h1 := hV θ
      have h2 := nrm2_nonneg μ (bigVphase f θ)
      calc P ^ 2 * nrm2 μ (bigVphase f θ) ^ 2
          ≤ P ^ 2 * B ^ 2 := by
            refine mul_le_mul_of_nonneg_left ?_ (sq_nonneg _)
            exact pow_le_pow_left₀ h2 h1 2
        _ = (P * B) ^ 2 := by ring
    have h3 := Real.sqrt_le_sqrt hstep
    rwa [Real.sqrt_sq_eq_abs, Real.sqrt_sq (by positivity)] at h3
  -- pair `H` against itself through the kernel
  have hi1 : IntervalIntegrable (fun θ : ℝ ↦ hilbertKernel N θ *
      ∫ x, bigH f x * bigVphase f θ x ∂μ) volume 0 1 :=
    (continuous_kernel_mul_pairing hf.memLp).intervalIntegrable _ _
  have hi2 : IntervalIntegrable
      (fun θ : ℝ ↦ |hilbertKernel N θ| * (P * B)) volume 0 1 :=
    (((continuous_hilbertKernel N).abs).mul continuous_const).intervalIntegrable _ _
  have hchain : (∫ x, bigH f x ^ 2 ∂μ) ≤ hilbertKernelL1 N * (P * B) := by
    rw [page9_swap hf.memLp]
    have hmono := intervalIntegral.integral_mono_on (by norm_num : (0:ℝ) ≤ 1) hi1 hi2
      (fun θ _ ↦ by
        calc hilbertKernel N θ * ∫ x, bigH f x * bigVphase f θ x ∂μ
            ≤ |hilbertKernel N θ * ∫ x, bigH f x * bigVphase f θ x ∂μ| := le_abs_self _
          _ = |hilbertKernel N θ| * |∫ x, bigH f x * bigVphase f θ x ∂μ| := abs_mul _ _
          _ ≤ |hilbertKernel N θ| * (P * B) := by
              exact mul_le_mul_of_nonneg_left (hJ θ) (abs_nonneg _))
    refine hmono.trans_eq ?_
    rw [intervalIntegral.integral_mul_const, ← hilbertKernelL1]
  -- conclude `P^2 ≤ A_N P B`, hence `P ≤ A_N B`
  rw [← nrm2_sq μ (bigH f)] at hchain
  rcases eq_or_lt_of_le hPnn with hp | hp
  · rw [← hp]
    positivity
  · nlinarith [hchain, hp]

/-- Cauchy-Schwarz in `L^2` norm form. -/
lemma integral_mul_le_nrm2 {μ : Measure α} {a b : α → ℝ}
    (ha : Integrable (fun x ↦ a x ^ 2) μ) (hb : Integrable (fun x ↦ b x ^ 2) μ)
    (hab : Integrable (fun x ↦ a x * b x) μ) :
    (∫ x, a x * b x ∂μ) ≤ nrm2 μ a * nrm2 μ b := by
  have hCS := sq_integral_mul_le ha hb hab
  rw [← nrm2_sq μ a, ← nrm2_sq μ b] at hCS
  have hsq : (∫ x, a x * b x ∂μ) ^ 2 ≤ (nrm2 μ a * nrm2 μ b) ^ 2 := by
    calc (∫ x, a x * b x ∂μ) ^ 2 ≤ nrm2 μ a ^ 2 * nrm2 μ b ^ 2 := hCS
      _ = (nrm2 μ a * nrm2 μ b) ^ 2 := by ring
  have h := Real.sqrt_le_sqrt hsq
  rw [Real.sqrt_sq_eq_abs,
    Real.sqrt_sq (mul_nonneg (nrm2_nonneg μ a) (nrm2_nonneg μ b))] at h
  exact (le_abs_self _).trans h

/-- The triangle inequality in `L^2`. -/
lemma nrm2_add_le {μ : Measure α} {a b : α → ℝ}
    (ha : Integrable (fun x ↦ a x ^ 2) μ) (hb : Integrable (fun x ↦ b x ^ 2) μ)
    (hab : Integrable (fun x ↦ a x * b x) μ) :
    nrm2 μ (fun x ↦ a x + b x) ≤ nrm2 μ a + nrm2 μ b := by
  refine nrm2_le_of_sq_le (add_nonneg (nrm2_nonneg μ a) (nrm2_nonneg μ b)) ?_
  have hexp : (∫ x, (a x + b x) ^ 2 ∂μ)
      = (∫ x, a x ^ 2 ∂μ) + 2 * (∫ x, a x * b x ∂μ) + ∫ x, b x ^ 2 ∂μ := by
    have h1 : ∀ x : α, (a x + b x) ^ 2 = a x ^ 2 + 2 * (a x * b x) + b x ^ 2 :=
      fun x ↦ by ring
    have e0 : Integrable (fun x ↦ 2 * (a x * b x)) μ := hab.const_mul _
    have e1 : Integrable (fun x ↦ a x ^ 2 + 2 * (a x * b x)) μ := ha.add e0
    rw [integral_congr_ae (Filter.Eventually.of_forall h1),
      integral_add e1 hb, integral_add ha e0,
      MeasureTheory.integral_const_mul]
  rw [hexp, ← nrm2_sq μ a, ← nrm2_sq μ b]
  have := integral_mul_le_nrm2 ha hb hab
  nlinarith [this]

lemma nrm2_normSq_eq {N : ℕ} (μ : Measure α) (f : Fin N → α → ℂ) :
    nrm2 μ (fun x ↦ ‖∑ n, f n x‖ ^ 2) = nrm4 μ (fun x ↦ ∑ n, f n x) ^ 2 := by
  have hp : (∫ x, (‖∑ n, f n x‖ ^ 2) ^ 2 ∂μ) = pow4 μ (fun x ↦ ∑ n, f n x) := by
    rw [pow4]
    exact integral_congr_ae (Filter.Eventually.of_forall fun x ↦ by ring)
  rw [nrm2, hp, nrm4, ← Real.rpow_natCast (pow4 μ (fun x ↦ ∑ n, f n x) ^ ((1:ℝ)/4)) 2,
    ← Real.rpow_mul (pow4_nonneg _ _)]
  norm_num

lemma nrm2_sqFun_eq {N : ℕ} (μ : Measure α) (f : Fin N → α → ℂ) :
    nrm2 μ (fun x ↦ sqFun f x ^ 2) = nrmS μ f ^ 2 := by
  have hp : (∫ x, (sqFun f x ^ 2) ^ 2 ∂μ) = pow4S μ f := by
    rw [pow4S]
    exact integral_congr_ae (Filter.Eventually.of_forall fun x ↦ by ring)
  rw [nrm2, hp, nrmS, ← Real.rpow_natCast (pow4S μ f ^ ((1:ℝ)/4)) 2,
    ← Real.rpow_mul (pow4S_nonneg _ _)]
  norm_num

/-! ### General unimodular phase changes -/

/-- A general unimodular phase change of the family. -/
def phaseChange {N : ℕ} (f : Fin N → α → ℂ) (c : Fin N → ℂ) : Fin N → α → ℂ :=
  fun n y ↦ c n * f n y

lemma conj_mul_self_of_norm_one {z : ℂ} (hz : ‖z‖ = 1) : conj z * z = 1 := by
  rw [mul_comm, Complex.mul_conj, Complex.normSq_eq_norm_sq, hz]
  norm_num

lemma orderedSuperorthogonal_phaseChange {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (hf : OrderedSuperorthogonal μ f) (c : Fin N → ℂ) :
    OrderedSuperorthogonal μ (phaseChange f c) where
  memLp := fun n ↦ (hf.memLp n).const_mul _
  vanishA := by
    intro i j k l hij hjk hkl
    have hx : ∀ x : α, phaseChange f c i x * phaseChange f c j x *
        conj (phaseChange f c k x) * conj (phaseChange f c l x)
        = (c i * c j * conj (c k) * conj (c l)) *
          (f i x * f j x * conj (f k x) * conj (f l x)) := by
      intro x
      unfold phaseChange
      simp only [map_mul]
      ring
    rw [integral_congr_ae (Filter.Eventually.of_forall hx),
      MeasureTheory.integral_const_mul, hf.vanishA i j k l hij hjk hkl, mul_zero]
  vanishB := by
    intro i j k l hij hjk hkl
    have hx : ∀ x : α, phaseChange f c i x * phaseChange f c l x *
        conj (phaseChange f c j x) * conj (phaseChange f c k x)
        = (c i * c l * conj (c j) * conj (c k)) *
          (f i x * f l x * conj (f j x) * conj (f k x)) := by
      intro x
      unfold phaseChange
      simp only [map_mul]
      ring
    rw [integral_congr_ae (Filter.Eventually.of_forall hx),
      MeasureTheory.integral_const_mul, hf.vanishB i j k l hij hjk hkl, mul_zero]

omit [MeasurableSpace α] in
lemma sqFun_phaseChange {N : ℕ} (f : Fin N → α → ℂ) (c : Fin N → ℂ)
    (hc : ∀ n, ‖c n‖ = 1) (x : α) : sqFun (phaseChange f c) x = sqFun f x :=
  sqFun_phase f c hc x

lemma nrmS_phaseChange {N : ℕ} (μ : Measure α) (f : Fin N → α → ℂ) (c : Fin N → ℂ)
    (hc : ∀ n, ‖c n‖ = 1) : nrmS μ (phaseChange f c) = nrmS μ f := by
  unfold nrmS pow4S
  congr 1
  exact integral_congr_ae (Filter.Eventually.of_forall fun x ↦ by
    simp only []
    rw [sqFun_phaseChange f c hc x])

lemma phaseNorms_phaseChange {N : ℕ} (μ : Measure α) (f : Fin N → α → ℂ) (c : Fin N → ℂ)
    (hc : ∀ n, ‖c n‖ = 1) : phaseNorms μ (phaseChange f c) = phaseNorms μ f := by
  ext t
  constructor
  · rintro ⟨d, hd, rfl⟩
    refine ⟨fun n ↦ d n * c n, fun n ↦ by rw [norm_mul, hd n, hc n, mul_one], ?_⟩
    congr 1
    funext x
    exact Finset.sum_congr rfl fun n _ ↦ by unfold phaseChange; ring
  · rintro ⟨d, hd, rfl⟩
    refine ⟨fun n ↦ d n * conj (c n), fun n ↦ by
      rw [norm_mul, hd n, RCLike.norm_conj, hc n, mul_one], ?_⟩
    congr 1
    funext x
    refine Finset.sum_congr rfl fun n _ ↦ ?_
    unfold phaseChange
    rw [mul_assoc, ← mul_assoc (conj (c n)), conj_mul_self_of_norm_one (hc n), one_mul]

lemma bestConst_phaseChange {N : ℕ} (μ : Measure α) (f : Fin N → α → ℂ) (c : Fin N → ℂ)
    (hc : ∀ n, ‖c n‖ = 1) : bestConst μ (phaseChange f c) = bestConst μ f := by
  unfold bestConst
  rw [phaseNorms_phaseChange μ f c hc]

/-! ### Integrability for the final assembly -/

lemma integrable_pow4_sqFun {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (hf : ∀ n, MemLp (f n) 4 μ) : Integrable (fun x ↦ (sqFun f x ^ 2) ^ 2) μ := by
  have h := (memLp_sqFun hf).integrable_norm_pow (p := 4) (by norm_num)
  refine h.congr (Filter.Eventually.of_forall fun x ↦ ?_)
  simp only []
  rw [Real.norm_of_nonneg (sqFun_nonneg f x)]
  ring

lemma integrable_sqFun_sq_mul_normSq {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    {g : α → ℂ} (hf : ∀ n, MemLp (f n) 4 μ) (hg : MemLp g 4 μ) :
    Integrable (fun x ↦ sqFun f x ^ 2 * ‖g x‖ ^ 2) μ := by
  have hS := memLp_sqFun hf
  have hFm : MemLp (fun x ↦ sqFun f x ^ 2) 2 μ := by
    have h : MemLp (fun x ↦ sqFun f x * sqFun f x) 2 μ := hS.mul hS
    simpa [sq] using h
  have hGm : MemLp (fun x ↦ ‖g x‖ ^ 2) 2 μ := by
    have h : MemLp (fun x ↦ ‖g x‖ * ‖g x‖) 2 μ := (hg.norm).mul (hg.norm)
    simpa [sq] using h
  exact hFm.integrable_mul hGm

lemma integrable_sqFun_sq_mul_bigH {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (hf : ∀ n, MemLp (f n) 4 μ) :
    Integrable (fun x ↦ sqFun f x ^ 2 * bigH f x) μ := by
  have h1 : Integrable (fun x ↦ sqFun f x ^ 2 * ‖∑ n, f n x‖ ^ 2) μ :=
    integrable_sqFun_sq_mul_normSq hf (memLp_finsetSum _ fun n _ ↦ hf n)
  have h2 : Integrable (fun x ↦ (sqFun f x ^ 2) ^ 2) μ := integrable_pow4_sqFun hf
  refine (h1.sub h2).congr (Filter.Eventually.of_forall fun x ↦ ?_)
  simp only [Pi.sub_apply, bigH]
  ring

/-! ### The bootstrap and Theorem 1.1 -/

/-- `‖∑ f_n‖_4^2 ≤ ‖S‖_4^2 + 2 A_N^2 M ‖S‖_4`. -/
lemma nrm4_sq_le {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (hf : OrderedSuperorthogonal μ f) :
    nrm4 μ (fun x ↦ ∑ n, f n x) ^ 2
      ≤ nrmS μ f ^ 2
        + hilbertKernelL1 N * (2 * hilbertKernelL1 N * bestConst μ f * nrmS μ f) := by
  have hpt : ∀ x : α, ‖∑ n, f n x‖ ^ 2 = sqFun f x ^ 2 + bigH f x := by
    intro x
    unfold bigH
    ring
  have h1 : nrm2 μ (fun x ↦ ‖∑ n, f n x‖ ^ 2)
      = nrm2 μ (fun x ↦ sqFun f x ^ 2 + bigH f x) := by
    unfold nrm2
    congr 1
    exact integral_congr_ae (Filter.Eventually.of_forall fun x ↦ by
      simp only []
      rw [hpt x])
  rw [← nrm2_normSq_eq, h1]
  refine (nrm2_add_le (integrable_pow4_sqFun hf.memLp) (integrable_sq_bigH hf.memLp)
    (integrable_sqFun_sq_mul_bigH hf.memLp)).trans ?_
  rw [nrm2_sqFun_eq]
  linarith [page9_bound hf]

/-- **The bootstrap inequality** `M^2 ≤ T^2 + 2 A_N^2 M T`, obtained by taking the
supremum over unimodular phase changes. -/
theorem bestConst_sq_le {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (hf : OrderedSuperorthogonal μ f) :
    bestConst μ f ^ 2
      ≤ nrmS μ f ^ 2
        + hilbertKernelL1 N * (2 * hilbertKernelL1 N * bestConst μ f * nrmS μ f) := by
  set R := nrmS μ f ^ 2
    + hilbertKernelL1 N * (2 * hilbertKernelL1 N * bestConst μ f * nrmS μ f) with hR
  have hMnn := bestConst_nonneg hf.memLp
  have hTnn := nrmS_nonneg μ f
  have hAnn := hilbertKernelL1_nonneg N
  have hRnn : 0 ≤ R := by rw [hR]; positivity
  have hub : ∀ t ∈ phaseNorms μ f, t ≤ Real.sqrt R := by
    rintro t ⟨c, hc, rfl⟩
    have h := nrm4_sq_le (orderedSuperorthogonal_phaseChange hf c)
    rw [nrmS_phaseChange μ f c hc, bestConst_phaseChange μ f c hc] at h
    have hnn := nrm4_nonneg μ (fun x ↦ ∑ n, phaseChange f c n x)
    have h2 := Real.sqrt_le_sqrt h
    rw [Real.sqrt_sq hnn] at h2
    exact h2
  have hle : bestConst μ f ≤ Real.sqrt R := csSup_le (phaseNorms_nonempty μ f) hub
  nlinarith [hle, hMnn, Real.sq_sqrt hRnn, Real.sqrt_nonneg R]

/-- Solving the quadratic: `M ≤ (1 + 2 A_N^2) ‖S‖_4`. -/
theorem bestConst_le {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (hf : OrderedSuperorthogonal μ f) :
    bestConst μ f ≤ (1 + 2 * hilbertKernelL1 N ^ 2) * nrmS μ f := by
  have hMnn := bestConst_nonneg hf.memLp
  have hTnn := nrmS_nonneg μ f
  have hAnn := hilbertKernelL1_nonneg N
  have hq := bestConst_sq_le hf
  by_contra hcon
  rw [not_le] at hcon
  have hM0 : 0 < bestConst μ f := by nlinarith [hcon, hTnn, hAnn]
  nlinarith [hq, hcon, hM0, hTnn, hAnn,
    mul_lt_mul_of_pos_right hcon hM0]

/-- **Theorem 1.1 of Cushman-Demeter-Wu.** Under the ordered superorthogonality hypothesis
(1.2) for quadruples, the `L^4` reverse square function estimate holds with the loss
`C (1 + log N)^2`; the absolute constant `C = 33` is explicit. -/
theorem cdw_theorem_1_1 {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (hf : OrderedSuperorthogonal μ f) :
    nrm4 μ (fun x ↦ ∑ n, f n x) ≤ 33 * (1 + Real.log N) ^ 2 * nrmS μ f := by
  have hAnn := hilbertKernelL1_nonneg N
  have hTnn := nrmS_nonneg μ f
  have hlog : (0:ℝ) ≤ Real.log N := Real.log_natCast_nonneg N
  have hA := hilbertKernelL1_le N
  have hAsq : hilbertKernelL1 N ^ 2 ≤ 16 * (1 + Real.log N) ^ 2 := by
    nlinarith [hA, hAnn, hlog]
  have hconst : (1 + 2 * hilbertKernelL1 N ^ 2) ≤ 33 * (1 + Real.log N) ^ 2 := by
    nlinarith [hAsq, hlog]
  calc nrm4 μ (fun x ↦ ∑ n, f n x)
      ≤ bestConst μ f := nrm4_sum_le_bestConst hf.memLp
    _ ≤ (1 + 2 * hilbertKernelL1 N ^ 2) * nrmS μ f := bestConst_le hf
    _ ≤ 33 * (1 + Real.log N) ^ 2 * nrmS μ f := mul_le_mul_of_nonneg_right hconst hTnn

/-! ### Corollary 2.3

This is not needed for Theorem 1.1; the source uses it to establish Theorem 1.4.
-/

/-- **Hypothesis (2.9)**: the extra cancellation available on a fixed radial annulus. -/
structure ExtraCancellation {N : ℕ} (μ : Measure α) (f : Fin N → α → ℂ) : Prop where
  /-- `∫ |f_i|^2 f_j \overline{f_k} = 0` whenever `j ≠ k`. -/
  vanish : ∀ i j k : Fin N, j ≠ k →
    ∫ x, (f i x * conj (f i x)) * (f j x * conj (f k x)) ∂μ = 0

omit [MeasurableSpace α] in
/-- The bilinear expansion of `|f_i|^2 |W_i|^2`. -/
lemma normSq_mul_normSq_signedSum_eq {N : ℕ} (f : Fin N → α → ℂ) (i : Fin N) (x : α) :
    ((‖f i x‖ ^ 2 * ‖signedSum f i x‖ ^ 2 : ℝ) : ℂ)
      = ∑ j : Fin N, ∑ k : Fin N,
          ((((j : ℤ) - (i : ℤ)).sign : ℝ) : ℂ) * ((((k : ℤ) - (i : ℤ)).sign : ℝ) : ℂ) *
            ((f i x * conj (f i x)) * (f j x * conj (f k x))) := by
  have hW : signedSum f i x = -∑ j : Fin N, (((j : ℤ) - (i : ℤ)).sign : ℂ) * f j x :=
    signedSum_eq_sum_sign f i x
  have hi : ((‖f i x‖ ^ 2 : ℝ) : ℂ) = f i x * conj (f i x) := by
    rw [Complex.mul_conj, Complex.normSq_eq_norm_sq]
  have hWsq : ((‖signedSum f i x‖ ^ 2 : ℝ) : ℂ)
      = signedSum f i x * conj (signedSum f i x) := by
    rw [Complex.mul_conj, Complex.normSq_eq_norm_sq]
  rw [Complex.ofReal_mul, hi, hWsq, hW, map_neg, map_sum]
  rw [show (-∑ j : Fin N, (((j : ℤ) - (i : ℤ)).sign : ℂ) * f j x) *
      (-∑ k : Fin N, conj ((((k : ℤ) - (i : ℤ)).sign : ℂ) * f k x))
      = (∑ j : Fin N, (((j : ℤ) - (i : ℤ)).sign : ℂ) * f j x) *
        (∑ k : Fin N, conj ((((k : ℤ) - (i : ℤ)).sign : ℂ) * f k x)) from by ring,
    Finset.sum_mul_sum, Finset.mul_sum]
  refine Finset.sum_congr rfl fun j _ ↦ ?_
  rw [Finset.mul_sum]
  refine Finset.sum_congr rfl fun k _ ↦ ?_
  rw [map_mul, map_intCast]
  push_cast
  ring

/-- Under (2.9) the mixed terms drop out. -/
lemma integral_normSq_mul_normSq_signedSum_le {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (hf : ∀ n, MemLp (f n) 4 μ) (h29 : ExtraCancellation μ f) (i : Fin N) :
    (∫ x, ‖f i x‖ ^ 2 * ‖signedSum f i x‖ ^ 2 ∂μ)
      ≤ ∑ j : Fin N, ∫ x, ‖f i x‖ ^ 2 * ‖f j x‖ ^ 2 ∂μ := by
  have hquad : ∀ j k : Fin N,
      Integrable (fun x ↦ (f i x * conj (f i x)) * (f j x * conj (f k x))) μ := by
    intro j k
    have h := integrable_quadruple hf i j i k
    refine h.congr (Filter.Eventually.of_forall fun x ↦ ?_)
    simp only [map_mul]
    ring
  -- the complex integral, expanded
  have hC : (∫ x, ((‖f i x‖ ^ 2 * ‖signedSum f i x‖ ^ 2 : ℝ) : ℂ) ∂μ)
      = ∑ j : Fin N, ((((j : ℤ) - (i : ℤ)).sign : ℝ) : ℂ) ^ 2 *
          ∫ x, (f i x * conj (f i x)) * (f j x * conj (f j x)) ∂μ := by
    rw [integral_congr_ae (Filter.Eventually.of_forall fun x ↦
        normSq_mul_normSq_signedSum_eq f i x),
      integral_finsetSum _ (fun j _ ↦ integrable_finsetSum _ fun k _ ↦
        ((hquad j k).const_mul _))]
    refine Finset.sum_congr rfl fun j _ ↦ ?_
    rw [integral_finsetSum _ (fun k _ ↦ (hquad j k).const_mul _)]
    rw [Finset.sum_eq_single_of_mem j (Finset.mem_univ j)]
    · rw [MeasureTheory.integral_const_mul]
      ring
    · intro k _ hk
      rw [MeasureTheory.integral_const_mul, h29.vanish i j k (Ne.symm hk), mul_zero]
  -- take real parts
  have hdiagpt : ∀ j : Fin N, ∀ x : α,
      (f i x * conj (f i x)) * (f j x * conj (f j x))
        = ((‖f i x‖ ^ 2 * ‖f j x‖ ^ 2 : ℝ) : ℂ) := by
    intro j x
    rw [Complex.ofReal_mul, Complex.mul_conj, Complex.mul_conj,
      Complex.normSq_eq_norm_sq, Complex.normSq_eq_norm_sq]
  have hdiag : ∀ j : Fin N,
      (∫ x, (f i x * conj (f i x)) * (f j x * conj (f j x)) ∂μ)
        = ((∫ x, ‖f i x‖ ^ 2 * ‖f j x‖ ^ 2 ∂μ : ℝ) : ℂ) := by
    intro j
    rw [integral_congr_ae (Filter.Eventually.of_forall fun x ↦ hdiagpt j x),
      _root_.integral_complex_ofReal]
  rw [_root_.integral_complex_ofReal,
    Finset.sum_congr rfl (fun j (_ : j ∈ Finset.univ) ↦ by rw [hdiag j])] at hC
  have hreal : (∫ x, ‖f i x‖ ^ 2 * ‖signedSum f i x‖ ^ 2 ∂μ)
      = ∑ j : Fin N, ((((j : ℤ) - (i : ℤ)).sign : ℝ)) ^ 2 *
          ∫ x, ‖f i x‖ ^ 2 * ‖f j x‖ ^ 2 ∂μ := by
    exact_mod_cast hC
  rw [hreal]
  refine Finset.sum_le_sum fun j _ ↦ ?_
  have hnn : (0:ℝ) ≤ ∫ x, ‖f i x‖ ^ 2 * ‖f j x‖ ^ 2 ∂μ :=
    integral_nonneg fun x ↦ by positivity
  have hs : ((((j : ℤ) - (i : ℤ)).sign : ℝ)) ^ 2 ≤ 1 := by
    rw [sign_sq_eq j i]
    split_ifs <;> norm_num
  nlinarith [hnn, hs]

lemma integrable_normSq_mul_normSq {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (hf : ∀ n, MemLp (f n) 4 μ) (m j : Fin N) :
    Integrable (fun x ↦ ‖f m x‖ ^ 2 * ‖f j x‖ ^ 2) μ := by
  have h := integrable_norm_mul₄ hf m m j j
  refine h.congr (Filter.Eventually.of_forall fun x ↦ ?_)
  simp only []
  ring

lemma sum_integral_normSq_mul_normSq {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (hf : ∀ n, MemLp (f n) 4 μ) :
    (∑ m : Fin N, ∑ j : Fin N, ∫ x, ‖f m x‖ ^ 2 * ‖f j x‖ ^ 2 ∂μ) = pow4S μ f := by
  have h1 : (∑ m : Fin N, ∑ j : Fin N, ∫ x, ‖f m x‖ ^ 2 * ‖f j x‖ ^ 2 ∂μ)
      = ∫ x, ∑ m : Fin N, ∑ j : Fin N, ‖f m x‖ ^ 2 * ‖f j x‖ ^ 2 ∂μ := by
    rw [integral_finsetSum _ (fun m _ ↦ integrable_finsetSum _ fun j _ ↦
      integrable_normSq_mul_normSq hf m j)]
    exact Finset.sum_congr rfl fun m _ ↦
      (integral_finsetSum _ fun j _ ↦ integrable_normSq_mul_normSq hf m j).symm
  rw [h1, pow4S]
  refine integral_congr_ae (Filter.Eventually.of_forall fun x ↦ ?_)
  simp only []
  rw [show (∑ m : Fin N, ∑ j : Fin N, ‖f m x‖ ^ 2 * ‖f j x‖ ^ 2)
      = (∑ m : Fin N, ‖f m x‖ ^ 2) ^ 2 from by rw [sq, Finset.sum_mul_sum], ← sq_sqFun]
  ring

/-- **Corollary 2.3**: under the extra cancellation (2.9) the logarithmic loss disappears,
`‖V‖_2^2 ≤ 4 ‖S‖_4^4`. -/
theorem corollary_2_3 {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (hf : OrderedSuperorthogonal μ f) (h29 : ExtraCancellation μ f) :
    ∫ x, bigV f x ^ 2 ∂μ ≤ 4 * pow4S μ f := by
  have hRow := integrable_sum_sq_rowSum hf.memLp
  have hWsum : Integrable (fun x ↦ ∑ m, ‖f m x‖ ^ 2 * ‖signedSum f m x‖ ^ 2) μ :=
    integrable_finsetSum _ fun m _ ↦ integrable_normSq_mul_normSq_signedSum hf.memLp m
  have step1 : (∫ x, ∑ m, rowSum f m x ^ 2 ∂μ)
      ≤ ∫ x, ∑ m, ‖f m x‖ ^ 2 * ‖signedSum f m x‖ ^ 2 ∂μ :=
    integral_mono hRow hWsum fun x ↦ Finset.sum_le_sum fun m _ ↦ sq_rowSum_le f m x
  have step2 : (∫ x, ∑ m, ‖f m x‖ ^ 2 * ‖signedSum f m x‖ ^ 2 ∂μ) ≤ pow4S μ f := by
    rw [integral_finsetSum _ (fun m _ ↦ integrable_normSq_mul_normSq_signedSum hf.memLp m),
      ← sum_integral_normSq_mul_normSq hf.memLp]
    exact Finset.sum_le_sum fun m _ ↦
      integral_normSq_mul_normSq_signedSum_le hf.memLp h29 m
  calc ∫ x, bigV f x ^ 2 ∂μ
      ≤ 4 * ∫ x, ∑ m, rowSum f m x ^ 2 ∂μ := integral_sq_bigV_le hf
    _ ≤ 4 * pow4S μ f := by linarith

/-- Hypothesis (2.9) is also unchanged by a unimodular phase change. -/
lemma extraCancellation_phaseChange {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (h29 : ExtraCancellation μ f) (c : Fin N → ℂ) (hc : ∀ n, ‖c n‖ = 1) :
    ExtraCancellation μ (phaseChange f c) where
  vanish i j k hjk := by
    have hx : ∀ x : α,
        (phaseChange f c i x * conj (phaseChange f c i x)) *
          (phaseChange f c j x * conj (phaseChange f c k x))
        = (c j * conj (c k)) *
            ((f i x * conj (f i x)) * (f j x * conj (f k x))) := by
      intro x
      unfold phaseChange
      simp only [map_mul]
      have hci : c i * conj (c i) = 1 := by
        rw [mul_comm]
        exact conj_mul_self_of_norm_one (hc i)
      calc c i * f i x * (conj (c i) * conj (f i x)) *
            (c j * f j x * (conj (c k) * conj (f k x)))
          = (c i * conj (c i)) * ((c j * conj (c k)) *
              ((f i x * conj (f i x)) * (f j x * conj (f k x)))) := by ring
        _ = (c j * conj (c k)) *
              ((f i x * conj (f i x)) * (f j x * conj (f k x))) := by
            rw [hci, one_mul]
    rw [integral_congr_ae (Filter.Eventually.of_forall hx),
      MeasureTheory.integral_const_mul, h29.vanish i j k hjk, mul_zero]

/-- **Corollary 2.3 for the phase-changed family**: the loss-free bound on `V(θ)`, uniform
in `θ`. This is the input to Lemma 4.2. -/
theorem integral_sq_bigVphase_le_of_extra {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (hf : OrderedSuperorthogonal μ f) (h29 : ExtraCancellation μ f) (θ : ℝ) :
    ∫ x, bigVphase f θ x ^ 2 ∂μ ≤ 4 * pow4S μ f := by
  have hc : ∀ n : Fin N, ‖eZ (n : ℤ) θ‖ = 1 := fun n ↦ norm_eZ _ _
  have h := corollary_2_3 (orderedSuperorthogonal_phaseChange hf (fun n ↦ eZ (n : ℤ) θ))
    (extraCancellation_phaseChange h29 (fun n ↦ eZ (n : ℤ) θ) hc)
  have hS : pow4S μ (phaseChange f (fun n ↦ eZ (n : ℤ) θ)) = pow4S μ f := by
    unfold pow4S
    exact integral_congr_ae (Filter.Eventually.of_forall fun x ↦ by
      simp only []
      rw [sqFun_phaseChange f (fun n ↦ eZ (n : ℤ) θ) hc x])
  rw [hS] at h
  exact h

/-! ### The identity behind (4.2)

`i V(θ)` is a signed trigonometric sum over ordered pairs. Combining
`symForm_phaseFamily` with `2 i Im z = z - conj z` and one reindexing collapses the two
`Im`-halves into a single sum with the sign weight.
-/

omit [MeasurableSpace α] in
lemma I_mul_im (z : ℂ) : Complex.I * ((z.im : ℝ) : ℂ) = (z - conj z) / 2 := by
  rw [Complex.sub_conj]
  push_cast
  ring

omit [MeasurableSpace α] in
/-- `i V(θ)` as a single signed trigonometric sum. -/
lemma I_mul_bigVphase_eq {N : ℕ} (f : Fin N → α → ℂ) (θ : ℝ) (x : α) :
    Complex.I * ((bigVphase f θ x : ℝ) : ℂ)
      = -∑ i : Fin N, ∑ j : Fin N,
          (((((i : ℤ) - (j : ℤ)).sign : ℝ)) : ℂ) *
            (eZ ((i : ℤ) - (j : ℤ)) θ * (f i x * conj (f j x))) := by
  set w : Fin N → Fin N → ℂ := fun i j ↦
    eZ ((i : ℤ) - (j : ℤ)) θ * (f i x * conj (f j x)) with hw
  set sg : Fin N → Fin N → ℂ := fun i j ↦ ((((i : ℤ) - (j : ℤ)).sign : ℝ) : ℂ) with hsg
  set sr : Fin N → Fin N → ℝ := fun i j ↦ ((((i : ℤ) - (j : ℤ)).sign : ℝ)) with hsr
  have hcast : ∀ i j : Fin N, ((sr i j : ℝ) : ℂ) = sg i j := fun _ _ ↦ rfl
  have hconj : ∀ i j : Fin N, conj (w i j) = w j i := by
    intro i j
    rw [hw]
    simp only [map_mul, Complex.conj_conj, conj_eZ, neg_sub]
    ring
  have hanti : ∀ i j : Fin N, sg j i = -sg i j := by
    intro i j
    rw [hsg]
    simp only []
    rw [show ((j : ℤ) - (i : ℤ)) = -((i : ℤ) - (j : ℤ)) by ring, Int.sign_neg]
    push_cast
    ring
  -- expand `V(θ)` through the symmetric form
  have hV : ((bigVphase f θ x : ℝ) : ℂ)
      = ∑ i : Fin N, ∑ j : Fin N, ((-(sr i j) * (w i j).im : ℝ) : ℂ) := by
    rw [bigVphase, bigV, ← sum_sum_symForm, Complex.ofReal_sum]
    refine Finset.sum_congr rfl fun i _ ↦ ?_
    rw [Complex.ofReal_sum]
    refine Finset.sum_congr rfl fun j _ ↦ ?_
    rw [symForm_phaseFamily]
  rw [hV, Finset.mul_sum]
  have hstep : ∀ i : Fin N, Complex.I * ∑ j : Fin N, ((-(sr i j) * (w i j).im : ℝ) : ℂ)
      = ∑ j : Fin N, -sg i j * ((w i j - w j i) / 2) := by
    intro i
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun j _ ↦ ?_
    have hIm : Complex.I * (((w i j).im : ℝ) : ℂ) = (w i j - w j i) / 2 := by
      rw [I_mul_im, hconj i j]
    rw [Complex.ofReal_mul, Complex.ofReal_neg, hcast i j]
    rw [show Complex.I * (-sg i j * (((w i j).im : ℝ) : ℂ))
        = -sg i j * (Complex.I * (((w i j).im : ℝ) : ℂ)) from by ring, hIm]
  rw [Finset.sum_congr rfl fun i _ ↦ hstep i]
  have hswap : (∑ i : Fin N, ∑ j : Fin N, sg i j * w j i)
      = -∑ i : Fin N, ∑ j : Fin N, sg i j * w i j := by
    rw [Finset.sum_comm, ← Finset.sum_neg_distrib]
    refine Finset.sum_congr rfl fun i _ ↦ ?_
    rw [← Finset.sum_neg_distrib]
    refine Finset.sum_congr rfl fun j _ ↦ ?_
    rw [hanti j i]
    ring
  have hsplit : (∑ i : Fin N, ∑ j : Fin N, -sg i j * ((w i j - w j i) / 2))
      = -(1/2) * (∑ i : Fin N, ∑ j : Fin N, sg i j * w i j)
        + (1/2) * (∑ i : Fin N, ∑ j : Fin N, sg i j * w j i) := by
    rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun i _ ↦ ?_
    rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun j _ ↦ ?_
    ring
  rw [hsplit, hswap]
  ring

/-! ### A reusable interchange against `V(θ)`

The weight `W` is paired against `V(θ)` through a continuous kernel. Because `i V(θ)` is a
finite trigonometric sum (`I_mul_bigVphase_eq`), the interchange needs only linearity of the
two integrals - no Fubini, so `μ` stays arbitrary.
-/

/-- **Interchange**: a weight paired against `V(θ)` through a continuous kernel. -/
theorem swap_weight_bigVphase {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (W : α → ℂ) (Kf : ℝ → ℂ) (hKf : Continuous Kf)
    (hint : ∀ i j : Fin N, Integrable (fun x ↦ W x * (f i x * conj (f j x))) μ) :
    (∫ x, W x * (∫ θ in (0:ℝ)..1, Kf θ * (Complex.I * ((bigVphase f θ x : ℝ) : ℂ))) ∂μ)
      = ∫ θ in (0:ℝ)..1, Kf θ * ∫ x, W x * (Complex.I * ((bigVphase f θ x : ℝ) : ℂ)) ∂μ := by
  set sg : Fin N → Fin N → ℂ := fun i j ↦ ((((i : ℤ) - (j : ℤ)).sign : ℝ) : ℂ) with hsg
  set κ : Fin N → Fin N → ℂ :=
    fun i j ↦ ∫ θ in (0:ℝ)..1, Kf θ * eZ ((i : ℤ) - (j : ℤ)) θ with hκ
  have hcont : ∀ i j : Fin N, Continuous fun θ : ℝ ↦ Kf θ * eZ ((i : ℤ) - (j : ℤ)) θ :=
    fun i j ↦ hKf.mul (continuous_eZ _)
  -- the pointwise inner integral
  have hinner : ∀ x : α,
      W x * (∫ θ in (0:ℝ)..1, Kf θ * (Complex.I * ((bigVphase f θ x : ℝ) : ℂ)))
      = ∑ i : Fin N, ∑ j : Fin N, (-(sg i j) * κ i j) * (W x * (f i x * conj (f j x))) := by
    intro x
    have hexp : ∀ θ : ℝ, Kf θ * (Complex.I * ((bigVphase f θ x : ℝ) : ℂ))
        = ∑ i : Fin N, ∑ j : Fin N,
            (-(sg i j) * (f i x * conj (f j x))) * (Kf θ * eZ ((i : ℤ) - (j : ℤ)) θ) := by
      intro θ
      rw [I_mul_bigVphase_eq, ← Finset.sum_neg_distrib, Finset.mul_sum]
      refine Finset.sum_congr rfl fun i _ ↦ ?_
      rw [← Finset.sum_neg_distrib, Finset.mul_sum]
      exact Finset.sum_congr rfl fun j _ ↦ by rw [hsg]; ring
    rw [intervalIntegral.integral_congr (fun θ _ ↦ hexp θ),
      intervalIntegral.integral_finsetSum (s := (Finset.univ : Finset (Fin N)))
        (f := fun (i : Fin N) (θ : ℝ) ↦ ∑ j : Fin N,
          (-(sg i j) * (f i x * conj (f j x))) * (Kf θ * eZ ((i : ℤ) - (j : ℤ)) θ))
        (fun i _ ↦ (continuous_finsetSum _ fun j _ ↦
          (hcont i j).const_mul _).intervalIntegrable _ _), Finset.mul_sum]
    refine Finset.sum_congr rfl fun i _ ↦ ?_
    rw [intervalIntegral.integral_finsetSum (s := (Finset.univ : Finset (Fin N)))
      (f := fun (j : Fin N) (θ : ℝ) ↦
        (-(sg i j) * (f i x * conj (f j x))) * (Kf θ * eZ ((i : ℤ) - (j : ℤ)) θ))
      (fun j _ ↦ ((hcont i j).const_mul _).intervalIntegrable _ _), Finset.mul_sum]
    refine Finset.sum_congr rfl fun j _ ↦ ?_
    rw [intervalIntegral.integral_const_mul]
    simp only [hκ]
    ring
  -- the pointwise outer integrand
  have houter : ∀ θ : ℝ, (∫ x, W x * (Complex.I * ((bigVphase f θ x : ℝ) : ℂ)) ∂μ)
      = ∑ i : Fin N, ∑ j : Fin N,
          (-(sg i j) * eZ ((i : ℤ) - (j : ℤ)) θ) *
            ∫ x, W x * (f i x * conj (f j x)) ∂μ := by
    intro θ
    have hx : ∀ x : α, W x * (Complex.I * ((bigVphase f θ x : ℝ) : ℂ))
        = ∑ i : Fin N, ∑ j : Fin N,
            (-(sg i j) * eZ ((i : ℤ) - (j : ℤ)) θ) * (W x * (f i x * conj (f j x))) := by
      intro x
      rw [I_mul_bigVphase_eq, ← Finset.sum_neg_distrib, Finset.mul_sum]
      refine Finset.sum_congr rfl fun i _ ↦ ?_
      rw [← Finset.sum_neg_distrib, Finset.mul_sum]
      exact Finset.sum_congr rfl fun j _ ↦ by rw [hsg]; ring
    rw [integral_congr_ae (Filter.Eventually.of_forall hx),
      integral_finsetSum _ (fun i _ ↦ integrable_finsetSum _ fun j _ ↦ (hint i j).const_mul _)]
    refine Finset.sum_congr rfl fun i _ ↦ ?_
    rw [integral_finsetSum _ (fun j _ ↦ (hint i j).const_mul _)]
    exact Finset.sum_congr rfl fun j _ ↦ MeasureTheory.integral_const_mul _ _
  rw [integral_congr_ae (Filter.Eventually.of_forall hinner),
    integral_finsetSum _ (fun i _ ↦ integrable_finsetSum _ fun j _ ↦ (hint i j).const_mul _)]
  rw [intervalIntegral.integral_congr (fun θ _ ↦ by rw [houter θ])]
  have hKcont : ∀ i j : Fin N, Continuous fun θ : ℝ ↦ Kf θ *
      ((-(sg i j) * eZ ((i : ℤ) - (j : ℤ)) θ) * ∫ x, W x * (f i x * conj (f j x)) ∂μ) :=
    fun i j ↦ hKf.mul (((continuous_const.mul (continuous_eZ _)).mul continuous_const))
  have hKsum : ∀ θ : ℝ, Kf θ * ∑ i : Fin N, ∑ j : Fin N,
      (-(sg i j) * eZ ((i : ℤ) - (j : ℤ)) θ) * ∫ x, W x * (f i x * conj (f j x)) ∂μ
      = ∑ i : Fin N, ∑ j : Fin N, Kf θ *
          ((-(sg i j) * eZ ((i : ℤ) - (j : ℤ)) θ) *
            ∫ x, W x * (f i x * conj (f j x)) ∂μ) := by
    intro θ
    rw [Finset.mul_sum]
    exact Finset.sum_congr rfl fun i _ ↦ Finset.mul_sum _ _ _
  rw [intervalIntegral.integral_congr (fun θ _ ↦ hKsum θ),
    intervalIntegral.integral_finsetSum (s := (Finset.univ : Finset (Fin N)))
      (f := fun (i : Fin N) (θ : ℝ) ↦ ∑ j : Fin N, Kf θ *
        ((-(sg i j) * eZ ((i : ℤ) - (j : ℤ)) θ) * ∫ x, W x * (f i x * conj (f j x)) ∂μ))
      (fun i _ ↦ (continuous_finsetSum _ fun j _ ↦ hKcont i j).intervalIntegrable _ _)]
  refine Finset.sum_congr rfl fun i _ ↦ ?_
  rw [integral_finsetSum _ (fun j _ ↦ (hint i j).const_mul _),
    intervalIntegral.integral_finsetSum (s := (Finset.univ : Finset (Fin N)))
      (f := fun (j : Fin N) (θ : ℝ) ↦ Kf θ *
        ((-(sg i j) * eZ ((i : ℤ) - (j : ℤ)) θ) * ∫ x, W x * (f i x * conj (f j x)) ∂μ))
      (fun j _ ↦ (hKcont i j).intervalIntegrable _ _)]
  refine Finset.sum_congr rfl fun j _ ↦ ?_
  rw [MeasureTheory.integral_const_mul]
  have hpull : ∀ θ : ℝ, Kf θ *
      ((-(sg i j) * eZ ((i : ℤ) - (j : ℤ)) θ) * ∫ x, W x * (f i x * conj (f j x)) ∂μ)
      = (-(sg i j) * ∫ x, W x * (f i x * conj (f j x)) ∂μ) *
          (Kf θ * eZ ((i : ℤ) - (j : ℤ)) θ) := fun θ ↦ by ring
  rw [intervalIntegral.integral_congr (fun θ _ ↦ hpull θ),
    intervalIntegral.integral_const_mul]
  simp only [hκ]
  ring

/-- A product of two real functions with integrable squares is integrable. -/
lemma integrable_mul_of_sq {μ : Measure α} {u v : α → ℝ}
    (hu : Integrable (fun x ↦ u x ^ 2) μ) (hv : Integrable (fun x ↦ v x ^ 2) μ)
    (hm : AEStronglyMeasurable (fun x ↦ u x * v x) μ) :
    Integrable (fun x ↦ u x * v x) μ := by
  refine Integrable.mono' ((hu.add hv).const_mul (1/2)) hm
    (Filter.Eventually.of_forall fun x ↦ ?_)
  simp only [Pi.add_apply]
  rw [Real.norm_eq_abs, abs_le]
  constructor <;> nlinarith [sq_nonneg (u x - v x), sq_nonneg (u x + v x)]

omit [MeasurableSpace α] in
lemma continuous_bigVphase_of {N : ℕ} {β : Type*} [TopologicalSpace β]
    (f : Fin N → β → ℂ) (hf : ∀ n, Continuous (f n)) (θ : ℝ) :
    Continuous fun x ↦ bigVphase f θ x := by
  have hterm : ∀ i j : Fin N, Continuous fun x ↦ symForm (phaseFamily f θ) i j x := by
    intro i j
    have hpt : ∀ x : β, symForm (phaseFamily f θ) i j x
        = -(((i : ℤ) - (j : ℤ)).sign : ℝ) *
            (eZ ((i : ℤ) - (j : ℤ)) θ * (f i x * conj (f j x))).im :=
      fun x ↦ symForm_phaseFamily f θ i j x
    rw [funext hpt]
    exact continuous_const.mul
      (Complex.continuous_im.comp (continuous_const.mul ((hf i).mul ((hf j).star))))
  have hfun : (fun x ↦ bigVphase f θ x)
      = fun x ↦ ∑ i : Fin N, ∑ j : Fin N, symForm (phaseFamily f θ) i j x := by
    funext x
    rw [bigVphase, bigV, ← sum_sum_symForm]
  rw [hfun]
  exact continuous_finsetSum _ fun i _ ↦ continuous_finsetSum _ fun j _ ↦ hterm i j

/-- The weighted pairing against `iV(θ)` expanded as a finite trigonometric sum. This is
the `θ`-dependence of the pairing made explicit, which is what gives its continuity. -/
theorem integral_weight_bigVphase_eq {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (W : α → ℂ)
    (hint : ∀ i j : Fin N, Integrable (fun x ↦ W x * (f i x * conj (f j x))) μ) (θ : ℝ) :
    (∫ x, W x * (Complex.I * ((bigVphase f θ x : ℝ) : ℂ)) ∂μ)
      = ∑ i : Fin N, ∑ j : Fin N,
          (-((((i : ℤ) - (j : ℤ)).sign : ℝ) : ℂ) * eZ ((i : ℤ) - (j : ℤ)) θ) *
            ∫ x, W x * (f i x * conj (f j x)) ∂μ := by
  have hx : ∀ x : α, W x * (Complex.I * ((bigVphase f θ x : ℝ) : ℂ))
      = ∑ i : Fin N, ∑ j : Fin N,
          (-((((i : ℤ) - (j : ℤ)).sign : ℝ) : ℂ) * eZ ((i : ℤ) - (j : ℤ)) θ) *
            (W x * (f i x * conj (f j x))) := by
    intro x
    rw [I_mul_bigVphase_eq, ← Finset.sum_neg_distrib, Finset.mul_sum]
    refine Finset.sum_congr rfl fun i _ ↦ ?_
    rw [← Finset.sum_neg_distrib, Finset.mul_sum]
    exact Finset.sum_congr rfl fun j _ ↦ by ring
  rw [integral_congr_ae (Filter.Eventually.of_forall hx),
    integral_finsetSum _ (fun i _ ↦ integrable_finsetSum _ fun j _ ↦ (hint i j).const_mul _)]
  refine Finset.sum_congr rfl fun i _ ↦ ?_
  rw [integral_finsetSum _ (fun j _ ↦ (hint i j).const_mul _)]
  exact Finset.sum_congr rfl fun j _ ↦ MeasureTheory.integral_const_mul _ _

/-- The kernel times the weighted pairing is continuous in `θ`. -/
theorem continuous_weight_kernel_pairing {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (W : α → ℂ) (Kf : ℝ → ℂ) (hKf : Continuous Kf)
    (hint : ∀ i j : Fin N, Integrable (fun x ↦ W x * (f i x * conj (f j x))) μ) :
    Continuous fun θ : ℝ ↦
      Kf θ * ∫ x, W x * (Complex.I * ((bigVphase f θ x : ℝ) : ℂ)) ∂μ := by
  have h : (fun θ : ℝ ↦ Kf θ * ∫ x, W x * (Complex.I * ((bigVphase f θ x : ℝ) : ℂ)) ∂μ)
      = fun θ : ℝ ↦ Kf θ * ∑ i : Fin N, ∑ j : Fin N,
          (-((((i : ℤ) - (j : ℤ)).sign : ℝ) : ℂ) * eZ ((i : ℤ) - (j : ℤ)) θ) *
            ∫ x, W x * (f i x * conj (f j x)) ∂μ :=
    funext fun θ ↦ by rw [integral_weight_bigVphase_eq W hint θ]
  rw [h]
  exact hKf.mul (continuous_finsetSum _ fun i _ ↦ continuous_finsetSum _ fun j _ ↦
    (continuous_const.mul (continuous_eZ _)).mul continuous_const)

/-- Measurability of a finite sum of real-valued functions. -/
lemma aestronglyMeasurable_finsetSumReal {ι : Type*} (s : Finset ι) {μ : Measure α}
    {g : ι → α → ℝ} (hg : ∀ i ∈ s, AEStronglyMeasurable (g i) μ) :
    AEStronglyMeasurable (fun x ↦ ∑ i ∈ s, g i x) μ := by
  have heq : (∑ i ∈ s, g i) = fun x ↦ ∑ i ∈ s, g i x := by
    funext x
    simp
  rw [← heq]
  exact Finset.aestronglyMeasurable_sum _ hg

/-- `V` is measurable whenever the family is. -/
lemma aestronglyMeasurable_bigV {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (hf : ∀ n, MemLp (f n) 4 μ) : AEStronglyMeasurable (fun x ↦ bigV f x) μ := by
  have heq : (fun x ↦ bigV f x) = fun x ↦ ∑ i : Fin N, ∑ j : Fin N, symForm f i j x :=
    funext fun x ↦ by rw [bigV, ← sum_sum_symForm]
  rw [heq]
  exact aestronglyMeasurable_finsetSumReal _ fun i _ ↦
    aestronglyMeasurable_finsetSumReal _ fun j _ ↦ aestronglyMeasurable_symForm hf i j

/-- The first half of `nrm4_sq_le`, isolated: `‖∑ f_n‖₄² ≤ ‖S‖₄² + ‖H‖₂`. -/
lemma nrm4_sq_le_nrm2_bigH {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (hf : ∀ n, MemLp (f n) 4 μ) :
    nrm4 μ (fun x ↦ ∑ n, f n x) ^ 2 ≤ nrmS μ f ^ 2 + nrm2 μ (bigH f) := by
  have hpt : ∀ x : α, ‖∑ n, f n x‖ ^ 2 = sqFun f x ^ 2 + bigH f x := by
    intro x
    unfold bigH
    ring
  have h1 : nrm2 μ (fun x ↦ ‖∑ n, f n x‖ ^ 2)
      = nrm2 μ (fun x ↦ sqFun f x ^ 2 + bigH f x) := by
    unfold nrm2
    congr 1
    exact integral_congr_ae (Filter.Eventually.of_forall fun x ↦ by
      simp only []
      rw [hpt x])
  rw [← nrm2_normSq_eq, h1]
  refine (nrm2_add_le (integrable_pow4_sqFun hf) (integrable_sq_bigH hf)
    (integrable_sqFun_sq_mul_bigH hf)).trans ?_
  rw [nrm2_sqFun_eq]

/-- Monotonicity of the `L²` norm under a pointwise bound. -/
lemma nrm2_mono {μ : Measure α} {a b : α → ℝ} (hb : Integrable (fun x ↦ b x ^ 2) μ)
    (h : ∀ x, |a x| ≤ b x) : nrm2 μ a ≤ nrm2 μ b := by
  refine nrm2_le_of_sq_le (nrm2_nonneg μ b) ?_
  rw [nrm2_sq]
  refine integral_mono_of_nonneg (Filter.Eventually.of_forall fun x ↦ sq_nonneg _) hb
    (Filter.Eventually.of_forall fun x ↦ ?_)
  simp only []
  nlinarith [h x, abs_nonneg (a x), sq_abs (a x)]

