  · have hc : (2 * ↑π * I * (k : ℂ)) ≠ 0 := by
      simp only [ne_eq, mul_eq_zero, not_or]
      refine ⟨⟨⟨two_ne_zero, ?_⟩, Complex.I_ne_zero⟩, ?_⟩
      · exact_mod_cast Real.pi_ne_zero
      · exact_mod_cast hk
