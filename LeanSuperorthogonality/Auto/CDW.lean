lemma continuous_eZ (k : ℤ) : Continuous (eZ k) :=
  by unfold eZ e; fun_prop

lemma intervalIntegrable_eZ (k : ℤ) (a b : ℝ) :
    IntervalIntegrable (eZ k) volume a b :=
  (continuous_eZ k).intervalIntegrable _ _

