/-! ### The setting of Theorem 1.1 -/

variable {α : Type*}

/-- The square function `S = (∑_n |f_n|^2)^{1/2}` of a finite family, as in Section 2 of
the source. -/
def sqFun {N : ℕ} (f : Fin N → α → ℂ) (x : α) : ℝ := Real.sqrt (∑ n, ‖f n x‖ ^ 2)

lemma sqFun_nonneg {N : ℕ} (f : Fin N → α → ℂ) (x : α) : 0 ≤ sqFun f x :=
  Real.sqrt_nonneg _

lemma sq_sqFun {N : ℕ} (f : Fin N → α → ℂ) (x : α) :
    sqFun f x ^ 2 = ∑ n, ‖f n x‖ ^ 2 :=
  Real.sq_sqrt (Finset.sum_nonneg fun _ _ ↦ sq_nonneg _)

/-- A phase change does not alter the square function. -/
lemma sqFun_phase {N : ℕ} (f : Fin N → α → ℂ) (c : Fin N → ℂ) (hc : ∀ n, ‖c n‖ = 1)
    (x : α) : sqFun (fun n y ↦ c n * f n y) x = sqFun f x := by
  unfold sqFun
  congr 1
  exact Finset.sum_congr rfl fun n _ ↦ by rw [norm_mul, hc n, one_mul]

/-- Pointwise Cauchy-Schwarz: `|∑_n c_n f_n(x)| ≤ √N · S(x)` whenever `‖c_n‖ ≤ 1`. -/
lemma norm_sum_le_sqrt_mul_sqFun {N : ℕ} (f : Fin N → α → ℂ) (c : Fin N → ℂ)
    (hc : ∀ n, ‖c n‖ ≤ 1) (x : α) :
    ‖∑ n, c n * f n x‖ ≤ Real.sqrt N * sqFun f x := by
  have h1 : ‖∑ n, c n * f n x‖ ≤ ∑ n, ‖f n x‖ := by
    refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun n _ ↦ ?_)
    rw [norm_mul]
    exact mul_le_of_le_one_left (norm_nonneg _) (hc n)
  refine h1.trans ?_
  have h2 : (∑ n, ‖f n x‖) ^ 2 ≤ (N : ℝ) * ∑ n, ‖f n x‖ ^ 2 := by
    have := sq_sum_le_card_mul_sum_sq (s := (Finset.univ : Finset (Fin N)))
      (f := fun n ↦ ‖f n x‖)
    simpa using this
  have h3 : ((N : ℝ) * ∑ n, ‖f n x‖ ^ 2) = (Real.sqrt N * sqFun f x) ^ 2 := by
    rw [mul_pow, Real.sq_sqrt (by positivity), sq_sqFun]
  rw [h3] at h2
  have hnn : (0:ℝ) ≤ Real.sqrt N * sqFun f x :=
    mul_nonneg (Real.sqrt_nonneg _) (sqFun_nonneg f x)
  have hsum : (0:ℝ) ≤ ∑ n, ‖f n x‖ := Finset.sum_nonneg fun _ _ ↦ norm_nonneg _
  nlinarith [h2, hnn, hsum]

/-! ### The imaginary-part quadratic form of Lemma 2.2 -/

/-- The entries `a_{ij} = Im(f_i \overline{f_j})` of the quadratic form in Lemma 2.2. -/
def imForm {N : ℕ} (f : Fin N → α → ℂ) (i j : Fin N) (x : α) : ℝ :=
  (f i x * conj (f j x)).im

lemma imForm_antisymm {N : ℕ} (f : Fin N → α → ℂ) (i j : Fin N) (x : α) :
    imForm f j i x = -imForm f i j x := by
  unfold imForm
  rw [show f j x * conj (f i x) = conj (f i x * conj (f j x)) by
    simp only [map_mul, Complex.conj_conj]; ring, Complex.conj_im]

lemma imForm_self {N : ℕ} (f : Fin N → α → ℂ) (i : Fin N) (x : α) : imForm f i i x = 0 := by
  have := imForm_antisymm f i i x
  linarith

lemma abs_imForm_le {N : ℕ} (f : Fin N → α → ℂ) (i j : Fin N) (x : α) :
    |imForm f i j x| ≤ ‖f i x‖ * ‖f j x‖ := by
  unfold imForm
  refine (Complex.abs_im_le_norm _).trans ?_
  rw [norm_mul, RCLike.norm_conj]

/-- **The quartic identity** in the proof of Lemma 2.2: for an ordered quadruple the three
pairings of the imaginary-part form combine into the real part of the two nonalternating
products, `a_{ij}a_{kl} + a_{ik}a_{jl} + a_{il}a_{jk} =
Re(f_i f_l \overline{f_j f_k} - f_i f_j \overline{f_k f_l})`. -/
lemma imForm_quartic {N : ℕ} (f : Fin N → α → ℂ) (i j k l : Fin N) (x : α) :
    imForm f i j x * imForm f k l x + imForm f i k x * imForm f j l x
        + imForm f i l x * imForm f j k x
      = (f i x * f l x * conj (f j x * f k x)
          - f i x * f j x * conj (f k x * f l x)).re := by
  unfold imForm
  simp only [Complex.mul_im, Complex.mul_re, Complex.conj_re, Complex.conj_im,
    Complex.sub_re]
  ring

/-- The row sum `R_i = ∑_{j<i} a_{ji} + ∑_{j>i} a_{ij}`: the sum of the form over all
unordered pairs containing `i`. -/
def rowSum {N : ℕ} (f : Fin N → α → ℂ) (i : Fin N) (x : α) : ℝ :=
  (∑ j ∈ Finset.univ.filter (· < i), imForm f j i x)
    + ∑ j ∈ Finset.univ.filter (i < ·), imForm f i j x

/-- Closed form for the row sum:
`R_i = Im[\overline{f_i} (∑_{j<i} f_j - ∑_{j>i} f_j)]`, as used just before (2.6). -/
lemma rowSum_eq_im {N : ℕ} (f : Fin N → α → ℂ) (i : Fin N) (x : α) :
    rowSum f i x = (conj (f i x) *
      ((∑ j ∈ Finset.univ.filter (· < i), f j x)
        - ∑ j ∈ Finset.univ.filter (i < ·), f j x)).im := by
  have hj : ∀ j : Fin N, (conj (f i x) * f j x).im = imForm f j i x := by
    intro j
    unfold imForm
    simp only [Complex.mul_im, Complex.conj_re, Complex.conj_im]
    ring
  rw [mul_sub, Complex.sub_im, Finset.mul_sum, Finset.mul_sum, Complex.im_sum,
    Complex.im_sum]
  simp only [hj, rowSum]
  rw [sub_eq_add_neg, ← Finset.sum_neg_distrib]
  congr 1
  exact Finset.sum_congr rfl fun j _ ↦ imForm_antisymm f j i x

/-- Pointwise bound on the row sum, giving (2.6): `R_i^2 ≤ |f_i|^2 |∑_{j<i} f_j -
∑_{j>i} f_j|^2`. -/
lemma sq_rowSum_le {N : ℕ} (f : Fin N → α → ℂ) (i : Fin N) (x : α) :
    rowSum f i x ^ 2 ≤ ‖f i x‖ ^ 2 *
      ‖(∑ j ∈ Finset.univ.filter (· < i), f j x)
        - ∑ j ∈ Finset.univ.filter (i < ·), f j x‖ ^ 2 := by
  set w : ℂ := (∑ j ∈ Finset.univ.filter (· < i), f j x)
    - ∑ j ∈ Finset.univ.filter (i < ·), f j x with hw
  rw [rowSum_eq_im, ← mul_pow, ← RCLike.norm_conj (f i x)]
  have h := Complex.abs_im_le_norm (conj (f i x) * w)
  rw [norm_mul] at h
  nlinarith [h, abs_nonneg (conj (f i x) * w).im, sq_abs (conj (f i x) * w).im,
    norm_nonneg (conj (f i x)), norm_nonneg w]

/-! ### The symmetric form and its row sums

Orienting each unordered pair turns the antisymmetric `a_{ij}` into a symmetric form `G`
with vanishing diagonal, for which the row sum `R_i` of Lemma 2.2 is simply `∑_j G_{ij}`
and the total `∑_{i<j} a_{ij}` is `½ ∑_{i,j} G_{ij}`. All the counting in the proof of
Lemma 2.2 becomes ordinary bilinear algebra in this form.
-/

/-- The symmetric form `G_{ij}`, equal to `a_{ij}` when `i < j`, to `a_{ji}` when `j < i`,
and to `0` on the diagonal. -/
def symForm {N : ℕ} (f : Fin N → α → ℂ) (i j : Fin N) (x : α) : ℝ :=
  if i < j then imForm f i j x else if j < i then imForm f j i x else 0

lemma symForm_comm {N : ℕ} (f : Fin N → α → ℂ) (i j : Fin N) (x : α) :
    symForm f i j x = symForm f j i x := by
  unfold symForm
  rcases lt_trichotomy i j with h | h | h
  · rw [if_pos h, if_neg (asymm h), if_pos h]
  · subst h; simp
  · rw [if_neg (asymm h), if_pos h, if_pos h]

@[simp] lemma symForm_self {N : ℕ} (f : Fin N → α → ℂ) (i : Fin N) (x : α) :
    symForm f i i x = 0 := by
  simp [symForm]

lemma symForm_of_lt {N : ℕ} (f : Fin N → α → ℂ) {i j : Fin N} (h : i < j) (x : α) :
    symForm f i j x = imForm f i j x := by
  simp [symForm, h]

/-- The row sum of Lemma 2.2 is the full row sum of the symmetric form. -/
lemma rowSum_eq_sum_symForm {N : ℕ} (f : Fin N → α → ℂ) (i : Fin N) (x : α) :
    rowSum f i x = ∑ j, symForm f i j x := by
  rw [rowSum, ← Finset.sum_filter_add_sum_filter_not Finset.univ (fun j ↦ j < i)
    (fun j ↦ symForm f i j x)]
  have h1 : ∀ j ∈ Finset.univ.filter (fun j ↦ j < i), symForm f i j x = imForm f j i x := by
    intro j hj
    have hji : j < i := (Finset.mem_filter.mp hj).2
    simp [symForm, asymm hji, hji]
  have h2 : (∑ j ∈ Finset.univ.filter (fun j ↦ ¬ j < i), symForm f i j x)
      = ∑ j ∈ Finset.univ.filter (fun j ↦ i < j), imForm f i j x := by
    rw [Finset.sum_filter, Finset.sum_filter]
    refine Finset.sum_congr rfl fun j _ ↦ ?_
    rcases lt_trichotomy i j with h | h | h
    · rw [if_pos (not_lt.mpr h.le), if_pos h, symForm_of_lt f h]
    · subst h; simp
    · rw [if_neg (by simpa using h), if_neg (asymm h)]
  rw [h2, Finset.sum_congr rfl h1]

/-- Half the total mass of the symmetric form is the sum over ordered pairs. -/
lemma sum_sum_symForm {N : ℕ} (f : Fin N → α → ℂ) (x : α) :
    ∑ i, ∑ j, symForm f i j x = ∑ i, rowSum f i x := by
  exact (Finset.sum_congr rfl fun i _ ↦ (rowSum_eq_sum_symForm f i x)).symm

/-! ### Inclusion-exclusion for disjoint index pairs

The counting step in the proof of Lemma 2.2 is carried out here as a statement about an
arbitrary symmetric form with vanishing diagonal. Writing `R_i` for the row sums, `U` for
the total mass and summing the inner double sum by inclusion-exclusion on the two removed
indices turns the sum over quadruples of disjoint pairs into ordinary bilinear data. This
avoids grouping the quadruples by their underlying four-element index sets.
-/

/-- Removing two distinct indices from a sum over `Fin N`. -/
lemma sum_filter_ne_pair {N : ℕ} {β : Type*} [AddCommGroup β] (F : Fin N → β)
    {i j : Fin N} (hij : i ≠ j) :
    ∑ k ∈ Finset.univ.filter (fun k ↦ k ≠ i ∧ k ≠ j), F k = (∑ k, F k) - F i - F j := by
  have hset : Finset.univ.filter (fun k : Fin N ↦ k ≠ i ∧ k ≠ j) = Finset.univ \ {i, j} := by
    ext k; simp
  rw [hset, Finset.sum_sdiff_eq_sub (Finset.subset_univ _), Finset.sum_pair hij]
  abel

/-- **Inclusion-exclusion identity.** For a symmetric form `G` with vanishing diagonal, the
sum of `G_{ij} G_{kl}` over quadruples with `{k,l}` disjoint from `{i,j}` equals
`U^2 - 4 ∑_i R_i^2 + 2 ∑_{i,j} G_{ij}^2`, where `R_i = ∑_j G_{ij}` and `U = ∑_{i,j} G_{ij}`. -/
lemma sum_disjoint_pairs {N : ℕ} (G : Fin N → Fin N → ℝ)
    (hsymm : ∀ i j, G i j = G j i) (hdiag : ∀ i, G i i = 0) :
    (∑ i, ∑ j, G i j * ∑ k ∈ Finset.univ.filter (fun k ↦ k ≠ i ∧ k ≠ j),
        ∑ l ∈ Finset.univ.filter (fun l ↦ l ≠ i ∧ l ≠ j), G k l)
      = (∑ i, ∑ j, G i j) ^ 2 - 4 * ∑ i, (∑ j, G i j) ^ 2
        + 2 * ∑ i, ∑ j, G i j ^ 2 := by
  set R : Fin N → ℝ := fun i ↦ ∑ j, G i j with hR
  set U : ℝ := ∑ i, R i with hU
  have hcol : ∀ j, (∑ i, G i j) = R j := by
    intro j
    simp only [hR]
    exact Finset.sum_congr rfl fun i _ ↦ hsymm i j
  -- the inner double sum, by inclusion-exclusion on the two removed indices
  have hTot : ∀ i j : Fin N,
      G i j * (∑ k ∈ Finset.univ.filter (fun k ↦ k ≠ i ∧ k ≠ j),
        ∑ l ∈ Finset.univ.filter (fun l ↦ l ≠ i ∧ l ≠ j), G k l)
        = G i j * (U - 2 * R i - 2 * R j + 2 * G i j) := by
    intro i j
    rcases eq_or_ne i j with h | h
    · subst h; simp [hdiag]
    · congr 1
      have inner : ∀ k : Fin N,
          (∑ l ∈ Finset.univ.filter (fun l ↦ l ≠ i ∧ l ≠ j), G k l) = R k - G k i - G k j :=
        fun k ↦ sum_filter_ne_pair (fun l ↦ G k l) h
      rw [Finset.sum_congr rfl fun k _ ↦ inner k,
        sum_filter_ne_pair (fun k ↦ R k - G k i - G k j) h]
      simp only [Finset.sum_sub_distrib]
      rw [hcol i, hcol j, hdiag i, hdiag j, hsymm j i]
      ring
  rw [Finset.sum_congr rfl fun i _ ↦ Finset.sum_congr rfl fun j _ ↦ hTot i j]
  -- expand the resulting bilinear expression row by row
  have expand : ∀ i : Fin N, (∑ j, G i j * (U - 2 * R i - 2 * R j + 2 * G i j))
      = R i * U - 2 * (R i * R i) - 2 * (∑ j, G i j * R j) + 2 * ∑ j, G i j ^ 2 := by
    intro i
    rw [Finset.sum_congr rfl fun j _ ↦ (by ring :
      G i j * (U - 2 * R i - 2 * R j + 2 * G i j)
        = G i j * U - (2 * R i) * G i j - 2 * (G i j * R j) + 2 * G i j ^ 2)]
    simp only [Finset.sum_add_distrib, Finset.sum_sub_distrib, ← Finset.sum_mul,
      ← Finset.mul_sum]
    simp only [hR]
    ring
  rw [Finset.sum_congr rfl fun i _ ↦ expand i]
  have hswap : (∑ i, ∑ j, G i j * R j) = ∑ j, R j * R j := by
    rw [Finset.sum_comm]
    exact Finset.sum_congr rfl fun j _ ↦ by rw [← Finset.sum_mul, hcol j]
  simp only [Finset.sum_add_distrib, Finset.sum_sub_distrib, ← Finset.sum_mul,
    ← Finset.mul_sum]
  rw [hswap, ← hU]
  have hsq : ∀ j : Fin N, R j * R j = R j ^ 2 := fun j ↦ (sq (R j)).symm
  simp only [hsq]
  ring

/-! ### The three pairings of a quadruple -/

/-- The sum of the three pairings of an index quadruple, formed with the symmetric form.
Unlike the corresponding expression in `a_{ij}`, this is invariant under every permutation
of `i, j, k, l`. -/
def pairingSum {N : ℕ} (f : Fin N → α → ℂ) (i j k l : Fin N) (x : α) : ℝ :=
  symForm f i j x * symForm f k l x + symForm f i k x * symForm f j l x
    + symForm f i l x * symForm f j k x

lemma pairingSum_swap₁₂ {N : ℕ} (f : Fin N → α → ℂ) (i j k l : Fin N) (x : α) :
    pairingSum f i j k l x = pairingSum f j i k l x := by
  unfold pairingSum
  rw [symForm_comm f j i]
  ring

lemma pairingSum_swap₃₄ {N : ℕ} (f : Fin N → α → ℂ) (i j k l : Fin N) (x : α) :
    pairingSum f i j k l x = pairingSum f i j l k x := by
  unfold pairingSum
  rw [symForm_comm f l k]
  ring

lemma pairingSum_swap₂₃ {N : ℕ} (f : Fin N → α → ℂ) (i j k l : Fin N) (x : α) :
    pairingSum f i j k l x = pairingSum f i k j l x := by
  unfold pairingSum
  rw [symForm_comm f k j]
  ring

lemma pairingSum_swapPairs {N : ℕ} (f : Fin N → α → ℂ) (i j k l : Fin N) (x : α) :
    pairingSum f i j k l x = pairingSum f k l i j x := by
  unfold pairingSum
  rw [symForm_comm f k i, symForm_comm f l j, symForm_comm f k j, symForm_comm f l i]
  ring

/-- On a sorted quadruple the pairing sum is the real part of the two nonalternating
products, by the quartic identity. -/
lemma pairingSum_of_sorted {N : ℕ} (f : Fin N → α → ℂ) {i j k l : Fin N}
    (hij : i < j) (hjk : j < k) (hkl : k < l) (x : α) :
    pairingSum f i j k l x
      = (f i x * f l x * conj (f j x * f k x)
          - f i x * f j x * conj (f k x * f l x)).re := by
  rw [pairingSum, symForm_of_lt f hij, symForm_of_lt f hkl, symForm_of_lt f (hij.trans hjk),
    symForm_of_lt f (hjk.trans hkl), symForm_of_lt f (hij.trans (hjk.trans hkl)),
    symForm_of_lt f hjk]
  exact imForm_quartic f i j k l x

/-- Sorting step with the first two entries already ordered, the last two already ordered,
and the two heads compared. -/
lemma pairingSum_eq_sorted_aux {N : ℕ} (f : Fin N → α → ℂ) {i j k l : Fin N}
    (hij : i < j) (hkl : k < l) (hik : i < k) (hjk : j ≠ k) (hjl : j ≠ l) :
    ∃ a b c d : Fin N, a < b ∧ b < c ∧ c < d ∧
      ∀ x : α, pairingSum f i j k l x = pairingSum f a b c d x := by
  rcases lt_trichotomy j k with h | h | h
  · exact ⟨i, j, k, l, hij, h, hkl, fun _ ↦ rfl⟩
  · exact absurd h hjk
  · rcases lt_trichotomy j l with h2 | h2 | h2
    · exact ⟨i, k, j, l, hik, h, h2, fun x ↦ pairingSum_swap₂₃ f i j k l x⟩
    · exact absurd h2 hjl
    · exact ⟨i, k, l, j, hik, hkl, h2, fun x ↦ by
        rw [pairingSum_swap₂₃ f i j k l x, pairingSum_swap₃₄ f i k j l x]⟩

/-- Sorting step with each pair already ordered. -/
lemma pairingSum_eq_sorted_aux₂ {N : ℕ} (f : Fin N → α → ℂ) {i j k l : Fin N}
    (hij : i < j) (hkl : k < l) (hik : i ≠ k) (hil : i ≠ l) (hjk : j ≠ k) (hjl : j ≠ l) :
    ∃ a b c d : Fin N, a < b ∧ b < c ∧ c < d ∧
      ∀ x : α, pairingSum f i j k l x = pairingSum f a b c d x := by
  rcases lt_or_gt_of_ne hik with h | h
  · exact pairingSum_eq_sorted_aux f hij hkl h hjk hjl
  · obtain ⟨a, b, c, d, h1, h2, h3, he⟩ :=
      pairingSum_eq_sorted_aux f hkl hij h hil.symm hjl.symm
    exact ⟨a, b, c, d, h1, h2, h3, fun x ↦ by
      rw [pairingSum_swapPairs f i j k l x]; exact he x⟩

/-- Every quadruple of distinct indices can be sorted without changing the pairing sum. -/
lemma pairingSum_eq_sorted {N : ℕ} (f : Fin N → α → ℂ) {i j k l : Fin N}
    (hij : i ≠ j) (hik : i ≠ k) (hil : i ≠ l) (hjk : j ≠ k) (hjl : j ≠ l) (hkl : k ≠ l) :
    ∃ a b c d : Fin N, a < b ∧ b < c ∧ c < d ∧
      ∀ x : α, pairingSum f i j k l x = pairingSum f a b c d x := by
  rcases lt_or_gt_of_ne hij with h1 | h1 <;> rcases lt_or_gt_of_ne hkl with h2 | h2
  · exact pairingSum_eq_sorted_aux₂ f h1 h2 hik hil hjk hjl
  · obtain ⟨a, b, c, d, e1, e2, e3, he⟩ :=
      pairingSum_eq_sorted_aux₂ f h1 h2 hil hik hjl hjk
    exact ⟨a, b, c, d, e1, e2, e3, fun x ↦ by
      rw [pairingSum_swap₃₄ f i j k l x]; exact he x⟩
  · obtain ⟨a, b, c, d, e1, e2, e3, he⟩ :=
      pairingSum_eq_sorted_aux₂ f h1 h2 hjk hjl hik hil
    exact ⟨a, b, c, d, e1, e2, e3, fun x ↦ by
      rw [pairingSum_swap₁₂ f i j k l x]; exact he x⟩
  · obtain ⟨a, b, c, d, e1, e2, e3, he⟩ :=
      pairingSum_eq_sorted_aux₂ f h1 h2 hjl hjk hil hik
    exact ⟨a, b, c, d, e1, e2, e3, fun x ↦ by
      rw [pairingSum_swap₁₂ f i j k l x, pairingSum_swap₃₄ f j i k l x]; exact he x⟩

/-- Pointwise bound on the symmetric form. -/
lemma abs_symForm_le {N : ℕ} (f : Fin N → α → ℂ) (i j : Fin N) (x : α) :
    |symForm f i j x| ≤ ‖f i x‖ * ‖f j x‖ := by
  unfold symForm
  split_ifs with h1 h2
  · exact abs_imForm_le f i j x
  · exact (abs_imForm_le f j i x).trans_eq (mul_comm _ _)
  · rw [abs_zero]
    positivity

/-! ### The sum over quadruples of disjoint pairs -/

/-- Pairwise distinctness of four indices. -/
def Distinct4 {N : ℕ} (i j k l : Fin N) : Prop :=
  i ≠ j ∧ i ≠ k ∧ i ≠ l ∧ j ≠ k ∧ j ≠ l ∧ k ≠ l

instance decidableDistinct4 {N : ℕ} (i j k l : Fin N) : Decidable (Distinct4 i j k l) := by
  unfold Distinct4; infer_instance

lemma Distinct4.perm₁₂ {N : ℕ} {i j k l : Fin N} (h : Distinct4 i j k l) :
    Distinct4 j i k l := ⟨h.1.symm, h.2.2.2.1, h.2.2.2.2.1, h.2.1, h.2.2.1, h.2.2.2.2.2⟩

lemma Distinct4.perm₂₃ {N : ℕ} {i j k l : Fin N} (h : Distinct4 i j k l) :
    Distinct4 i k j l := ⟨h.2.1, h.1, h.2.2.1, h.2.2.2.1.symm, h.2.2.2.2.2, h.2.2.2.2.1⟩

lemma Distinct4.perm₂₄ {N : ℕ} {i j k l : Fin N} (h : Distinct4 i j k l) :
    Distinct4 i l k j := ⟨h.2.2.1, h.2.1, h.1, h.2.2.2.2.2.symm, h.2.2.2.2.1.symm,
      h.2.2.2.1.symm⟩

/-- The sum of `G_{ij} G_{kl}` over quadruples of pairwise distinct indices. -/
def distSum {N : ℕ} (f : Fin N → α → ℂ) (x : α) : ℝ :=
  ∑ i, ∑ j, ∑ k, ∑ l, if Distinct4 i j k l then symForm f i j x * symForm f k l x else 0

/-- The distinct-quadruple sum agrees with the inner double sum over indices avoiding the
outer pair, because the diagonal terms of `G` vanish. -/
lemma distSum_eq_nested {N : ℕ} (f : Fin N → α → ℂ) (x : α) :
    distSum f x = ∑ i, ∑ j, symForm f i j x *
      ∑ k ∈ Finset.univ.filter (fun k ↦ k ≠ i ∧ k ≠ j),
        ∑ l ∈ Finset.univ.filter (fun l ↦ l ≠ i ∧ l ≠ j), symForm f k l x := by
  unfold distSum
  refine Finset.sum_congr rfl fun i _ ↦ Finset.sum_congr rfl fun j _ ↦ ?_
  rcases eq_or_ne i j with hij | hij
  · subst hij
    simp only [symForm_self, zero_mul]
    refine (Finset.sum_eq_zero fun k _ ↦ Finset.sum_eq_zero fun l _ ↦ ?_).trans rfl
    exact if_neg fun h ↦ h.1 rfl
  · rw [Finset.sum_filter, Finset.mul_sum]
    refine Finset.sum_congr rfl fun k _ ↦ ?_
    by_cases hk : k ≠ i ∧ k ≠ j
    · rw [if_pos hk, Finset.sum_filter, Finset.mul_sum]
      refine Finset.sum_congr rfl fun l _ ↦ ?_
      by_cases hl : l ≠ i ∧ l ≠ j
      · rw [if_pos hl]
        by_cases hkl : k = l
        · subst hkl
          rw [if_neg fun h ↦ h.2.2.2.2.2 rfl, symForm_self, mul_zero]
        · rw [if_pos ⟨hij, hk.1.symm, hl.1.symm, hk.2.symm, hl.2.symm, hkl⟩]
      · rw [if_neg hl, mul_zero, if_neg]
        intro h
        exact hl ⟨h.2.2.1.symm, h.2.2.2.2.1.symm⟩
    · rw [if_neg hk, mul_zero]
      refine Finset.sum_eq_zero fun l _ ↦ if_neg fun h ↦ hk ⟨h.2.1.symm, h.2.2.2.1.symm⟩

/-- **The counting identity behind (2.6).** -/
lemma distSum_eq {N : ℕ} (f : Fin N → α → ℂ) (x : α) :
    distSum f x = (∑ i, rowSum f i x) ^ 2 - 4 * ∑ i, rowSum f i x ^ 2
      + 2 * ∑ i, ∑ j, symForm f i j x ^ 2 := by
  rw [distSum_eq_nested, sum_disjoint_pairs (fun i j ↦ symForm f i j x)
    (fun i j ↦ symForm_comm f i j x) (fun i ↦ symForm_self f i x)]
  simp only [rowSum_eq_sum_symForm]

/-! ### Averaging over the three pairings -/

/-- Swapping the first two of three nested summation indices. -/
lemma sum₃_swap₁₂ {N : ℕ} (W : Fin N → Fin N → Fin N → ℝ) :
    (∑ j, ∑ k, ∑ l, W j k l) = ∑ j, ∑ k, ∑ l, W k j l := Finset.sum_comm

/-- Swapping the first and third of three nested summation indices. -/
lemma sum₃_swap₁₃ {N : ℕ} (W : Fin N → Fin N → Fin N → ℝ) :
    (∑ j, ∑ k, ∑ l, W j k l) = ∑ j, ∑ k, ∑ l, W l k j :=
  calc (∑ j, ∑ k, ∑ l, W j k l)
      = ∑ j, ∑ l, ∑ k, W j k l := Finset.sum_congr rfl fun _ _ ↦ Finset.sum_comm
    _ = ∑ l, ∑ j, ∑ k, W j k l := Finset.sum_comm
    _ = ∑ l, ∑ k, ∑ j, W j k l := Finset.sum_congr rfl fun _ _ ↦ Finset.sum_comm

/-- Reindexing turns the distinct-quadruple sum into the second pairing. -/
lemma distSum_eq_pairing₂ {N : ℕ} (f : Fin N → α → ℂ) (x : α) :
    distSum f x = ∑ i, ∑ j, ∑ k, ∑ l,
      if Distinct4 i j k l then symForm f i k x * symForm f j l x else 0 := by
  unfold distSum
  refine Finset.sum_congr rfl fun i _ ↦ ?_
  rw [sum₃_swap₁₂ fun j k l ↦
    if Distinct4 i j k l then symForm f i j x * symForm f k l x else 0]
  refine Finset.sum_congr rfl fun j _ ↦ Finset.sum_congr rfl fun k _ ↦
    Finset.sum_congr rfl fun l _ ↦ ?_
  by_cases h : Distinct4 i j k l
  · rw [if_pos h.perm₂₃, if_pos h]
  · rw [if_neg fun hc ↦ h hc.perm₂₃, if_neg h]

/-- Reindexing turns the distinct-quadruple sum into the third pairing. -/
lemma distSum_eq_pairing₃ {N : ℕ} (f : Fin N → α → ℂ) (x : α) :
    distSum f x = ∑ i, ∑ j, ∑ k, ∑ l,
      if Distinct4 i j k l then symForm f i l x * symForm f j k x else 0 := by
  unfold distSum
  refine Finset.sum_congr rfl fun i _ ↦ ?_
  rw [sum₃_swap₁₃ fun j k l ↦
    if Distinct4 i j k l then symForm f i j x * symForm f k l x else 0]
  refine Finset.sum_congr rfl fun j _ ↦ Finset.sum_congr rfl fun k _ ↦
    Finset.sum_congr rfl fun l _ ↦ ?_
  by_cases h : Distinct4 i j k l
  · rw [if_pos h.perm₂₄, if_pos h, symForm_comm f k j]
  · rw [if_neg fun hc ↦ h hc.perm₂₄, if_neg h]

/-- **Averaging identity.** Three copies of the distinct-quadruple sum assemble the three
pairings, so the distinct-quadruple sum is one third of the pairing sum. -/
lemma three_mul_distSum {N : ℕ} (f : Fin N → α → ℂ) (x : α) :
    3 * distSum f x = ∑ i, ∑ j, ∑ k, ∑ l,
      if Distinct4 i j k l then pairingSum f i j k l x else 0 := by
  have h3 : 3 * distSum f x = distSum f x + distSum f x + distSum f x := by ring
  rw [h3]
  nth_rewrite 2 [distSum_eq_pairing₂]
  nth_rewrite 2 [distSum_eq_pairing₃]
  unfold distSum
  simp only [← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun i _ ↦ Finset.sum_congr rfl fun j _ ↦
    Finset.sum_congr rfl fun k _ ↦ Finset.sum_congr rfl fun l _ ↦ ?_
  by_cases h : Distinct4 i j k l
  · rw [if_pos h, if_pos h, if_pos h, if_pos h, pairingSum]
  · rw [if_neg h, if_neg h, if_neg h, if_neg h, add_zero, add_zero]

variable [MeasurableSpace α]

/-- **Hypothesis (1.2)**: ordered superorthogonality for quadruples. Only the two
nonalternating pairings of every ordered quadruple `i < j < k < l` are required to
vanish. -/
structure OrderedSuperorthogonal {N : ℕ} (μ : Measure α) (f : Fin N → α → ℂ) : Prop where
  /-- Each `f_n` lies in `L^4`. -/
  memLp : ∀ n, MemLp (f n) 4 μ
  /-- The first nonalternating pairing `A_{ijkl}` vanishes. -/
  vanishA : ∀ i j k l : Fin N, i < j → j < k → k < l →
    ∫ x, f i x * f j x * conj (f k x) * conj (f l x) ∂μ = 0
  /-- The second nonalternating pairing `B_{ijkl}` vanishes. -/
  vanishB : ∀ i j k l : Fin N, i < j → j < k → k < l →
    ∫ x, f i x * f l x * conj (f j x) * conj (f k x) ∂μ = 0

/-! ### Integrating the pairing sum -/

/-- Hölder triple used to multiply two `L^4` functions into `L^2`. -/
local instance holderTriple_four_four_two : ENNReal.HolderTriple 4 4 2 := ⟨by
  rw [show (4 : ENNReal) = 2 * 2 by norm_num,
    ENNReal.mul_inv (by norm_num) (by norm_num), ← two_mul, ← mul_assoc,
    ENNReal.mul_inv_cancel (by norm_num) (by norm_num), one_mul]⟩

/-- A product of two members of `L^4` lies in `L^2`. -/
lemma memLp_two_mul {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (hf : ∀ n, MemLp (f n) 4 μ) (i j : Fin N) :
    MemLp (fun x ↦ f i x * f j x) 2 μ := (hf j).mul (hf i)

/-- A product of four members of `L^4` is integrable. -/
lemma integrable_quadruple {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (hf : ∀ n, MemLp (f n) 4 μ) (i j k l : Fin N) :
    Integrable (fun x ↦ f i x * f j x * conj (f k x * f l x)) μ :=
  (memLp_two_mul hf i j).integrable_mul (memLp_two_mul hf k l).star

/-- On a sorted quadruple the pairing sum integrates to zero: this is exactly hypothesis
(1.2) read through the quartic identity. -/
lemma integral_pairingSum_of_sorted {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (hf : OrderedSuperorthogonal μ f) {i j k l : Fin N}
    (hij : i < j) (hjk : j < k) (hkl : k < l) :
    ∫ x, pairingSum f i j k l x ∂μ = 0 := by
  have hB : Integrable (fun x ↦ f i x * f l x * conj (f j x * f k x)) μ :=
    integrable_quadruple hf.memLp i l j k
  have hA : Integrable (fun x ↦ f i x * f j x * conj (f k x * f l x)) μ :=
    integrable_quadruple hf.memLp i j k l
  have h1 : (∫ x, f i x * f l x * conj (f j x * f k x) ∂μ) = 0 := by
    have h := hf.vanishB i j k l hij hjk hkl
    rw [← h]
    exact integral_congr_ae (Filter.Eventually.of_forall fun x ↦ by
      simp only [map_mul]; ring)
  have h2 : (∫ x, f i x * f j x * conj (f k x * f l x) ∂μ) = 0 := by
    have h := hf.vanishA i j k l hij hjk hkl
    rw [← h]
    exact integral_congr_ae (Filter.Eventually.of_forall fun x ↦ by
      simp only [map_mul]; ring)
  calc ∫ x, pairingSum f i j k l x ∂μ
      = ∫ x, (f i x * f l x * conj (f j x * f k x)
          - f i x * f j x * conj (f k x * f l x)).re ∂μ :=
        integral_congr_ae (Filter.Eventually.of_forall fun x ↦
          pairingSum_of_sorted f hij hjk hkl x)
    _ = (∫ x, (f i x * f l x * conj (f j x * f k x)
          - f i x * f j x * conj (f k x * f l x)) ∂μ).re :=
        _root_.integral_re (hB.sub hA)
    _ = 0 := by rw [integral_sub hB hA, h1, h2, sub_zero, Complex.zero_re]

/-- **The pairing sum of any quadruple of distinct indices integrates to zero.** The
expression is invariant under permutations of the quadruple, so the sorted case suffices. -/
lemma integral_pairingSum_eq_zero {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (hf : OrderedSuperorthogonal μ f) {i j k l : Fin N}
    (hij : i ≠ j) (hik : i ≠ k) (hil : i ≠ l) (hjk : j ≠ k) (hjl : j ≠ l) (hkl : k ≠ l) :
    ∫ x, pairingSum f i j k l x ∂μ = 0 := by
  obtain ⟨a, b, c, d, h1, h2, h3, he⟩ := pairingSum_eq_sorted f hij hik hil hjk hjl hkl
  rw [integral_congr_ae (Filter.Eventually.of_forall he)]
  exact integral_pairingSum_of_sorted hf h1 h2 h3

/-! ### Integrability of the quadratic data -/

/-- A product of four norms of members of `L^4` is integrable. -/
lemma integrable_norm_mul₄ {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (hf : ∀ n, MemLp (f n) 4 μ) (i j k l : Fin N) :
    Integrable (fun x ↦ ‖f i x‖ * ‖f j x‖ * (‖f k x‖ * ‖f l x‖)) μ := by
  have h1 : MemLp (fun x ↦ ‖f i x‖ * ‖f j x‖) 2 μ := ((hf j).norm).mul ((hf i).norm)
  have h2 : MemLp (fun x ↦ ‖f k x‖ * ‖f l x‖) 2 μ := ((hf l).norm).mul ((hf k).norm)
  exact h1.integrable_mul h2

lemma aestronglyMeasurable_symForm {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (hf : ∀ n, MemLp (f n) 4 μ) (i j : Fin N) :
    AEStronglyMeasurable (fun x ↦ symForm f i j x) μ := by
  unfold symForm imForm
  split_ifs
  · exact (((hf i).aestronglyMeasurable).mul ((hf j).aestronglyMeasurable).star).im
  · exact (((hf j).aestronglyMeasurable).mul ((hf i).aestronglyMeasurable).star).im
  · exact aestronglyMeasurable_const

lemma integrable_symForm_mul {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (hf : ∀ n, MemLp (f n) 4 μ) (i j k l : Fin N) :
    Integrable (fun x ↦ symForm f i j x * symForm f k l x) μ := by
  refine Integrable.mono' (integrable_norm_mul₄ hf i j k l)
    ((aestronglyMeasurable_symForm hf i j).mul (aestronglyMeasurable_symForm hf k l))
    (Filter.Eventually.of_forall fun x ↦ ?_)
  rw [Real.norm_eq_abs, abs_mul]
  exact mul_le_mul (abs_symForm_le f i j x) (abs_symForm_le f k l x) (abs_nonneg _)
    (by positivity)

lemma integrable_rowSum_mul {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (hf : ∀ n, MemLp (f n) 4 μ) (i j : Fin N) :
    Integrable (fun x ↦ rowSum f i x * rowSum f j x) μ := by
  have hexp : ∀ x : α, rowSum f i x * rowSum f j x
      = ∑ a, ∑ b, symForm f i a x * symForm f j b x := by
    intro x
    rw [rowSum_eq_sum_symForm, rowSum_eq_sum_symForm, Finset.sum_mul_sum]
  rw [funext hexp]
  exact integrable_finsetSum _ fun a _ ↦ integrable_finsetSum _ fun b _ ↦
    integrable_symForm_mul hf i a j b

lemma integrable_pairingSum {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (hf : ∀ n, MemLp (f n) 4 μ) (i j k l : Fin N) :
    Integrable (fun x ↦ pairingSum f i j k l x) μ :=
  ((integrable_symForm_mul hf i j k l).add (integrable_symForm_mul hf i k j l)).add
    (integrable_symForm_mul hf i l j k)

lemma integrable_distSum {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (hf : ∀ n, MemLp (f n) 4 μ) : Integrable (fun x ↦ distSum f x) μ :=
  integrable_finsetSum _ fun i _ ↦ integrable_finsetSum _ fun j _ ↦
    integrable_finsetSum _ fun k _ ↦ integrable_finsetSum _ fun l _ ↦ by
      by_cases h : Distinct4 i j k l
      · simpa only [if_pos h] using integrable_symForm_mul hf i j k l
      · simp only [if_neg h]
        exact integrable_zero α ℝ μ

/-- **The distinct-quadruple sum has vanishing integral.** Averaging over the three
pairings reduces this to `integral_pairingSum_eq_zero`. -/
theorem integral_distSum_eq_zero {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (hf : OrderedSuperorthogonal μ f) : ∫ x, distSum f x ∂μ = 0 := by
  have key : (3 : ℝ) * ∫ x, distSum f x ∂μ = 0 := by
    rw [← MeasureTheory.integral_const_mul]
    rw [integral_congr_ae (Filter.Eventually.of_forall fun x ↦ three_mul_distSum f x)]
    have hint : ∀ i j k l : Fin N,
        Integrable (fun x ↦ if Distinct4 i j k l then pairingSum f i j k l x else 0) μ := by
      intro i j k l
      by_cases h : Distinct4 i j k l
      · simpa only [if_pos h] using integrable_pairingSum hf.memLp i j k l
      · simp only [if_neg h]
        exact integrable_zero α ℝ μ
    rw [integral_finsetSum _ fun i _ ↦ integrable_finsetSum _ fun j _ ↦
      integrable_finsetSum _ fun k _ ↦ integrable_finsetSum _ fun l _ ↦ hint i j k l]
    refine Finset.sum_eq_zero fun i _ ↦ ?_
    rw [integral_finsetSum _ fun j _ ↦ integrable_finsetSum _ fun k _ ↦
      integrable_finsetSum _ fun l _ ↦ hint i j k l]
    refine Finset.sum_eq_zero fun j _ ↦ ?_
    rw [integral_finsetSum _ fun k _ ↦ integrable_finsetSum _ fun l _ ↦ hint i j k l]
    refine Finset.sum_eq_zero fun k _ ↦ ?_
    rw [integral_finsetSum _ fun l _ ↦ hint i j k l]
    refine Finset.sum_eq_zero fun l _ ↦ ?_
    by_cases h : Distinct4 i j k l
    · rw [integral_congr_ae (Filter.Eventually.of_forall fun x ↦ if_pos h)]
      exact integral_pairingSum_eq_zero hf h.1 h.2.1 h.2.2.1 h.2.2.2.1 h.2.2.2.2.1
        h.2.2.2.2.2
    · rw [integral_congr_ae (Filter.Eventually.of_forall fun x ↦ if_neg h),
        MeasureTheory.integral_zero]
  linarith

/-! ### The estimate (2.6) -/

/-- The quantity `V = 2 ∑_{i<j} a_{ij}` of Lemma 2.2, written as the total row sum. -/
def bigV {N : ℕ} (f : Fin N → α → ℂ) (x : α) : ℝ := ∑ i, rowSum f i x

lemma integrable_sq_bigV {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (hf : ∀ n, MemLp (f n) 4 μ) : Integrable (fun x ↦ bigV f x ^ 2) μ := by
  have hx : ∀ x : α, bigV f x ^ 2 = ∑ i, ∑ j, rowSum f i x * rowSum f j x := by
    intro x
    rw [bigV, sq, Finset.sum_mul_sum]
  rw [funext hx]
  exact integrable_finsetSum _ fun i _ ↦ integrable_finsetSum _ fun j _ ↦
    integrable_rowSum_mul hf i j

lemma integrable_sum_sq_rowSum {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (hf : ∀ n, MemLp (f n) 4 μ) : Integrable (fun x ↦ ∑ i, rowSum f i x ^ 2) μ := by
  have hx : ∀ x : α, (∑ i, rowSum f i x ^ 2) = ∑ i, rowSum f i x * rowSum f i x :=
    fun x ↦ Finset.sum_congr rfl fun i _ ↦ sq (rowSum f i x)
  rw [funext hx]
  exact integrable_finsetSum _ fun i _ ↦ integrable_rowSum_mul hf i i

lemma integrable_sum_sq_symForm {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (hf : ∀ n, MemLp (f n) 4 μ) :
    Integrable (fun x ↦ ∑ i, ∑ j, symForm f i j x ^ 2) μ := by
  have hx : ∀ x : α, (∑ i, ∑ j, symForm f i j x ^ 2)
      = ∑ i, ∑ j, symForm f i j x * symForm f i j x :=
    fun x ↦ Finset.sum_congr rfl fun i _ ↦ Finset.sum_congr rfl fun j _ ↦
      sq (symForm f i j x)
  rw [funext hx]
  exact integrable_finsetSum _ fun i _ ↦ integrable_finsetSum _ fun j _ ↦
    integrable_symForm_mul hf i j i j

/-- **Estimate (2.6) of Lemma 2.2.** The cancellation over quadruples leaves only the
row sums: `‖V‖_2^2 ≤ 4 ∫ ∑_i R_i^2`. -/
theorem integral_sq_bigV_le {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (hf : OrderedSuperorthogonal μ f) :
    ∫ x, bigV f x ^ 2 ∂μ ≤ 4 * ∫ x, ∑ i, rowSum f i x ^ 2 ∂μ := by
  have hD := integrable_distSum hf.memLp
  have hR := integrable_sum_sq_rowSum hf.memLp
  have hG := integrable_sum_sq_symForm hf.memLp
  have hkey : ∀ x : α, bigV f x ^ 2
      = distSum f x + 4 * (∑ i, rowSum f i x ^ 2) - 2 * ∑ i, ∑ j, symForm f i j x ^ 2 := by
    intro x
    rw [bigV, distSum_eq]
    ring
  have hGnn : 0 ≤ ∫ x, ∑ i, ∑ j, symForm f i j x ^ 2 ∂μ :=
    integral_nonneg fun x ↦ Finset.sum_nonneg fun i _ ↦ Finset.sum_nonneg fun j _ ↦ sq_nonneg _
  calc ∫ x, bigV f x ^ 2 ∂μ
      = ∫ x, (distSum f x + 4 * (∑ i, rowSum f i x ^ 2)
          - 2 * ∑ i, ∑ j, symForm f i j x ^ 2) ∂μ :=
        integral_congr_ae (Filter.Eventually.of_forall hkey)
    _ = (∫ x, distSum f x ∂μ) + 4 * (∫ x, ∑ i, rowSum f i x ^ 2 ∂μ)
          - 2 * ∫ x, ∑ i, ∑ j, symForm f i j x ^ 2 ∂μ := by
        have e0 : Integrable (fun x ↦ 4 * ∑ i, rowSum f i x ^ 2) μ := hR.const_mul 4
        have e1 : Integrable
            (fun x ↦ distSum f x + 4 * ∑ i, rowSum f i x ^ 2) μ := hD.add e0
        have e2 : Integrable (fun x ↦ 2 * ∑ i, ∑ j, symForm f i j x ^ 2) μ := hG.const_mul 2
        rw [integral_sub e1 e2, integral_add hD e0, MeasureTheory.integral_const_mul,
          MeasureTheory.integral_const_mul]
    _ ≤ 4 * ∫ x, ∑ i, rowSum f i x ^ 2 ∂μ := by
        rw [integral_distSum_eq_zero hf]
        linarith

/-! ### The kernel representation (2.7) -/

/-- The phase-modulated sum `P_N(θ) = ∑_n e(nθ) f_n` of Section 2. Indices run over
`Fin N`, which shifts every phase by a common factor and so changes nothing: only the
differences of indices enter. -/
def phaseSum {N : ℕ} (f : Fin N → α → ℂ) (θ : ℝ) (x : α) : ℂ :=
  ∑ n : Fin N, eZ (n : ℤ) θ * f n x

/-- The signed row vector `W_m = ∑_{n<m} f_n - ∑_{n>m} f_n` appearing in (2.6). -/
def signedSum {N : ℕ} (f : Fin N → α → ℂ) (m : Fin N) (x : α) : ℂ :=
  (∑ n ∈ Finset.univ.filter (· < m), f n x) - ∑ n ∈ Finset.univ.filter (m < ·), f n x

omit [MeasurableSpace α] in
lemma rowSum_eq_im_signedSum {N : ℕ} (f : Fin N → α → ℂ) (m : Fin N) (x : α) :
    rowSum f m x = (conj (f m x) * signedSum f m x).im := rowSum_eq_im f m x

omit [MeasurableSpace α] in
/-- The signed row vector as a signed sum over all indices. -/
lemma signedSum_eq_sum_sign {N : ℕ} (f : Fin N → α → ℂ) (m : Fin N) (x : α) :
    signedSum f m x = -∑ n : Fin N, (((n : ℤ) - (m : ℤ)).sign : ℂ) * f n x := by
  rw [signedSum, Finset.sum_filter, Finset.sum_filter, ← Finset.sum_sub_distrib,
    ← Finset.sum_neg_distrib]
  refine Finset.sum_congr rfl fun n _ ↦ ?_
  rcases lt_trichotomy n m with h | h | h
  · have hs : ((n : ℤ) - (m : ℤ)).sign = -1 := by
      refine Int.sign_eq_neg_one_of_neg ?_
      have := (Fin.lt_def).mp h
      omega
    rw [hs, if_pos h, if_neg (asymm h)]
    push_cast
    ring
  · subst h
    simp
  · have hs : ((n : ℤ) - (m : ℤ)).sign = 1 := by
      refine Int.sign_eq_one_of_pos ?_
      have := (Fin.lt_def).mp h
      omega
    rw [hs, if_neg (asymm h), if_pos h]
    push_cast
    ring

omit [MeasurableSpace α] in
/-- **(2.7).** The signed row vector is recovered from the phase-modulated sum through the
truncated Hilbert kernel. -/
theorem signedSum_eq_integral {N : ℕ} (f : Fin N → α → ℂ) (m : Fin N) (x : α) :
    signedSum f m x
      = -I * ∫ θ in (0:ℝ)..1, (hilbertKernel N θ : ℂ) * eZ (-(m : ℤ)) θ * phaseSum f θ x := by
  have hcont : ∀ k : ℤ, IntervalIntegrable
      (fun θ : ℝ ↦ (hilbertKernel N θ : ℂ) * eZ k θ) volume 0 1 := by
    intro k
    exact ((Complex.continuous_ofReal.comp (continuous_hilbertKernel N)).mul
      (continuous_eZ k)).intervalIntegrable _ _
  have hexp : ∀ θ : ℝ, (hilbertKernel N θ : ℂ) * eZ (-(m : ℤ)) θ * phaseSum f θ x
      = ∑ n : Fin N, ((hilbertKernel N θ : ℂ) * eZ ((n : ℤ) - (m : ℤ)) θ) * f n x := by
    intro θ
    rw [phaseSum, Finset.mul_sum]
    refine Finset.sum_congr rfl fun n _ ↦ ?_
    rw [show ((n : ℤ) - (m : ℤ)) = (-(m : ℤ)) + (n : ℤ) by ring, eZ_add]
    ring
  rw [intervalIntegral.integral_congr (fun θ _ ↦ hexp θ),
    intervalIntegral.integral_finsetSum (s := (Finset.univ : Finset (Fin N)))
      (f := fun (n : Fin N) (θ : ℝ) ↦
        ((hilbertKernel N θ : ℂ) * eZ ((n : ℤ) - (m : ℤ)) θ) * f n x)
      (fun n _ ↦ (hcont _).mul_const _)]
  have hterm : ∀ n : Fin N,
      (∫ θ in (0:ℝ)..1, ((hilbertKernel N θ : ℂ) * eZ ((n : ℤ) - (m : ℤ)) θ) * f n x)
        = (-I * ((((n : ℤ) - (m : ℤ)).sign : ℤ) : ℂ)) * f n x := by
    intro n
    rw [intervalIntegral.integral_mul_const, integral_hilbertKernel_mul_eZ N _ ?_]
    have h1 : (n : ℕ) < N := n.isLt
    have h2 : (m : ℕ) < N := m.isLt
    omega
  rw [Finset.sum_congr rfl fun n _ ↦ hterm n, Finset.mul_sum, signedSum_eq_sum_sign,
    ← Finset.sum_neg_distrib]
  refine Finset.sum_congr rfl fun n _ ↦ ?_
  rw [← mul_assoc, show (-I : ℂ) * (-I * ((((n : ℤ) - (m : ℤ)).sign : ℤ) : ℂ))
    = (I * I) * ((((n : ℤ) - (m : ℤ)).sign : ℤ) : ℂ) by ring, Complex.I_mul_I]
  ring

/-! ### Weighted Cauchy-Schwarz in the kernel variable

The source applies Minkowski's integral inequality at this point. The pinned Mathlib has no
continuous-form Minkowski inequality, so the same bound is obtained from Cauchy-Schwarz
against the weight `|K|`, which gives identical constants.
-/

/-- Weighted Cauchy-Schwarz on `[0,1]`: `(∫ w g)^2 ≤ (∫ w) (∫ w g^2)` for a nonnegative
weight `w`. -/
lemma sq_integral_weighted_le {w g : ℝ → ℝ} (hw : Continuous w) (hg : Continuous g)
    (hw0 : ∀ θ, 0 ≤ w θ) :
    (∫ θ in (0:ℝ)..1, w θ * g θ) ^ 2
      ≤ (∫ θ in (0:ℝ)..1, w θ) * ∫ θ in (0:ℝ)..1, w θ * g θ ^ 2 := by
  have hiw : IntervalIntegrable w volume 0 1 := hw.intervalIntegrable _ _
  have hiwg : IntervalIntegrable (fun θ ↦ w θ * g θ) volume 0 1 :=
    (hw.mul hg).intervalIntegrable _ _
  have hiwg2 : IntervalIntegrable (fun θ ↦ w θ * g θ ^ 2) volume 0 1 :=
    (hw.mul (hg.pow 2)).intervalIntegrable _ _
  set a := ∫ θ in (0:ℝ)..1, w θ with ha'
  set b := ∫ θ in (0:ℝ)..1, w θ * g θ with hb'
  set c := ∫ θ in (0:ℝ)..1, w θ * g θ ^ 2 with hc'
  have key : ∀ t : ℝ, 0 ≤ c - 2 * t * b + t ^ 2 * a := by
    intro t
    have hnn : 0 ≤ ∫ θ in (0:ℝ)..1, w θ * (g θ - t) ^ 2 :=
      intervalIntegral.integral_nonneg (by norm_num)
        (fun θ _ ↦ mul_nonneg (hw0 θ) (sq_nonneg _))
    have hexp : (∫ θ in (0:ℝ)..1, w θ * (g θ - t) ^ 2) = c - 2 * t * b + t ^ 2 * a := by
      have h1 : ∀ θ : ℝ, w θ * (g θ - t) ^ 2
          = w θ * g θ ^ 2 - 2 * t * (w θ * g θ) + t ^ 2 * w θ := fun θ ↦ by ring
      rw [intervalIntegral.integral_congr (fun θ _ ↦ h1 θ),
        intervalIntegral.integral_add (hiwg2.sub (hiwg.const_mul _)) (hiw.const_mul _),
        intervalIntegral.integral_sub hiwg2 (hiwg.const_mul _),
        intervalIntegral.integral_const_mul, intervalIntegral.integral_const_mul]
    linarith [hexp ▸ hnn]
  have hann : 0 ≤ a :=
    intervalIntegral.integral_nonneg (by norm_num) (fun θ _ ↦ hw0 θ)
  rcases eq_or_lt_of_le hann with h | h
  · have hb : b = 0 := by
      by_contra hb
      have h2 := key ((c + 1) / (2 * b))
      rw [← h] at h2
      have : (2 : ℝ) * ((c + 1) / (2 * b)) * b = c + 1 := by field_simp
      rw [this] at h2
      linarith
    rw [hb, ← h]
    simp
  · have hne : a ≠ 0 := ne_of_gt h
    have hk := key (b / a)
    have he : c - 2 * (b / a) * b + (b / a) ^ 2 * a = (a * c - b ^ 2) / a := by
      field_simp
      ring
    rw [he] at hk
    have h2 : 0 ≤ a * c - b ^ 2 := by
      have h3 := mul_nonneg hk h.le
      rwa [div_mul_cancel₀ _ hne] at h3
    linarith

omit [MeasurableSpace α] in
/-- The signed row vector is dominated by the kernel average of the phase-modulated sum. -/
lemma norm_signedSum_le {N : ℕ} (f : Fin N → α → ℂ) (m : Fin N) (x : α) :
    ‖signedSum f m x‖
      ≤ ∫ θ in (0:ℝ)..1, |hilbertKernel N θ| * ‖phaseSum f θ x‖ := by
  rw [signedSum_eq_integral, norm_mul, norm_neg, Complex.norm_I, one_mul]
  refine (intervalIntegral.norm_integral_le_integral_norm (by norm_num)).trans_eq ?_
  refine intervalIntegral.integral_congr fun θ _ ↦ ?_
  rw [norm_mul, norm_mul, norm_eZ, mul_one, Complex.norm_real, Real.norm_eq_abs]

/-! ### The best constant of Section 2

The source defines `C(N)` as a supremum over all admissible families over all measure
spaces, which is not a set in Lean. Since the proof only ever applies it to unimodular
phase changes of the family at hand, it is replaced here by the supremum over those, for
the fixed family. This is a genuine bounded set of reals.
-/

/-- The fourth power of the `L^4` norm, as a real integral. -/
def pow4 (μ : Measure α) (g : α → ℂ) : ℝ := ∫ x, ‖g x‖ ^ 4 ∂μ

/-- The `L^4` norm as a real number. -/
def nrm4 (μ : Measure α) (g : α → ℂ) : ℝ := pow4 μ g ^ ((1:ℝ)/4)

/-- The fourth power of the `L^4` norm of the square function. -/
def pow4S {N : ℕ} (μ : Measure α) (f : Fin N → α → ℂ) : ℝ := ∫ x, sqFun f x ^ 4 ∂μ

/-- `‖S‖_4`, the right-hand side of Theorem 1.1. -/
def nrmS {N : ℕ} (μ : Measure α) (f : Fin N → α → ℂ) : ℝ := pow4S μ f ^ ((1:ℝ)/4)

lemma pow4_nonneg (μ : Measure α) (g : α → ℂ) : 0 ≤ pow4 μ g :=
  integral_nonneg fun x ↦ by positivity

lemma pow4S_nonneg {N : ℕ} (μ : Measure α) (f : Fin N → α → ℂ) : 0 ≤ pow4S μ f :=
  integral_nonneg fun x ↦ by positivity

lemma nrm4_nonneg (μ : Measure α) (g : α → ℂ) : 0 ≤ nrm4 μ g := Real.rpow_nonneg (pow4_nonneg _ _) _

lemma nrmS_nonneg {N : ℕ} (μ : Measure α) (f : Fin N → α → ℂ) : 0 ≤ nrmS μ f :=
  Real.rpow_nonneg (pow4S_nonneg _ _) _

lemma nrm4_pow_four (μ : Measure α) (g : α → ℂ) : nrm4 μ g ^ 4 = pow4 μ g := by
  rw [nrm4, ← Real.rpow_natCast (pow4 μ g ^ ((1:ℝ)/4)) 4, ← Real.rpow_mul (pow4_nonneg _ _)]
  norm_num

lemma nrmS_pow_four {N : ℕ} (μ : Measure α) (f : Fin N → α → ℂ) : nrmS μ f ^ 4 = pow4S μ f := by
  rw [nrmS, ← Real.rpow_natCast (pow4S μ f ^ ((1:ℝ)/4)) 4, ← Real.rpow_mul (pow4S_nonneg _ _)]
  norm_num

/-- The square function of an `L^4` family lies in `L^4`. -/
lemma memLp_sqFun {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (hf : ∀ n, MemLp (f n) 4 μ) : MemLp (sqFun f) 4 μ := by
  have hsum : MemLp (fun x ↦ ∑ n, ‖f n x‖) 4 μ :=
    memLp_finsetSum _ fun n _ ↦ (hf n).norm
  have hmeas : AEStronglyMeasurable (fun x ↦ ∑ n, ‖f n x‖ ^ 2) μ := by
    have : ∀ n : Fin N, AEStronglyMeasurable (fun x ↦ ‖f n x‖ ^ 2) μ :=
      fun n ↦ (((hf n).aestronglyMeasurable).norm).pow 2
    have heq : (∑ n : Fin N, fun x ↦ ‖f n x‖ ^ 2) = fun x ↦ ∑ n, ‖f n x‖ ^ 2 := by
      funext x
      simp [Finset.sum_apply]
    rw [← heq]
    exact Finset.aestronglyMeasurable_sum _ fun n _ ↦ this n
  refine hsum.of_le (Real.continuous_sqrt.comp_aestronglyMeasurable hmeas)
    (Filter.Eventually.of_forall fun x ↦ ?_)
  rw [Real.norm_of_nonneg (sqFun_nonneg f x),
    Real.norm_of_nonneg (Finset.sum_nonneg fun n _ ↦ norm_nonneg _)]
  have h1 : (∑ n, ‖f n x‖ ^ 2) ≤ (∑ n, ‖f n x‖) ^ 2 :=
    Finset.sum_sq_le_sq_sum_of_nonneg fun n _ ↦ norm_nonneg _
  calc sqFun f x ≤ Real.sqrt ((∑ n, ‖f n x‖) ^ 2) := Real.sqrt_le_sqrt h1
    _ = ∑ n, ‖f n x‖ := Real.sqrt_sq (Finset.sum_nonneg fun n _ ↦ norm_nonneg _)

/-- The `L^4` membership of a phase-changed sum. -/
lemma memLp_phaseCombination {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (hf : ∀ n, MemLp (f n) 4 μ) (c : Fin N → ℂ) :
    MemLp (fun x ↦ ∑ n, c n * f n x) 4 μ :=
  memLp_finsetSum _ fun n _ ↦ (hf n).const_mul (c n)

/-- Pointwise Cauchy-Schwarz gives `‖∑ c_n f_n‖_4 ≤ √N ‖S‖_4`, so the constant of
Section 2 is finite. -/
lemma nrm4_phase_le {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (hf : ∀ n, MemLp (f n) 4 μ) (c : Fin N → ℂ) (hc : ∀ n, ‖c n‖ ≤ 1) :
    nrm4 μ (fun x ↦ ∑ n, c n * f n x) ≤ Real.sqrt N * nrmS μ f := by
  have hS := memLp_sqFun hf
  have hint1 : Integrable (fun x ↦ ‖∑ n, c n * f n x‖ ^ 4) μ :=
    (memLp_phaseCombination hf c).integrable_norm_pow (p := 4) (by norm_num)
  have hintS : Integrable (fun x ↦ sqFun f x ^ 4) μ := by
    have h := hS.integrable_norm_pow (p := 4) (by norm_num)
    refine h.congr (Filter.Eventually.of_forall fun x ↦ ?_)
    simp only []
    rw [Real.norm_of_nonneg (sqFun_nonneg f x)]
  have hint2 : Integrable (fun x ↦ (Real.sqrt N * sqFun f x) ^ 4) μ := by
    have : ∀ x : α, (Real.sqrt N * sqFun f x) ^ 4
        = (Real.sqrt N) ^ 4 * sqFun f x ^ 4 := fun x ↦ by ring
    rw [funext this]
    exact hintS.const_mul _
  have hmono : pow4 μ (fun x ↦ ∑ n, c n * f n x)
      ≤ ∫ x, (Real.sqrt N * sqFun f x) ^ 4 ∂μ := by
    refine integral_mono hint1 hint2 fun x ↦ ?_
    exact pow_le_pow_left₀ (norm_nonneg _) (norm_sum_le_sqrt_mul_sqFun f c hc x) 4
  have hval : (∫ x, (Real.sqrt N * sqFun f x) ^ 4 ∂μ) = (N : ℝ) ^ 2 * pow4S μ f := by
    have h4 : (Real.sqrt N) ^ 4 = (N : ℝ) ^ 2 := by
      rw [show (4 : ℕ) = 2 * 2 by norm_num, pow_mul, Real.sq_sqrt (by positivity)]
    have : ∀ x : α, (Real.sqrt N * sqFun f x) ^ 4
        = (N : ℝ) ^ 2 * sqFun f x ^ 4 := fun x ↦ by rw [mul_pow, h4]
    rw [funext this, MeasureTheory.integral_const_mul, pow4S]
  rw [nrm4, nrmS]
  have hstep : pow4 μ (fun x ↦ ∑ n, c n * f n x) ≤ (N : ℝ) ^ 2 * pow4S μ f := by
    rw [← hval]; exact hmono
  calc pow4 μ (fun x ↦ ∑ n, c n * f n x) ^ ((1:ℝ)/4)
      ≤ ((N : ℝ) ^ 2 * pow4S μ f) ^ ((1:ℝ)/4) :=
        Real.rpow_le_rpow (pow4_nonneg _ _) hstep (by norm_num)
    _ = Real.sqrt N * pow4S μ f ^ ((1:ℝ)/4) := by
        rw [Real.mul_rpow (by positivity) (pow4S_nonneg _ _)]
        congr 1
        rw [← Real.rpow_natCast (N : ℝ) 2, ← Real.rpow_mul (by positivity),
          Real.sqrt_eq_rpow]
        norm_num

/-- The `L^4` norms of the unimodular phase changes of the family. -/
def phaseNorms (μ : Measure α) {N : ℕ} (f : Fin N → α → ℂ) : Set ℝ :=
  {t | ∃ c : Fin N → ℂ, (∀ n, ‖c n‖ = 1) ∧ t = nrm4 μ (fun x ↦ ∑ n, c n * f n x)}

/-- **The best constant of Section 2**, for the fixed family: the supremum of
`‖∑ c_n f_n‖_4` over unimodular coefficient vectors. -/
def bestConst (μ : Measure α) {N : ℕ} (f : Fin N → α → ℂ) : ℝ := sSup (phaseNorms μ f)

lemma phaseNorms_nonempty {N : ℕ} (μ : Measure α) (f : Fin N → α → ℂ) :
    (phaseNorms μ f).Nonempty :=
  ⟨nrm4 μ (fun x ↦ ∑ n, (1:ℂ) * f n x), fun _ ↦ (1:ℂ), fun _ ↦ norm_one, rfl⟩

lemma phaseNorms_bddAbove {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (hf : ∀ n, MemLp (f n) 4 μ) : BddAbove (phaseNorms μ f) := by
  refine ⟨Real.sqrt N * nrmS μ f, ?_⟩
  rintro t ⟨c, hc, rfl⟩
  exact nrm4_phase_le hf c fun n ↦ le_of_eq (hc n)

lemma le_bestConst {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (hf : ∀ n, MemLp (f n) 4 μ) (c : Fin N → ℂ) (hc : ∀ n, ‖c n‖ = 1) :
    nrm4 μ (fun x ↦ ∑ n, c n * f n x) ≤ bestConst μ f :=
  le_csSup (phaseNorms_bddAbove hf) ⟨c, hc, rfl⟩

lemma bestConst_nonneg {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (hf : ∀ n, MemLp (f n) 4 μ) : 0 ≤ bestConst μ f :=
  le_trans (nrm4_nonneg _ _) (le_bestConst hf (fun _ ↦ 1) fun _ ↦ norm_one)

/-- The phase-modulated sum is one of the competitors, so it is bounded by the constant. -/
lemma nrm4_phaseSum_le {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (hf : ∀ n, MemLp (f n) 4 μ) (θ : ℝ) :
    nrm4 μ (phaseSum f θ) ≤ bestConst μ f :=
  le_bestConst hf (fun n ↦ eZ (n : ℤ) θ) fun _ ↦ norm_eZ _ _

lemma nrm4_sum_le_bestConst {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ}
    (hf : ∀ n, MemLp (f n) 4 μ) :
    nrm4 μ (fun x ↦ ∑ n, f n x) ≤ bestConst μ f := by
  have h := le_bestConst hf (fun _ ↦ 1) fun _ ↦ norm_one
  simpa using h

/-! ### Cauchy-Schwarz on the measure space -/

/-- Cauchy-Schwarz for real Bochner integrals, by the discriminant of a nonnegative
quadratic. -/
lemma sq_integral_mul_le {μ : Measure α} {F G : α → ℝ}
    (hF : Integrable (fun x ↦ F x ^ 2) μ) (hG : Integrable (fun x ↦ G x ^ 2) μ)
    (hFG : Integrable (fun x ↦ F x * G x) μ) :
    (∫ x, F x * G x ∂μ) ^ 2 ≤ (∫ x, F x ^ 2 ∂μ) * ∫ x, G x ^ 2 ∂μ := by
  set a := ∫ x, G x ^ 2 ∂μ with ha'
  set b := ∫ x, F x * G x ∂μ with hb'
  set c := ∫ x, F x ^ 2 ∂μ with hc'
  have key : ∀ t : ℝ, 0 ≤ c - 2 * t * b + t ^ 2 * a := by
    intro t
    have hnn : 0 ≤ ∫ x, (F x - t * G x) ^ 2 ∂μ := integral_nonneg fun x ↦ sq_nonneg _
    have hexp : (∫ x, (F x - t * G x) ^ 2 ∂μ) = c - 2 * t * b + t ^ 2 * a := by
      have h1 : ∀ x : α, (F x - t * G x) ^ 2
          = F x ^ 2 - 2 * t * (F x * G x) + t ^ 2 * G x ^ 2 := fun x ↦ by ring
      have e0 : Integrable (fun x ↦ 2 * t * (F x * G x)) μ := hFG.const_mul _
      have e1 : Integrable (fun x ↦ t ^ 2 * G x ^ 2) μ := hG.const_mul _
      have e2 : Integrable (fun x ↦ F x ^ 2 - 2 * t * (F x * G x)) μ := hF.sub e0
      rw [integral_congr_ae (Filter.Eventually.of_forall h1),
        integral_add e2 e1, integral_sub hF e0,
        MeasureTheory.integral_const_mul, MeasureTheory.integral_const_mul]
    linarith [hexp ▸ hnn]
  have hann : 0 ≤ a := integral_nonneg fun x ↦ sq_nonneg _
  rcases eq_or_lt_of_le hann with h | h
  · have hb : b = 0 := by
      by_contra hb
      have h2 := key ((c + 1) / (2 * b))
      rw [← h] at h2
      have he : (2:ℝ) * ((c + 1) / (2 * b)) * b = c + 1 := by field_simp
      rw [he] at h2
      linarith
    rw [hb, ← h]
    simp
  · have hne : a ≠ 0 := ne_of_gt h
    have hk := key (b / a)
    have he : c - 2 * (b / a) * b + (b / a) ^ 2 * a = (a * c - b ^ 2) / a := by
      field_simp
      ring
    rw [he] at hk
    have h2 : 0 ≤ a * c - b ^ 2 := by
      have h3 := mul_nonneg hk h.le
      rwa [div_mul_cancel₀ _ hne] at h3
    nlinarith [h2]

/-- Hölder: `∫ S^2 |g|^2 ≤ ‖S‖_4^2 ‖g‖_4^2`. -/
lemma integral_sqFun_sq_mul_le {N : ℕ} {μ : Measure α} {f : Fin N → α → ℂ} {g : α → ℂ}
    (hf : ∀ n, MemLp (f n) 4 μ) (hg : MemLp g 4 μ) :
    (∫ x, sqFun f x ^ 2 * ‖g x‖ ^ 2 ∂μ) ≤ nrmS μ f ^ 2 * nrm4 μ g ^ 2 := by
  have hS := memLp_sqFun hf
  have hFm : MemLp (fun x ↦ sqFun f x ^ 2) 2 μ := by
    have h : MemLp (fun x ↦ sqFun f x * sqFun f x) 2 μ := hS.mul hS
    simpa [sq] using h
  have hGm : MemLp (fun x ↦ ‖g x‖ ^ 2) 2 μ := by
    have h : MemLp (fun x ↦ ‖g x‖ * ‖g x‖) 2 μ := (hg.norm).mul (hg.norm)
    simpa [sq] using h
  have hF : Integrable (fun x ↦ (sqFun f x ^ 2) ^ 2) μ := by
    have h := hFm.integrable_norm_pow (p := 2) (by norm_num)
    refine h.congr (Filter.Eventually.of_forall fun x ↦ ?_)
    simp only []
    rw [Real.norm_of_nonneg (by positivity)]
  have hG : Integrable (fun x ↦ (‖g x‖ ^ 2) ^ 2) μ := by
    have h := hGm.integrable_norm_pow (p := 2) (by norm_num)
    refine h.congr (Filter.Eventually.of_forall fun x ↦ ?_)
    simp only []
    rw [Real.norm_of_nonneg (by positivity)]
  have hFG : Integrable (fun x ↦ sqFun f x ^ 2 * ‖g x‖ ^ 2) μ := hFm.integrable_mul hGm
  have hCS := sq_integral_mul_le hF hG hFG
  have hFsq : (∫ x, (sqFun f x ^ 2) ^ 2 ∂μ) = pow4S μ f := by
    rw [pow4S]
    exact integral_congr_ae (Filter.Eventually.of_forall fun x ↦ by ring)
  have hGsq : (∫ x, (‖g x‖ ^ 2) ^ 2 ∂μ) = pow4 μ g := by
    rw [pow4]
    exact integral_congr_ae (Filter.Eventually.of_forall fun x ↦ by ring)
  rw [hFsq, hGsq, ← nrmS_pow_four, ← nrm4_pow_four] at hCS
  have hnn : 0 ≤ ∫ x, sqFun f x ^ 2 * ‖g x‖ ^ 2 ∂μ :=
    integral_nonneg fun x ↦ by positivity
  have hrhs : (0:ℝ) ≤ nrmS μ f ^ 2 * nrm4 μ g ^ 2 := by positivity
  have hsq : (∫ x, sqFun f x ^ 2 * ‖g x‖ ^ 2 ∂μ) ^ 2
      ≤ (nrmS μ f ^ 2 * nrm4 μ g ^ 2) ^ 2 := by
    calc (∫ x, sqFun f x ^ 2 * ‖g x‖ ^ 2 ∂μ) ^ 2
        ≤ nrmS μ f ^ 4 * nrm4 μ g ^ 4 := hCS
      _ = (nrmS μ f ^ 2 * nrm4 μ g ^ 2) ^ 2 := by ring
  have h := Real.sqrt_le_sqrt hsq
  rwa [Real.sqrt_sq hnn, Real.sqrt_sq hrhs] at h

/-! ### Interchanging the kernel and space integrals

The measure `μ` is arbitrary and need not be sigma-finite, so Fubini is unavailable. The
interchange is instead carried out by expanding `|P_N(θ)(x)|^2` as a finite double sum,
after which only linearity of the two integrals is used.
-/

/-- Real part commutes with the interval integral. -/
lemma intervalIntegral_re {G : ℝ → ℂ} (h : IntervalIntegrable G volume 0 1) :
    (∫ θ in (0:ℝ)..1, (G θ).re) = (∫ θ in (0:ℝ)..1, G θ).re := by
  rw [intervalIntegral.integral_of_le (by norm_num : (0:ℝ) ≤ 1),
    intervalIntegral.integral_of_le (by norm_num : (0:ℝ) ≤ 1)]
  exact _root_.integral_re h.1

