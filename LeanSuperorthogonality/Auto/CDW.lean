  have : (2 * ↑π * I * (k : ℝ)) = (k : ℂ) * (2 * ↑π * I) := by push_cast; ring
  rw [e, this, Complex.exp_int_mul, Complex.exp_two_pi_mul_I, one_zpow]

/-- The character of integer frequency `k`, `θ ↦ e(kθ)`. -/
