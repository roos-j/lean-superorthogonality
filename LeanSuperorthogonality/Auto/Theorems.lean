lemma conic_sector_subset_capSector {N : ℕ} (j : Fin N) :
    Superorthogonal.CDW.conic_sector j ⊆
      capSector (1 / (N : ℝ))
        (capInterval (1 / (N : ℝ)) (((j : ℝ) + 1 / 2) * (1 / (N : ℝ)))) := by
  rintro ξ ⟨r, t, u, hr, ht, hu, h0, h1, h2⟩
  refine ⟨r, t, u, hr.1, hr.2, ?_, ?_, ?_⟩
  · change t ∈ Set.Icc _ _
    have hleft : ((j : ℝ) + 1 / 2) * (1 / (N : ℝ)) - (1 / (N : ℝ)) / 2 =
        (j : ℝ) / N := by ring
    have hright : ((j : ℝ) + 1 / 2) * (1 / (N : ℝ)) + (1 / (N : ℝ)) / 2 =
        ((j : ℝ) + 1) / N := by ring
    rwa [hleft, hright]
  · convert hu using 1
    norm_num [zpow_neg, one_div, inv_pow]

  · ext i
    fin_cases i <;> simp [Phi, h0, h1, h2]

