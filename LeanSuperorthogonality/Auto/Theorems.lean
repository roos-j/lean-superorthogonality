theorem cone_sqfct_estimate {N : ℕ}
    {f : Fin N → 𝓢(EuclideanSpace ℝ (Fin 3), ℂ)}
    (hf : ∀ j, Function.support (fourier (f j)) ⊆ Superorthogonal.CDW.conic_sector j) :
    eLpNorm (∑ j, f j) 4 volume ≤
      ENNReal.ofReal (46 * (1 + Real.log N) ^ ((1 : ℝ) / 4)) *
        eLpNorm (Superorthogonal.sqfct (fun j x ↦ f j x)) 4 volume := by
  have hleft : eLpNorm (∑ j, f j) 4 volume =
      ENNReal.ofReal (nrm4 volume (fun x ↦ ∑ j, f j x)) := by
    have he : (∑ j, (f j : EuclideanSpace ℝ (Fin 3) → ℂ)) =
        ⇑(∑ j, f j : 𝓢(EuclideanSpace ℝ (Fin 3), ℂ)) := by
      ext x
      simp
    rw [he]
    rw [((∑ j, f j).memLp 4 volume).eLpNorm_eq_integral_rpow_norm
      (by norm_num) (by norm_num)]
    simp [nrm4, pow4, one_div, SchwartzMap.sum_apply]
  have hright : eLpNorm (Superorthogonal.sqfct (fun j x ↦ f j x)) 4 volume =
      ENNReal.ofReal (nrmS volume (fun j x ↦ f j x)) := by
    rw [sqfct_eq_sqFun,
      (memLp_sqFun (fun j ↦ (f j).memLp 4 volume)).eLpNorm_eq_integral_rpow_norm
        (by norm_num) (by norm_num)]
    simp [nrmS, pow4S, Real.norm_of_nonneg (sqFun_nonneg _ _), one_div]
  rw [hleft, hright, ← ENNReal.ofReal_mul (by positivity)]
  apply ENNReal.ofReal_le_ofReal
  by_cases hN : 2 ≤ N
  · have h := cdw_theorem_1_4 hN f (fun j ↦ (hf j).trans (conic_sector_subset_capSector j))
    refine h.trans ?_
    exact mul_le_mul_of_nonneg_right
      (mul_le_mul_of_nonneg_right cdwConst_le_46 (by positivity)) (nrmS_nonneg _ _)
  · interval_cases N
    · simpa [nrm4, pow4] using nrmS_nonneg volume (fun j x ↦ f j x)
    · have he : nrm4 volume (fun x ↦ ∑ j, f j x) = nrmS volume (fun j x ↦ f j x) := by
        simp [nrm4, pow4, nrmS, pow4S, sqFun]
      rw [he]
      norm_num
      nlinarith [nrmS_nonneg volume (fun j x ↦ f j x)]

