/-- The Fourier cutoff in Theorem 1.4 has `L¹` norm at most `7/2`. -/
lemma psiL1_le_seven_halves : psiL1 ≤ 7 / 2 := by
  let w : ℝ → ℝ := fun x ↦ 64 + (2 * Real.pi * x) ^ 2
  have hw (x : ℝ) : 0 < w x := by dsimp [w]; positivity
  have hw_inv (x : ℝ) : (w x)⁻¹ =
      (1 / 64 : ℝ) * (1 + ((Real.pi / 4) * x) ^ 2)⁻¹ := by
    dsimp [w]
    field_simp
    ring
  have hwi : Integrable (fun x ↦ (w x)⁻¹) := by
    simp_rw [hw_inv]
    exact (integrable_inv_one_add_sq.comp_mul_left' (by positivity : Real.pi / 4 ≠ 0)).const_mul _
  have hwi_val : (∫ x : ℝ, (w x)⁻¹) = 1 / 16 := by
    simp_rw [hw_inv]
    rw [integral_const_mul, Measure.integral_comp_mul_left (fun y : ℝ ↦ (1 + y ^ 2)⁻¹),
      integral_univ_inv_one_add_sq]
    simp only [smul_eq_mul, abs_of_pos (inv_pos.mpr (by positivity : 0 < Real.pi / 4))]
    field_simp
    ring
  have hn := ((psiPer 0).memLp 2).integrable_norm_pow (by norm_num : (2 : ℕ) ≠ 0)
  have hweighted : Integrable (fun x ↦ w x * ‖psiPer 0 x‖ ^ 2) := by
    convert (hn.const_mul 64).add cutoff_weight_integrable using 1 <;>
      first | rfl | (ext x; dsimp [w]; ring)
  have hF : (fun x ↦ (Real.sqrt (w x) * ‖psiPer 0 x‖) ^ 2) =
      (fun x ↦ w x * ‖psiPer 0 x‖ ^ 2) := by
    ext x
    rw [mul_pow, Real.sq_sqrt (hw x).le]
  have hG : (fun x ↦ (Real.sqrt (w x))⁻¹ ^ 2) = (fun x ↦ (w x)⁻¹) := by
    ext x
    rw [inv_pow, Real.sq_sqrt (hw x).le]
  have hFG : (fun x ↦ (Real.sqrt (w x) * ‖psiPer 0 x‖) * (Real.sqrt (w x))⁻¹) =
      (fun x ↦ ‖psiPer 0 x‖) := by
    ext x
    field_simp [(Real.sqrt_pos.mpr (hw x)).ne']
  have hcs := sq_integral_mul_le (hF ▸ hweighted) (hG ▸ hwi)
    (hFG ▸ (psiPer 0).integrable.norm)
  rw [hF, hG, hFG, hwi_val] at hcs
  have hval : (∫ x : ℝ, w x * ‖psiPer 0 x‖ ^ 2) ≤ 192 := by
    simp only [w, add_mul]
    rw [integral_add (hn.const_mul 64) cutoff_weight_integrable, integral_const_mul]
    rcases cutoff_fourier_energy with ⟨h1, h2⟩
    linarith
  have hnorm : psiL1 = ∫ x : ℝ, ‖psiPer 0 x‖ :=
    (integral_norm_eq_lintegral_enorm (psiPer 0).continuous.aestronglyMeasurable).symm
  rw [hnorm]
  nlinarith

/-- The absolute constant produced by the cone proof is at most `46`. -/
lemma cdwConst_le_46 : cdwConst ≤ 46 := by
  have hp := psiL1_le_seven_halves
  have hp0 := psiL1_nonneg
  have hs : Real.sqrt 14 ≤ 4 := by
    nlinarith [Real.sq_sqrt (by norm_num : (0 : ℝ) ≤ 14), Real.sqrt_nonneg 14]
  have hk : 0 ≤ 1 + 4 * psiL1 * Real.sqrt 14 := by positivity
  have hk' : 1 + 4 * psiL1 * Real.sqrt 14 ≤ 57 := by
    nlinarith [mul_le_mul_of_nonneg_left hs (by positivity : 0 ≤ 4 * psiL1)]
  have hbase : 1331 * (1 + 4 * psiL1 * Real.sqrt 14) ^ 2 ≤ (46 : ℝ) ^ 4 := by
    nlinarith [sq_nonneg (57 - (1 + 4 * psiL1 * Real.sqrt 14))]
  have hroot := Real.rpow_le_rpow (by positivity) hbase (by norm_num : (0 : ℝ) ≤ 1 / 4)
  have he : ((46 : ℝ) ^ 4) ^ ((1 : ℝ) / 4) = 46 := by
    rw [← Real.rpow_natCast, ← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 46)]
    norm_num
  rw [he] at hroot
  exact hroot

